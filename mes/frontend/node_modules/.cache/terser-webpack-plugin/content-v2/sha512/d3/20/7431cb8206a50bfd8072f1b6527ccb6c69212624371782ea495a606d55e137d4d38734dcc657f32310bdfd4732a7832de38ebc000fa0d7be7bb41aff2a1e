lyB,MAAM,cAAChF,0BAAA,CAACw2B,GAAG,GAAE,CAAC,CAAEW,QAAQ,CAACC,cAAc,CAAC,MAAM,CAAC,CAAC,C","file":"x","sourcesContent":["// extracted by mini-css-extract-plugin","// REST client for the MES backend (same origin in production, CRA proxy in development).\nconst BASE = process.env.REACT_APP_API || '';\n\nexport function getToken() {\n  try { return localStorage.getItem('mes_token') || ''; } catch (e) { return ''; }\n}\n\nexport function setToken(t) {\n  try { if (t) localStorage.setItem('mes_token', t); else localStorage.removeItem('mes_token'); } catch (e) { /* ignore */ }\n}\n\nexport async function api(path, options = {}) {\n  const headers = { 'Content-Type': 'application/json' };\n  const token = getToken();\n  if (token) headers.Authorization = 'Bearer ' + token;\n  const res = await fetch(BASE + '/api' + path, {\n    method: options.method || (options.body ? 'POST' : 'GET'),\n    headers,\n    body: options.body ? JSON.stringify(options.body) : undefined\n  });\n  let data = null;\n  try { data = await res.json(); } catch (e) { data = null; }\n  if (res.status === 401 && path.indexOf('/auth/login') < 0) {\n    setToken('');\n    window.dispatchEvent(new Event('mes-logout'));\n  }\n  if (!res.ok) {\n    const err = new Error((data && data.error) || 'Request failed (' + res.status + ')');\n    err.status = res.status;\n    err.warning = !!(data && data.warning);\n    throw err;\n  }\n  return data;\n}\n\nexport const post = (path, body) => api(path, { method: 'POST', body: body || {} });\nexport const put = (path, body) => api(path, { method: 'PUT', body: body || {} });\nexport const del = (path) => api(path, { method: 'DELETE' });\n","// Header (date/time centred on every page) and permission-filtered navigation.\r\nimport React, { useEffect, useState } from 'react';\r\nimport { NavLink, useLocation } from 'react-router-dom';\r\n\r\nexport const NAV = [\r\n  { key: 'home', label: 'Home', path: '/' },\r\n  { label: 'Production management', children: [\r\n    { key: 'layout', label: 'Variety layout plan', path: '/layout' },\r\n    { key: 'annual', label: 'Annual production plan', path: '/plans/annual' },\r\n    { key: 'monthly', label: 'Monthly production plan', path: '/plans/monthly' },\r\n    { key: 'fifteen', label: '15-day production plan', path: '/plans/fifteen' },\r\n    { key: 'five', label: '5-day production plan', path: '/plans/five' },\r\n    { key: 'weather', label: 'Weather', path: '/weather' },\r\n    { key: 'fulfilment', label: 'Fulfilment of plan', path: '/fulfilment' }\r\n  ] },\r\n  { label: 'Power management', children: [\r\n    { key: 'power_consumption', label: 'Power consumption', path: '/power/consumption' },\r\n    { key: 'power_system', label: 'Power system status', path: '/power/system' }\r\n  ] },\r\n  { label: 'Quality control', children: [\r\n    { key: 'growth', label: 'Growth forecast', path: '/quality/growth' },\r\n    { key: 'pest', label: 'Pest monitoring', path: '/quality/pests' }\r\n  ] },\r\n  { key: 'equipment', label: 'Equipment management', path: '/equipment' },\r\n  { key: 'machinery_map', label: 'Harvest & machinery map', path: '/machinery-map' },\r\n  { key: 'irrigation', label: 'Irrigation system', path: '/irrigation' },\r\n  { key: 'diary', label: 'Production daily information', path: '/diary' },\r\n  { key: 'decision', label: 'Decision support (ERP)', path: '/decision' },\r\n  { key: 'admin', label: 'Authorization management', path: '/admin' }\r\n];\r\n\r\nexport function allowed(user, key) {\r\n  return !!user && (user.role === 'admin' || (user.permissions || []).indexOf(key) >= 0);\r\n}\r\n\r\nfunction pad(n) { return (n < 10 ? '0' : '') + n; }\r\n\r\nexport function Header({ user, onLogout }) {\r\n  const [now, setNow] = useState(new Date());\r\n  useEffect(() => {\r\n    const t = setInterval(() => setNow(new Date()), 1000);\r\n    return () => clearInterval(t);\r\n  }, []);\r\n  const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];\r\n  return (\r\n    <header className=\"header\">\r\n      <div className=\"brand\">Seed Farm MES · Smart Integrated Manufacturing System</div>\r\n      <div className=\"clock\" aria-live=\"off\">\r\n        <div className=\"date\">{now.getFullYear()}-{pad(now.getMonth() + 1)}-{pad(now.getDate())} {days[now.getDay()]}</div>\r\n        <div className=\"time\">{pad(now.getHours())}:{pad(now.getMinutes())}:{pad(now.getSeconds())}</div>\r\n      </div>\r\n      <div className=\"user\">\r\n        <span>{user.full_name} · {user.department_name}</span>\r\n        <NavLink to=\"/edit-requests\">Ratification</NavLink>\r\n        <button onClick={onLogout}>Log out</button>\r\n      </div>\r\n    </header>\r\n  );\r\n}\r\n\r\nexport function Nav({ user }) {\r\n  const loc = useLocation();\r\n  const initial = {};\r\n  NAV.forEach((n, i) => { if (n.children) initial[i] = n.children.some((c) => loc.pathname === c.path) || i === 1; });\r\n  const [open, setOpen] = useState(initial);\r\n  return (\r\n    <nav className=\"nav\" aria-label=\"Main navigation\">\r\n      {NAV.map((n, i) => {\r\n        if (!n.children) {\r\n          return allowed(user, n.key) ? <NavLink key={n.key} to={n.path} exact={n.path === '/'}>{n.label}</NavLink> : null;\r\n        }\r\n        const kids = n.children.filter((c) => allowed(user, c.key));\r\n        if (!kids.length) return null;\r\n        return (\r\n          <div key={n.label}>\r\n            <button className=\"group\" onClick={() => setOpen({ ...open, [i]: !open[i] })} aria-expanded={!!open[i]}>\r\n              {n.label}<span>{open[i] ? '▾' : '▸'}</span>\r\n            </button>\r\n            {open[i] && <div className=\"children\">{kids.map((c) => <NavLink key={c.key} to={c.path}>{c.label}</NavLink>)}</div>}\r\n          </div>\r\n        );\r\n      })}\r\n    </nav>\r\n  );\r\n}\r\n","// Small shared UI building blocks: notifications, tabs, panels, tables, modal, select helpers.\nimport React, { useEffect, useState } from 'react';\n\n// ---------------------------------------------------------------- notifications\nconst listeners = new Set();\nexport function notify(text, kind = 'success') {\n  const n = { id: Date.now() + Math.random(), text, kind };\n  listeners.forEach((l) => l(n));\n}\nexport function notifyError(e) { notify(e.message || String(e), e.warning ? 'warning' : 'error'); }\n\nexport function Notifier() {\n  const [items, setItems] = useState([]);\n  useEffect(() => {\n    const l = (n) => {\n      setItems((s) => [...s, n]);\n      setTimeout(() => setItems((s) => s.filter((x) => x.id !== n.id)), n.kind === 'success' ? 4000 : 7000);\n    };\n    listeners.add(l);\n    return () => listeners.delete(l);\n  }, []);\n  return (\n    <div className=\"notifier\">\n      {items.map((n) => (\n        <div key={n.id} className={'toast toast-' + n.kind} onClick={() => setItems((s) => s.filter((x) => x.id !== n.id))}>\n          <strong>{n.kind === 'warning' ? 'Warning' : n.kind === 'error' ? 'Error' : 'Notice'}</strong>\n          <span>{n.text}</span>\n        </div>\n      ))}\n    </div>\n  );\n}\n\n// ---------------------------------------------------------------- layout primitives\nexport function Panel({ title, extra, children, className = '', style }) {\n  return (\n    <section className={'panel ' + className} style={style}>\n      {(title || extra) && (\n        <header className=\"panel-head\">\n          <h3>{title}</h3>\n          <div className=\"panel-extra\">{extra}</div>\n        </header>\n      )}\n      <div className=\"panel-body\">{children}</div>\n    </section>\n  );\n}\n\nexport function Tabs({ tabs, active, onChange, small }) {\n  return (\n    <div className={'tabs' + (small ? ' tabs-small' : '')} role=\"tablist\">\n      {tabs.map((t) => (\n        <button key={t.key} role=\"tab\" aria-selected={active === t.key}\n          className={'tab' + (active === t.key ? ' active' : '')} onClick={() => onChange(t.key)}>\n          {t.label}{t.badge ? <span className=\"badge\">{t.badge}</span> : null}\n        </button>\n      ))}\n    </div>\n  );\n}\n\nexport function PageTitle({ children, right }) {\n  return (\n    <div className=\"page-title\">\n      <h2>{children}</h2>\n      <div>{right}</div>\n    </div>\n  );\n}\n\nexport function Warning({ children }) {\n  return <div className=\"warning-box\" role=\"alert\">{children}</div>;\n}\n\nexport function Loading({ text = 'Loading...' }) {\n  return <div className=\"loading\">{text}</div>;\n}\n\nexport function DataTable({ columns, rows, empty = 'No data', rowKey, onRowClick, selectedKey, maxHeight }) {\n  return (\n    <div className=\"table-wrap\" style={maxHeight ? { maxHeight } : undefined}>\n      <table className=\"table\">\n        <thead>\n          <tr>{columns.map((c) => <th key={c.key} style={{ textAlign: c.align || 'left' }}>{c.label}</th>)}</tr>\n        </thead>\n        <tbody>\n          {rows.length === 0 && <tr><td colSpan={columns.length} className=\"empty\">{empty}</td></tr>}\n          {rows.map((r, i) => {\n            const k = rowKey ? rowKey(r) : i;\n            return (\n              <tr key={k} onClick={onRowClick ? () => onRowClick(r) : undefined}\n                className={(onRowClick ? 'clickable ' : '') + (selectedKey !== undefined && selectedKey === k ? 'selected' : '')}>\n                {columns.map((c) => (\n                  <td key={c.key} style={{ textAlign: c.align || 'left' }}>{c.render ? c.render(r) : fmt(r[c.key])}</td>\n                ))}\n              </tr>\n            );\n          })}\n        </tbody>\n      </table>\n    </div>\n  );\n}\n\nexport function fmt(v, digits = 2) {\n  if (v === null || v === undefined || v === '') return '-';\n  if (typeof v === 'number') return Number.isInteger(v) ? v.toLocaleString() : v.toLocaleString(undefined, { maximumFractionDigits: digits });\n  return String(v);\n}\n\nexport function Modal({ title, onClose, children, footer, wide }) {\n  useEffect(() => {\n    const k = (e) => { if (e.key === 'Escape') onClose(); };\n    window.addEventListener('keydown', k);\n    return () => window.removeEventListener('keydown', k);\n  }, [onClose]);\n  return (\n    <div className=\"modal-backdrop\" onClick={onClose}>\n      <div className={'modal' + (wide ? ' modal-wide' : '')} onClick={(e) => e.stopPropagation()} role=\"dialog\" aria-modal=\"true\">\n        <header className=\"modal-head\"><h3>{title}</h3><button className=\"btn-icon\" onClick={onClose} aria-label=\"Close\">×</button></header>\n        <div className=\"modal-body\">{children}</div>\n        {footer && <footer className=\"modal-foot\">{footer}</footer>}\n      </div>\n    </div>\n  );\n}\n\nexport function Select({ label, value, onChange, options, style }) {\n  return (\n    <label className=\"field-inline\" style={style}>\n      {label && <span>{label}</span>}\n      <select value={value === null || value === undefined ? '' : value} onChange={(e) => onChange(e.target.value)}>\n        {options.map((o) => <option key={o.value} value={o.value}>{o.label}</option>)}\n      </select>\n    </label>\n  );\n}\n\nexport function StatusPill({ status }) {\n  return <span className={'pill pill-' + status}>{status}</span>;\n}\n\n// Series palette (validated categorical order) shared by all charts.\nexport const SERIES = ['#2a78d6', '#e07b39', '#2f9e6f', '#c94f7c', '#7b61c9', '#c9a227', '#3fa7b5', '#8a6d4f',\n  '#d1495b', '#5c8a2e', '#4d6fa8', '#b8735a'];\nexport const color = (i) => SERIES[i % SERIES.length];\n","import React, { useEffect, useState } from 'react';\nimport { api, setToken } from '../api';\n\nexport default function Login({ onLogin }) {\n  const [mode, setMode] = useState('login');\n  const [form, setForm] = useState({ username: '', password: '', full_name: '', department_id: '' });\n  const [deps, setDeps] = useState([]);\n  const [error, setError] = useState('');\n  const [info, setInfo] = useState('');\n  const set = (k) => (e) => setForm({ ...form, [k]: e.target.value });\n\n  useEffect(() => { if (mode === 'register') api('/auth/departments').then(setDeps).catch(() => {}); }, [mode]);\n\n  async function submit(e) {\n    e.preventDefault();\n    setError('');\n    setInfo('');\n    try {\n      if (mode === 'login') {\n        const r = await api('/auth/login', { method: 'POST', body: { username: form.username, password: form.password } });\n        setToken(r.token);\n        onLogin(r.user);\n      } else {\n        const r = await api('/auth/register', { method: 'POST', body: form });\n        setInfo(r.message);\n        setMode('login');\n      }\n    } catch (err) { setError(err.message); }\n  }\n\n  return (\n    <div className=\"login\">\n      <form onSubmit={submit}>\n        <h1>Seed Farm MES</h1>\n        <div className=\"muted small\">Smart Integrated Manufacturing System · offline</div>\n        <label>Username<input type=\"text\" value={form.username} onChange={set('username')} autoFocus required /></label>\n        <label>Password<input type=\"password\" value={form.password} onChange={set('password')} required /></label>\n        {mode === 'register' && (\n          <>\n            <label>Full name<input type=\"text\" value={form.full_name} onChange={set('full_name')} required /></label>\n            <label>Department\n              <select value={form.department_id} onChange={set('department_id')} required>\n                <option value=\"\">Select…</option>\n                {deps.map((d) => <option key={d.id} value={d.id}>{'— '.repeat(d.level - 1)}{d.name}</option>)}\n              </select>\n            </label>\n          </>\n        )}\n        {error && <div className=\"error-text\">{error}</div>}\n        {info && <div className=\"info-box\">{info}</div>}\n        <button className=\"btn btn-primary\" type=\"submit\">{mode === 'login' ? 'Log in' : 'Request account'}</button>\n        <button className=\"btn\" type=\"button\" onClick={() => setMode(mode === 'login' ? 'register' : 'login')}>\n          {mode === 'login' ? 'Request a new account' : 'Back to login'}\n        </button>\n        <div className=\"small muted\">Demo accounts (password 1234): admin, director, rice_div, leader5</div>\n      </form>\n    </div>\n  );\n}\n","// SVG farm map: fields with soil numbers, roads/canals backdrop, overlays and a legend in the lower-left corner.\nimport React from 'react';\n\nexport const VIEW_W = 1100;\nexport const VIEW_H = 700;\n\nexport default function FarmMap({ fields, fillFor, labelFor, subFor, onFieldClick, selectedId, legend, children,\n  onFieldDragOver, onFieldDrop, renderFieldExtra, height }) {\n  return (\n    <svg className=\"farm-map\" viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} role=\"img\" aria-label=\"Farm map\" style={height ? { maxHeight: height } : undefined}>\n      {/* backdrop: river, road and service area */}\n      <rect x=\"0\" y=\"0\" width=\"14\" height={VIEW_H} fill=\"#9cc7e6\" />\n      <rect x=\"512\" y=\"40\" width=\"36\" height=\"560\" fill=\"#d8d2c4\" />\n      <rect x=\"1005\" y=\"20\" width=\"90\" height=\"660\" rx=\"8\" fill=\"#dfe5dc\" />\n      <text x=\"1050\" y=\"16\" textAnchor=\"middle\" className=\"sub\">Service area</text>\n      {fields.map((f) => {\n        const lines = labelFor ? [].concat(labelFor(f)) : [f.soil_no];\n        return (\n          <g key={f.id}\n            onClick={onFieldClick ? () => onFieldClick(f) : undefined}\n            onDragOver={onFieldDragOver ? (e) => { e.preventDefault(); onFieldDragOver(f, e); } : undefined}\n            onDrop={onFieldDrop ? (e) => { e.preventDefault(); onFieldDrop(f, e); } : undefined}>\n            <rect className={'field' + (selectedId === f.id ? ' selected' : '')} x={f.x} y={f.y} width={f.w} height={f.h} rx=\"4\"\n              fill={fillFor ? fillFor(f) : '#9ccc9c'}>\n              <title>{f.soil_no}</title>\n            </rect>\n            <text x={f.x + 6} y={f.y + 15} className=\"lbl\">{lines[0]}</text>\n            {lines.slice(1).map((l, i) => <text key={i} x={f.x + 6} y={f.y + 30 + i * 13} className=\"sub\">{l}</text>)}\n            {subFor && <text x={f.x + f.w - 6} y={f.y + f.h - 6} textAnchor=\"end\" className=\"sub\">{subFor(f)}</text>}\n            {renderFieldExtra && renderFieldExtra(f)}\n          </g>\n        );\n      })}\n      {children}\n      {legend && legend.length > 0 && <Legend items={legend} />}\n    </svg>\n  );\n}\n\n// Legend drawn at the bottom-left of the map.\nexport function Legend({ items }) {\n  const perRow = 4;\n  const rows = Math.ceil(items.length / perRow);\n  const h = rows * 20 + 12;\n  return (\n    <g transform={`translate(20, ${VIEW_H - h - 8})`}>\n      <rect width={perRow * 118 + 12} height={h} rx=\"6\" fill=\"#ffffff\" opacity=\"0.93\" stroke=\"#c9d3cb\" />\n      {items.map((it, i) => (\n        <g key={i} transform={`translate(${10 + (i % perRow) * 118}, ${10 + Math.floor(i / perRow) * 20})`}>\n          {it.shape === 'circle' ? <circle cx=\"7\" cy=\"7\" r=\"6\" fill={it.color} /> : <rect width=\"14\" height=\"14\" rx=\"3\" fill={it.color} />}\n          <text x=\"20\" y=\"11\" style={{ fontSize: 11 }} fill=\"#1d2a22\">{it.label}</text>\n        </g>\n      ))}\n    </g>\n  );\n}\n\nexport const STATUS_COLORS = { normal: '#5cb85c', abnormal: '#d64545', harvest: '#f2c230', disease: '#d64545', pest: '#f2c230' };\n","// MES home: pie charts of visitors/operators and equipment, real-time farm map with equipment and people per field.\r\nimport React, { useEffect, useState } from 'react';\r\nimport { Bar, BarChart, Cell, Legend, Pie, PieChart, ResponsiveContainer, Tooltip, XAxis, YAxis } from 'recharts';\r\nimport { api } from '../api';\r\nimport FarmMap from '../components/FarmMap';\r\nimport { Loading, Panel, notifyError, SERIES } from '../components/ui';\r\n\r\nconst EQ_COLORS = { operating: '#2f9e44', idle: '#e0a100', repair: '#d64545' };\r\n\r\nfunction Donut({ data, colors }) {\r\n  return (\r\n    <ResponsiveContainer width=\"100%\" height={200}>\r\n      <PieChart>\r\n        <Pie data={data} dataKey=\"value\" nameKey=\"name\" innerRadius={42} outerRadius={70} paddingAngle={2}\r\n          label={({ value }) => value} isAnimationActive={false}>\r\n          {data.map((d, i) => <Cell key={d.name} fill={colors ? colors[d.name] || SERIES[i % SERIES.length] : SERIES[i % SERIES.length]} />)}\r\n        </Pie>\r\n        <Tooltip />\r\n        <Legend verticalAlign=\"bottom\" height={30} />\r\n      </PieChart>\r\n    </ResponsiveContainer>\r\n  );\r\n}\r\n\r\nexport default function Home() {\r\n  const [d, setD] = useState(null);\r\n  useEffect(() => {\r\n    let alive = true;\r\n    const load = () => api('/farm/home').then((r) => alive && setD(r)).catch(notifyError);\r\n    load();\r\n    const t = setInterval(load, 5000); // near real-time monitoring\r\n    return () => { alive = false; clearInterval(t); };\r\n  }, []);\r\n  if (!d) return <Loading />;\r\n  const people = d.people.map((p) => ({ name: p.kind === 'visitor' ? 'Visitors' : 'Operators', value: p.n }));\r\n  const eqStatus = d.equipment_status.map((e) => ({ name: e.status, value: e.n }));\r\n  const eqType = d.equipment_types.map((e) => ({ name: e.type, value: e.n }));\r\n  const totalPeople = people.reduce((a, p) => a + p.value, 0);\r\n  return (\r\n    <div className=\"grid\">\r\n      <div className=\"grid g3\">\r\n        <Panel title={`People on the farm today (${totalPeople})`}><Donut data={people} colors={{ Operators: SERIES[0], Visitors: SERIES[1] }} /></Panel>\r\n        <Panel title={`Equipment by status (${d.equipment.length})`}><Donut data={eqStatus} colors={EQ_COLORS} /></Panel>\r\n        <Panel title=\"Equipment by type\">\r\n          <ResponsiveContainer width=\"100%\" height={190}>\r\n            <BarChart data={eqType} layout=\"vertical\" margin={{ left: 10, right: 20 }}>\r\n              <XAxis type=\"number\" allowDecimals={false} hide />\r\n              <YAxis type=\"category\" dataKey=\"name\" width={130} tick={{ fontSize: 11 }} interval={0} />\r\n              <Tooltip />\r\n              <Bar dataKey=\"value\" name=\"Units\" fill={SERIES[0]} label={{ position: 'right', fontSize: 11 }} isAnimationActive={false} />\r\n            </BarChart>\r\n          </ResponsiveContainer>\r\n        </Panel>\r\n      </div>\r\n      <Panel title=\"Farm monitoring (real time)\" extra={<span className=\"small muted\">Updated {new Date(d.time).toLocaleTimeString()}</span>}>\r\n        <FarmMap fields={d.fields}\r\n          fillFor={(f) => f.cultivar_color}\r\n          labelFor={(f) => [f.soil_no, f.cultivar_name.replace(/ \\(.*\\)/, ''), `👤 ${f.workers} working${f.visitors ? ` · ${f.visitors} visitor` : ''}`]}\r\n          legend={[{ color: '#2f9e44', label: 'Operating', shape: 'circle' }, { color: '#e0a100', label: 'Idle', shape: 'circle' },\r\n            { color: '#d64545', label: 'Under repair', shape: 'circle' }, { color: '#2e7d32', label: 'Rice field' }, { color: '#f9a825', label: 'Wheat field' }]}>\r\n          {d.equipment.map((e) => (\r\n            <g key={e.id} transform={`translate(${e.x}, ${e.y})`}>\r\n              <circle r=\"7\" fill={EQ_COLORS[e.status]} stroke=\"#fff\" strokeWidth=\"2\" className={e.status === 'operating' ? 'pulse' : ''}>\r\n                <title>{e.designation} ({e.equipment_no}) — {e.status}</title>\r\n              </circle>\r\n            </g>\r\n          ))}\r\n        </FarmMap>\r\n      </Panel>\r\n    </div>\r\n  );\r\n}\r\n","// Variety layout: farm map with soil numbers and cultivar names. Drag a cultivar name onto another field to swap\n// the two cultivars, or drag a cultivar from the legend list onto a field to assign it. Changes are saved to the DB.\nimport React, { useEffect, useState } from 'react';\nimport { api, post, put } from '../api';\nimport FarmMap from '../components/FarmMap';\nimport { Loading, PageTitle, Panel, notify, notifyError } from '../components/ui';\n\nexport default function VarietyLayout() {\n  const [fields, setFields] = useState(null);\n  const [cultivars, setCultivars] = useState([]);\n  const [drag, setDrag] = useState(null);\n  const [hover, setHover] = useState(null);\n\n  useEffect(() => {\n    api('/farm/fields').then(setFields).catch(notifyError);\n    api('/farm/cultivars').then(setCultivars).catch(notifyError);\n  }, []);\n  if (!fields) return <Loading />;\n\n  async function drop(target) {\n    setHover(null);\n    if (!drag) return;\n    try {\n      let r;\n      if (drag.type === 'field') {\n        if (drag.field.id === target.id) return;\n        r = await post('/farm/layout/swap', { from_field: drag.field.id, to_field: target.id });\n        notify(`Swapped cultivars of ${drag.field.soil_no} and ${target.soil_no}. Layout saved.`);\n      } else {\n        r = await put('/farm/fields/' + target.id + '/cultivar', { cultivar_id: drag.cultivar.id });\n        notify(`${target.soil_no} is now planted with ${drag.cultivar.name}. Layout saved.`);\n      }\n      setFields(r.fields);\n    } catch (e) { notifyError(e); } finally { setDrag(null); }\n  }\n\n  const areaBy = {};\n  fields.forEach((f) => { areaBy[f.cultivar_id] = (areaBy[f.cultivar_id] || 0) + f.area_ha; });\n\n  return (\n    <div>\n      <PageTitle>Variety layout plan</PageTitle>\n      <div className=\"grid g-side-r\">\n        <Panel title=\"Farm map — drag a cultivar name onto another field\">\n          <FarmMap fields={fields} selectedId={hover}\n            fillFor={(f) => f.cultivar_color}\n            labelFor={() => []}\n            onFieldDragOver={(f) => setHover(f.id)}\n            onFieldDrop={drop}\n            legend={cultivars.map((c) => ({ color: c.color, label: c.name.replace(/ \\(.*\\)/, '') }))}\n            renderFieldExtra={(f) => (\n              <>\n                <text x={f.x + 6} y={f.y + 16} className=\"lbl\">{f.soil_no}</text>\n                <foreignObject x={f.x + 4} y={f.y + 24} width={f.w - 8} height={f.h - 28}>\n                  <div draggable onDragStart={() => setDrag({ type: 'field', field: f })} onDragEnd={() => setHover(null)}\n                    title=\"Drag to another field to swap\"\n                    style={{ cursor: 'grab', fontSize: 11, background: 'rgba(255,255,255,.85)', borderRadius: 4, padding: '2px 4px', lineHeight: 1.2 }}>\n                    {f.cultivar_name}\n                  </div>\n                </foreignObject>\n              </>\n            )} />\n        </Panel>\n        <Panel title=\"Cultivars (drag onto a field)\">\n          {cultivars.map((c) => (\n            <div key={c.id} draggable onDragStart={() => setDrag({ type: 'cultivar', cultivar: c })}\n              style={{ display: 'flex', alignItems: 'center', gap: 8, padding: '8px 6px', borderBottom: '1px solid var(--line)', cursor: 'grab' }}>\n              <span style={{ width: 16, height: 16, borderRadius: 3, background: c.color, display: 'inline-block' }} />\n              <span style={{ flex: 1 }}>{c.name}<div className=\"small muted\">{c.crop} · {c.maturity_days} days · {c.potential_yield} t/ha</div></span>\n              <span className=\"small\">{(areaBy[c.id] || 0).toFixed(1)} ha</span>\n            </div>\n          ))}\n        </Panel>\n      </div>\n    </div>\n  );\n}\n","// Production plan in calendar form: a month calendar for short plans, a month-by-process calendar for the annual plan.\nimport React from 'react';\n\nconst MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];\nconst DOW = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];\n\nfunction parse(s) { const p = String(s).slice(0, 10).split('-'); return new Date(+p[0], +p[1] - 1, +p[2]); }\nfunction ymd(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }\n\nfunction uniqueProcesses(tasks) {\n  const map = new Map();\n  tasks.forEach((t) => {\n    const k = t.crop + '|' + t.process;\n    const cur = map.get(k);\n    if (!cur) map.set(k, { crop: t.crop, process: t.process, start: t.start_date, end: t.end_date, qty: t.planned_qty });\n    else {\n      if (t.start_date < cur.start) cur.start = t.start_date;\n      if (t.end_date > cur.end) cur.end = t.end_date;\n      cur.qty += t.planned_qty;\n    }\n  });\n  return Array.from(map.values()).sort((a, b) => (a.start < b.start ? -1 : a.start > b.start ? 1 : a.crop < b.crop ? -1 : 1));\n}\n\nfunction YearCalendar({ start, tasks }) {\n  const year = parse(start).getFullYear();\n  const now = new Date();\n  const rows = uniqueProcesses(tasks);\n  return (\n    <div className=\"table-wrap\" style={{ maxHeight: 380 }}>\n      <table className=\"gantt\">\n        <thead>\n          <tr><th style={{ textAlign: 'left' }}>Process</th>{MONTHS.map((m) => <th key={m}>{m}</th>)}<th>ha</th></tr>\n        </thead>\n        <tbody>\n          {rows.map((r) => (\n            <tr key={r.crop + r.process}>\n              <td className=\"p\">{r.crop === 'rice' ? '🌾 ' : '🌿 '}{r.process}</td>\n              {MONTHS.map((m, i) => {\n                const ms = ymd(new Date(year, i, 1));\n                const me = ymd(new Date(year, i + 1, 0));\n                const on = r.start <= me && r.end >= ms;\n                const isNow = now.getFullYear() === year && now.getMonth() === i;\n                return <td key={m} className={(on ? 'on-' + r.crop : '') + (isNow ? ' now' : '')} title={on ? `${r.process}: ${r.start} .. ${r.end}` : ''} />;\n              })}\n              <td>{Math.round(r.qty)}</td>\n            </tr>\n          ))}\n        </tbody>\n      </table>\n    </div>\n  );\n}\n\nfunction MonthGrid({ year, month, start, end, tasks }) {\n  const first = new Date(year, month, 1);\n  const last = new Date(year, month + 1, 0);\n  const offset = (first.getDay() + 6) % 7;\n  const cells = [];\n  for (let i = 0; i < offset; i++) cells.push(null);\n  for (let d = 1; d <= last.getDate(); d++) cells.push(new Date(year, month, d));\n  const today = ymd(new Date());\n  const procs = uniqueProcesses(tasks);\n  return (\n    <div className=\"cal-month\">\n      <h4>{MONTHS[month]} {year}</h4>\n      <div className=\"cal\">\n        {DOW.map((d) => <div key={d} className=\"dow\">{d}</div>)}\n        {cells.map((c, i) => {\n          if (!c) return <div key={'e' + i} />;\n          const s = ymd(c);\n          const inside = s >= start && s <= end;\n          const active = inside ? procs.filter((p) => p.start <= s && p.end >= s) : [];\n          return (\n            <div key={s} className={'day' + (inside ? '' : ' out') + (s === today ? ' today' : '')}>\n              <div className=\"n\">{c.getDate()}</div>\n              {active.slice(0, 3).map((p) => <span key={p.crop + p.process} className={'chip chip-' + p.crop} title={p.process}>{p.process}</span>)}\n              {active.length > 3 && <span className=\"muted\">+{active.length - 3} more</span>}\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n}\n\nexport default function PlanCalendar({ start, end, tasks }) {\n  const s = parse(start);\n  const e = parse(end);\n  const days = Math.round((e - s) / 86400000) + 1;\n  if (days > 62) return <YearCalendar start={start} tasks={tasks} />;\n  const months = [];\n  for (let d = new Date(s.getFullYear(), s.getMonth(), 1); d <= e; d = new Date(d.getFullYear(), d.getMonth() + 1, 1)) {\n    months.push([d.getFullYear(), d.getMonth()]);\n  }\n  return (\n    <div>\n      {months.map(([y, m]) => <MonthGrid key={y + '-' + m} year={y} month={m} start={start} end={end} tasks={tasks} />)}\n      <div className=\"legend-row\"><span style={{ '--c': '#2f9e6f' }}>Rice</span><span style={{ '--c': '#c9a227' }}>Wheat</span></div>\n    </div>\n  );\n}\n","// Tabbed view of plan variants: calendar, labour & equipment, materials, economic efficiency, and the\n// submission (annual -> ERP) or approval buttons.\nimport React, { useEffect, useMemo, useState } from 'react';\nimport { Bar, BarChart, CartesianGrid, ComposedChart, Legend, Line, ResponsiveContainer, Tooltip, XAxis, YAxis } from 'recharts';\nimport { post } from '../api';\nimport PlanCalendar from './PlanCalendar';\nimport { DataTable, Panel, StatusPill, Tabs, fmt, notify, notifyError, SERIES } from './ui';\n\nfunction laborEquipmentRows(plan) {\n  const map = new Map();\n  plan.resources.forEach((r) => {\n    if (r.resource_type === 'material') return;\n    const row = map.get(r.process) || { process: r.process, labor: 0, equipment: [] };\n    if (r.resource_type === 'labor') row.labor += r.quantity;\n    else row.equipment.push(r);\n    map.set(r.process, row);\n  });\n  return Array.from(map.values());\n}\n\nfunction materialRows(plan) {\n  const map = new Map();\n  plan.resources.filter((r) => r.resource_type === 'material').forEach((r) => {\n    const k = r.name + '|' + r.unit;\n    const row = map.get(k) || { name: r.name, unit: r.unit, quantity: 0, cost: 0, processes: [] };\n    row.quantity += r.quantity;\n    row.cost += r.cost;\n    if (row.processes.indexOf(r.process) < 0) row.processes.push(r.process);\n    map.set(k, row);\n  });\n  return Array.from(map.values());\n}\n\nfunction LaborEquipment({ plan }) {\n  const rows = laborEquipmentRows(plan);\n  const labor = rows.reduce((a, r) => a + r.labor, 0);\n  return (\n    <>\n      <DataTable rowKey={(r) => r.process} rows={rows} maxHeight={300} columns={[\n        { key: 'process', label: 'Process' },\n        { key: 'labor', label: 'Labour (man-day)', align: 'right', render: (r) => fmt(r.labor, 1) },\n        { key: 'eq', label: 'Equipment', render: (r) => r.equipment.map((e) => e.name).join(', ') || '-' },\n        { key: 'h', label: 'Machine hours', align: 'right', render: (r) => fmt(r.equipment.reduce((a, e) => a + e.quantity, 0), 1) }\n      ]} />\n      <div className=\"row small muted\" style={{ marginTop: 6 }}>\n        Total labour {fmt(labor, 1)} man-day · Mechanisation ratio {Math.round(plan.mech_ratio * 100)}%\n      </div>\n    </>\n  );\n}\n\nfunction Materials({ plan }) {\n  return (\n    <DataTable rowKey={(r) => r.name + r.unit} rows={materialRows(plan)} maxHeight={300} columns={[\n      { key: 'name', label: 'Material' },\n      { key: 'quantity', label: 'Quantity', align: 'right', render: (r) => fmt(r.quantity, 1) },\n      { key: 'unit', label: 'Unit' },\n      { key: 'cost', label: 'Cost', align: 'right', render: (r) => fmt(r.cost, 0) }\n    ]} />\n  );\n}\n\nfunction Economics({ plans, current }) {\n  const data = plans.map((p) => ({\n    name: 'V' + p.variant_no, Labour: Math.round(p.cost_breakdown.labor), Equipment: Math.round(p.cost_breakdown.equipment),\n    Materials: Math.round(p.cost_breakdown.material), Revenue: Math.round(p.expected_revenue), Efficiency: p.efficiency\n  }));\n  return (\n    <div>\n      <ResponsiveContainer width=\"100%\" height={240}>\n        <ComposedChart data={data} margin={{ top: 8, right: 8, left: 8, bottom: 0 }}>\n          <CartesianGrid stroke=\"#e3e8e4\" vertical={false} />\n          <XAxis dataKey=\"name\" />\n          <YAxis yAxisId=\"c\" tickFormatter={(v) => (v / 1000).toFixed(0) + 'k'} />\n          <YAxis yAxisId=\"e\" orientation=\"right\" domain={[0, 'auto']} />\n          <Tooltip formatter={(v, n) => (n === 'Efficiency' ? v : v.toLocaleString())} />\n          <Legend />\n          <Bar yAxisId=\"c\" dataKey=\"Labour\" stackId=\"c\" fill={SERIES[0]} />\n          <Bar yAxisId=\"c\" dataKey=\"Equipment\" stackId=\"c\" fill={SERIES[1]} />\n          <Bar yAxisId=\"c\" dataKey=\"Materials\" stackId=\"c\" fill={SERIES[2]} />\n          <Bar yAxisId=\"c\" dataKey=\"Revenue\" fill={SERIES[4]} />\n          <Line yAxisId=\"e\" dataKey=\"Efficiency\" stroke={SERIES[3]} strokeWidth={2} dot={{ r: 4 }} />\n        </ComposedChart>\n      </ResponsiveContainer>\n      <div className=\"small muted\">Selected: {current.variant_name} — revenue / cost = {current.efficiency}</div>\n    </div>\n  );\n}\n\nfunction Summary({ plan }) {\n  const data = [\n    { name: 'Labour', v: Math.round(plan.cost_breakdown.labor) },\n    { name: 'Equipment', v: Math.round(plan.cost_breakdown.equipment) },\n    { name: 'Materials', v: Math.round(plan.cost_breakdown.material) }\n  ];\n  return (\n    <div className=\"grid g2\">\n      <div className=\"grid\" style={{ gridTemplateColumns: '1fr 1fr' }}>\n        <div className=\"kpi\"><span className=\"v\">{fmt(plan.expected_yield_t, 0)} t</span><span className=\"l\">Expected seed yield</span></div>\n        <div className=\"kpi\"><span className=\"v\">{fmt(plan.expected_cost, 0)}</span><span className=\"l\">Expected cost</span></div>\n        <div className=\"kpi\"><span className=\"v\">{fmt(plan.expected_revenue, 0)}</span><span className=\"l\">Expected revenue</span></div>\n        <div className=\"kpi\"><span className=\"v\">{plan.efficiency}</span><span className=\"l\">Economic efficiency</span></div>\n      </div>\n      <ResponsiveContainer width=\"100%\" height={150}>\n        <BarChart data={data} layout=\"vertical\" margin={{ left: 20 }}>\n          <XAxis type=\"number\" hide />\n          <YAxis type=\"category\" dataKey=\"name\" width={80} />\n          <Tooltip formatter={(v) => v.toLocaleString()} />\n          <Bar dataKey=\"v\" name=\"Cost\" fill={SERIES[0]} />\n        </BarChart>\n      </ResponsiveContainer>\n    </div>\n  );\n}\n\nexport default function PlanView({ data, layout, onReload }) {\n  const plans = useMemo(() => data.plans || [], [data.plans]);\n  const preferred = useMemo(() => {\n    const a = plans.find((p) => p.status === 'approved' || p.status === 'submitted');\n    return a ? a.id : plans[0] && plans[0].id;\n  }, [plans]);\n  const [active, setActive] = useState(preferred);\n  const [busy, setBusy] = useState(false);\n  useEffect(() => { if (!plans.some((p) => p.id === active)) setActive(preferred); }, [plans, active, preferred]);\n  const plan = plans.find((p) => p.id === active);\n  if (!plan) return null;\n\n  const isAnnual = layout === 'annual';\n  const canAct = isAnnual ? data.can_submit : data.can_approve;\n  async function act(path) {\n    setBusy(true);\n    try {\n      const r = await post('/plans/' + plan.id + path);\n      notify(r.message, r.message && r.message.indexOf('Warning') >= 0 ? 'warning' : 'success');\n      onReload();\n    } catch (e) { notifyError(e); } finally { setBusy(false); }\n  }\n\n  let action = null;\n  if (isAnnual) {\n    action = plan.status === 'submitted'\n      ? <button className=\"btn btn-danger\" disabled={!canAct || busy} onClick={() => act('/cancel-submit')}>Cancel submission</button>\n      : <button className=\"btn btn-primary\" disabled={!canAct || busy} onClick={() => act('/submit')}>Submit to ERP</button>;\n  } else {\n    action = plan.status === 'approved'\n      ? <button className=\"btn btn-danger\" disabled={!canAct || busy} onClick={() => act('/cancel-approval')}>Cancel approval</button>\n      : <button className=\"btn btn-primary\" disabled={!canAct || busy} onClick={() => act('/approve')}>Approve</button>;\n  }\n\n  const tabs = plans.map((p) => ({ key: p.id, label: p.variant_name, badge: p.status !== 'draft' ? (p.status === 'submitted' ? 'submitted' : 'approved') : null }));\n  const calendar = (\n    <Panel title=\"Production plan (calendar)\" extra={<span className=\"small muted\">{plan.period_start} .. {plan.period_end}</span>}>\n      <PlanCalendar start={plan.period_start} end={plan.period_end} tasks={plan.tasks} />\n    </Panel>\n  );\n  const labor = <Panel title={layout === 'annual' || layout === 'monthly' ? 'Required labour and equipment' : 'Required manpower and equipment per process'}><LaborEquipment plan={plan} /></Panel>;\n  const materials = <Panel title=\"Required materials\"><Materials plan={plan} /></Panel>;\n\n  let body;\n  if (layout === 'fifteen') {\n    body = (\n      <div className=\"grid g2\">\n        {calendar}\n        {materials}\n        <div className=\"span2\">{labor}</div>\n      </div>\n    );\n  } else {\n    body = (\n      <div className=\"grid g2\">\n        {calendar}\n        {materials}\n        {labor}\n        {layout === 'monthly'\n          ? <Panel title=\"Economic efficiency of the variants\"><Economics plans={plans} current={plan} /></Panel>\n          : <Panel title=\"Plan summary\"><Summary plan={plan} /></Panel>}\n      </div>\n    );\n  }\n\n  return (\n    <div>\n      <Tabs tabs={tabs} active={active} onChange={setActive} />\n      <div className=\"row\" style={{ justifyContent: 'space-between', marginBottom: 10 }}>\n        <div className=\"row small\">\n          <StatusPill status={plan.status} />\n          {plan.status_at && <span className=\"muted\">{plan.status} by {plan.status_by_name || '-'} at {plan.status_at}</span>}\n          <span className=\"muted\">Department: {plan.department_name}</span>\n          <span className=\"muted\">Mechanisation {Math.round(plan.mech_ratio * 100)}% · cost {fmt(plan.expected_cost, 0)} · efficiency {plan.efficiency}</span>\n        </div>\n        <div className=\"row\">\n          {!canAct && <span className=\"small muted\">{isAnnual ? 'Submission' : 'Approval'} requires higher authority</span>}\n          {action}\n        </div>\n      </div>\n      {body}\n    </div>\n  );\n}\n","// Annual / monthly / 15-day / 5-day production plan pages (tab structure of plan variants).\nimport React, { useCallback, useEffect, useState } from 'react';\nimport { api } from '../api';\nimport PlanView from '../components/PlanView';\nimport { Loading, PageTitle, Select, Warning, notifyError } from '../components/ui';\n\nfunction today() { const d = new Date(); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }\n\nfunction usePlan(path) {\n  const [data, setData] = useState(null);\n  const [error, setError] = useState('');\n  const load = useCallback(() => {\n    setError('');\n    api(path).then(setData).catch((e) => { setError(e.message); notifyError(e); });\n  }, [path]);\n  useEffect(() => { setData(null); load(); }, [load]);\n  return [data, load, error];\n}\n\nfunction Body({ data, error, layout, reload, children }) {\n  if (error) return <Warning>{error}</Warning>;\n  if (!data) return <Loading text=\"Loading plans (variants are generated and optimised on first visit)...\" />;\n  return (\n    <>\n      {children}\n      {data.warning && <Warning>{data.warning}</Warning>}\n      {data.warning_split && <Warning>{data.warning_split}</Warning>}\n      {data.info && !data.warning && <div className=\"info-box\">{data.info}</div>}\n      {data.parent && (\n        <div className=\"small muted\" style={{ marginBottom: 8 }}>\n          Based on the approved {data.parent.plan_type} plan “{data.parent.variant_name}” ({data.parent.period_start} .. {data.parent.period_end})\n          and material consumption norms. Plan period {data.period.start} .. {data.period.end}{data.days ? ` (${data.days} days)` : ''}.\n        </div>\n      )}\n      {data.plans && data.plans.length > 0 && <PlanView data={data} layout={layout} onReload={reload} />}\n    </>\n  );\n}\n\nexport function AnnualPlan() {\n  const [year, setYear] = useState(new Date().getFullYear());\n  const [data, reload, error] = usePlan('/plans/annual?year=' + year);\n  const years = [year - 1, year, year + 1].map((y) => ({ value: y, label: String(y) }));\n  return (\n    <div>\n      <PageTitle right={<Select label=\"Year\" value={year} onChange={(v) => setYear(parseInt(v, 10))} options={years} />}>Annual production plan</PageTitle>\n      <Body data={data} error={error} layout=\"annual\" reload={reload}>\n        {data && data.submitted_id && <div className=\"info-box\">A plan of {year} has been submitted to ERP. Monthly production orders are issued from it.</div>}\n      </Body>\n    </div>\n  );\n}\n\nexport function MonthlyPlan() {\n  const [month, setMonth] = useState(today().slice(0, 7));\n  const [data, reload, error] = usePlan('/plans/monthly?date=' + month + '-01');\n  return (\n    <div>\n      <PageTitle right={<label className=\"field-inline\">Month <input type=\"month\" value={month} onChange={(e) => setMonth(e.target.value)} /></label>}>\n        Monthly production plan\n      </PageTitle>\n      <Body data={data} error={error} layout=\"monthly\" reload={reload} />\n    </div>\n  );\n}\n\nexport function FifteenPlan() {\n  const [date, setDate] = useState(today());\n  const [dept, setDept] = useState('');\n  const [split, setSplit] = useState('');\n  const q = '/plans/fifteen?date=' + date + (dept ? '&department_id=' + dept : '') + (split ? '&split=' + split : '');\n  const [data, reload, error] = usePlan(q);\n  const deps = (data && data.departments) || [];\n  return (\n    <div>\n      <PageTitle right={\n        <div className=\"row\">\n          {deps.length > 0 && <Select label=\"Department\" value={dept || (data && data.department_id)} onChange={setDept}\n            options={deps.map((d) => ({ value: d.id, label: d.name }))} />}\n          <label className=\"field-inline\">Date <input type=\"date\" value={date} onChange={(e) => setDate(e.target.value)} /></label>\n          <Select label=\"First period ends on day\" value={split} onChange={setSplit}\n            options={[{ value: '', label: 'default' }, { value: 14, label: '14' }, { value: 15, label: '15' }, { value: 16, label: '16' }]} />\n        </div>}>\n        15-day production plan\n      </PageTitle>\n      <Body data={data} error={error} layout=\"fifteen\" reload={reload} />\n    </div>\n  );\n}\n\nexport function FivePlan() {\n  const [date, setDate] = useState(today());\n  const [dept, setDept] = useState('');\n  const [data, reload, error] = usePlan('/plans/five?date=' + date + (dept ? '&department_id=' + dept : ''));\n  const deps = (data && data.departments) || [];\n  return (\n    <div>\n      <PageTitle right={\n        <div className=\"row\">\n          {deps.length > 0 && <Select label=\"Department\" value={dept || (data && data.department_id)} onChange={setDept}\n            options={deps.map((d) => ({ value: d.id, label: d.name }))} />}\n          <label className=\"field-inline\">Date <input type=\"date\" value={date} onChange={(e) => setDate(e.target.value)} /></label>\n        </div>}>\n        5-day production plan\n      </PageTitle>\n      <Body data={data} error={error} layout=\"five\" reload={reload} />\n    </div>\n  );\n}\n","// Weather: micro-meteorological sensors, ACS meteorological data, forecast and soil sensor data.\nimport React, { useEffect, useState } from 'react';\nimport { api } from '../api';\nimport { DataTable, Loading, PageTitle, Panel, notifyError } from '../components/ui';\n\nexport function WeatherIcon({ kind, size = 72 }) {\n  const s = size;\n  if (kind === 'sunny') {\n    return (\n      <svg width={s} height={s} viewBox=\"0 0 64 64\" aria-label=\"sunny\">\n        <circle cx=\"32\" cy=\"32\" r=\"12\" fill=\"#f5b400\" />\n        {[0, 45, 90, 135, 180, 225, 270, 315].map((a) => (\n          <line key={a} x1=\"32\" y1=\"8\" x2=\"32\" y2=\"15\" stroke=\"#f5b400\" strokeWidth=\"4\" strokeLinecap=\"round\" transform={`rotate(${a} 32 32)`} />\n        ))}\n      </svg>\n    );\n  }\n  const cloud = <path d=\"M18 44h28a10 10 0 0 0 0-20 14 14 0 0 0-27-2A11 11 0 0 0 18 44z\" fill=\"#9aa8b5\" />;\n  if (kind === 'cloudy') return <svg width={s} height={s} viewBox=\"0 0 64 64\" aria-label=\"cloudy\">{cloud}</svg>;\n  if (kind === 'rain') {\n    return (\n      <svg width={s} height={s} viewBox=\"0 0 64 64\" aria-label=\"rain\">\n        {cloud}\n        {[22, 32, 42].map((x) => <path key={x} d={`M${x} 49 q-3 6 0 8 q3 -2 0 -8z`} fill=\"#2a78d6\" />)}\n      </svg>\n    );\n  }\n  return (\n    <svg width={s} height={s} viewBox=\"0 0 64 64\" aria-label=\"snow\">\n      {cloud}\n      {[22, 32, 42].map((x) => (\n        <g key={x} stroke=\"#5aa0e6\" strokeWidth=\"2\" strokeLinecap=\"round\">\n          <line x1={x} y1=\"48\" x2={x} y2=\"58\" /><line x1={x - 4} y1=\"51\" x2={x + 4} y2=\"55\" /><line x1={x - 4} y1=\"55\" x2={x + 4} y2=\"51\" />\n        </g>\n      ))}\n    </svg>\n  );\n}\n\nexport default function Weather() {\n  const [d, setD] = useState(null);\n  useEffect(() => {\n    const load = () => api('/farm/weather').then(setD).catch(notifyError);\n    load();\n    const t = setInterval(load, 60000);\n    return () => clearInterval(t);\n  }, []);\n  if (!d) return <Loading />;\n  const t = d.today;\n  return (\n    <div>\n      <PageTitle right={<span className=\"small muted\">Rain last 30 d: {d.analysis.rain_30d} mm · GDD(10 °C) last 30 d: {d.analysis.gdd10_30d}</span>}>Weather</PageTitle>\n      {d.alerts.length > 0 && (\n        <div className=\"warning-box\">{d.alerts.slice(0, 6).map((a, i) => <div key={i}>• {a.text}</div>)}{d.alerts.length > 6 && <div>… {d.alerts.length - 6} more</div>}</div>\n      )}\n      <div className=\"grid g2\">\n        <Panel title=\"Micrometeorological Climate\">\n          <DataTable rowKey={(r) => r.sensor_no} rows={d.micro} columns={[\n            { key: 'sensor_no', label: 'Sensor no.' }, { key: 'location', label: 'Location' },\n            { key: 'measured_at', label: 'Measured at' },\n            { key: 'temperature', label: 'Temp °C', align: 'right' }, { key: 'humidity', label: 'Humidity %', align: 'right' },\n            { key: 'wind_speed', label: 'Wind m/s', align: 'right' }, { key: 'rainfall', label: 'Rain mm', align: 'right' },\n            { key: 'solar_radiation', label: 'Solar W/m²', align: 'right' }\n          ]} />\n        </Panel>\n        <Panel title=\"Meteorological Data\" extra={<span className=\"small muted\">ACS · {t && t.obs_date}</span>}>\n          {t ? (\n            <div className=\"weather-now\">\n              <WeatherIcon kind={t.conditions} size={110} />\n              <div>\n                <div className=\"big\">{t.t_avg} °C</div>\n                <div className=\"temps\">\n                  <span className=\"muted\">Maximum</span><span>{t.t_max} °C</span>\n                  <span className=\"muted\">Minimum</span><span>{t.t_min} °C</span>\n                  <span className=\"muted\">Average</span><span>{t.t_avg} °C</span>\n                  <span className=\"muted\">Humidity</span><span>{t.humidity} %</span>\n                  <span className=\"muted\">Rainfall</span><span>{t.rainfall} mm</span>\n                  <span className=\"muted\">Conditions</span><span style={{ textTransform: 'capitalize' }}>{t.conditions}</span>\n                </div>\n              </div>\n            </div>\n          ) : <span className=\"muted\">No ACS data</span>}\n        </Panel>\n        <Panel title=\"Weather Forecast Data\">\n          <DataTable rowKey={(r) => r.forecast_date} rows={d.forecast} columns={[\n            { key: 'forecast_date', label: 'Date' },\n            { key: 'conditions', label: '', render: (r) => <WeatherIcon kind={r.conditions} size={22} /> },\n            { key: 't_max', label: 'Max °C', align: 'right' }, { key: 't_min', label: 'Min °C', align: 'right' },\n            { key: 't_avg', label: 'Avg °C', align: 'right' }, { key: 'humidity', label: 'Humidity %', align: 'right' }\n          ]} />\n        </Panel>\n        <Panel title=\"Soil and water\">\n          <DataTable rowKey={(r) => r.soil_no} rows={d.soil} columns={[\n            { key: 'soil_no', label: 'Soil no.' }, { key: 'water_level_cm', label: 'Water level cm', align: 'right' },\n            { key: 'moisture_pct', label: 'Soil moisture %', align: 'right' }, { key: 'soil_temp', label: 'Soil temp °C', align: 'right' },\n            { key: 'water_temp', label: 'Water temp °C', align: 'right' }\n          ]} />\n        </Panel>\n      </div>\n    </div>\n  );\n}\n","// Fulfilment of plan: farm-scale performance gauge, % per department, plan vs result per department (5-day / 15-day / monthly).\r\nimport React, { useEffect, useState } from 'react';\r\nimport { Bar, BarChart, CartesianGrid, Cell, Legend, ResponsiveContainer, Tooltip, XAxis, YAxis } from 'recharts';\r\nimport { api } from '../api';\r\nimport { Loading, PageTitle, Panel, Select, Tabs, notifyError, SERIES } from '../components/ui';\r\n\r\nfunction Gauge({ pct, label }) {\r\n  const v = Math.max(0, Math.min(120, pct));\r\n  const angle = Math.PI * (v / 120);\r\n  const r = 90;\r\n  const x = 110 - r * Math.cos(angle);\r\n  const y = 110 - r * Math.sin(angle);\r\n  const color = pct >= 95 ? '#2f9e44' : pct >= 80 ? '#e0a100' : '#d64545';\r\n  return (\r\n    <svg viewBox=\"0 0 220 130\" width=\"100%\" style={{ maxWidth: 380 }} role=\"img\" aria-label={`${label} ${pct}%`}>\r\n      <path d=\"M20 110 A90 90 0 0 1 200 110\" fill=\"none\" stroke=\"#e3e8e4\" strokeWidth=\"18\" />\r\n      <path d={`M20 110 A90 90 0 0 1 ${x} ${y}`} fill=\"none\" stroke={color} strokeWidth=\"18\" />\r\n      <line x1=\"110\" y1=\"110\" x2={110 + 90 * Math.cos(Math.PI * (1 - 100 / 120))} y2={110 - 90 * Math.sin(Math.PI * (1 - 100 / 120))} stroke=\"#1d2a22\" strokeDasharray=\"3 3\" />\r\n      <text x=\"110\" y=\"95\" textAnchor=\"middle\" style={{ fontSize: 30, fontWeight: 600 }}>{pct}%</text>\r\n      <text x=\"110\" y=\"124\" textAnchor=\"middle\" style={{ fontSize: 11 }} fill=\"#4c5d52\">{label}</text>\r\n    </svg>\r\n  );\r\n}\r\n\r\nfunction PlanVsResult({ block }) {\r\n  if (!block) return <div className=\"muted\">No approved plan for this department in the selected period.</div>;\r\n  return (\r\n    <div>\r\n      <div className=\"small muted\">{block.period[0]} .. {block.period[1]}</div>\r\n      <ResponsiveContainer width=\"100%\" height={300}>\r\n        <BarChart data={block.rows} margin={{ top: 10, right: 10, left: 0, bottom: 60 }}>\r\n          <CartesianGrid stroke=\"#e3e8e4\" vertical={false} />\r\n          <XAxis dataKey=\"process\" interval={0} angle={-25} textAnchor=\"end\" height={70} tick={{ fontSize: 11 }} />\r\n          <YAxis unit=\" ha\" />\r\n          <Tooltip />\r\n          <Legend verticalAlign=\"top\" />\r\n          <Bar dataKey=\"planned\" name=\"Plan\" fill={SERIES[0]} />\r\n          <Bar dataKey=\"executed\" name=\"Result\" fill={SERIES[2]} />\r\n        </BarChart>\r\n      </ResponsiveContainer>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default function Fulfilment() {\r\n  const [sum, setSum] = useState(null);\r\n  const [deps, setDeps] = useState([]);\r\n  const [dep, setDep] = useState('5');\r\n  const [detail, setDetail] = useState(null);\r\n  const [tab, setTab] = useState('five');\r\n  useEffect(() => {\r\n    api('/fulfilment/summary').then(setSum).catch(notifyError);\r\n    api('/fulfilment/departments').then(setDeps).catch(notifyError);\r\n  }, []);\r\n  useEffect(() => { setDetail(null); api('/fulfilment/department/' + dep).then(setDetail).catch(notifyError); }, [dep]);\r\n  if (!sum) return <Loading />;\r\n  return (\r\n    <div>\r\n      <PageTitle>Fulfilment of plan</PageTitle>\r\n      <div className=\"grid\" style={{ gridTemplateColumns: 'minmax(0, 1fr) minmax(0, 1fr)' }}>\r\n        <div className=\"grid\">\r\n        <Panel title=\"Plan execution by department (%)\">\r\n          <ResponsiveContainer width=\"100%\" height={260}>\r\n            <BarChart data={sum.departments} layout=\"vertical\" margin={{ left: 40, right: 20 }}>\r\n              <CartesianGrid stroke=\"#e3e8e4\" horizontal={false} />\r\n              <XAxis type=\"number\" unit=\"%\" domain={[0, (max) => Math.max(110, Math.ceil(max / 10) * 10)]} />\r\n              <YAxis type=\"category\" dataKey=\"name\" width={150} tick={{ fontSize: 12 }} />\r\n              <Tooltip formatter={(v) => v + '%'} />\r\n              <Bar dataKey=\"pct\" name=\"Execution\">\r\n                {sum.departments.map((d) => <Cell key={d.id} fill={d.pct >= 95 ? '#2f9e44' : d.pct >= 80 ? '#e0a100' : '#d64545'} />)}\r\n              </Bar>\r\n            </BarChart>\r\n          </ResponsiveContainer>\r\n        </Panel>\r\n        <Panel title=\"Plan and result by department\"\r\n          extra={<Select label=\"Department\" value={dep} onChange={setDep} options={deps.map((d) => ({ value: d.id, label: d.name }))} />}>\r\n          <Tabs tabs={[{ key: 'five', label: '5-day plan' }, { key: 'fifteen', label: '15-day plan' }, { key: 'monthly', label: 'Monthly plan' }]}\r\n            active={tab} onChange={setTab} small />\r\n          {detail ? <PlanVsResult block={detail[tab]} /> : <Loading />}\r\n        </Panel>\r\n        </div>\r\n        <Panel title=\"Farm-scale production performance\" extra={<span className=\"small muted\">{sum.month[0]} .. {sum.date}</span>}>\r\n          <div className=\"grid\" style={{ justifyItems: 'center' }}>\r\n            <Gauge pct={sum.farm.pct} label=\"Executed vs planned to date\" />\r\n            <Gauge pct={sum.farm.month_pct} label=\"Progress of monthly plan\" />\r\n          </div>\r\n          <div className=\"small muted\">Executed {sum.farm.executed} ha of {sum.farm.planned_to_date} ha due to date;\r\n            monthly plan {sum.farm.month_planned} ha ({sum.farm.monthly_plan || 'no approved monthly plan'}).</div>\r\n        </Panel>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","// Vegetation (growth) forecast: survey results, season-specific forecasts, date forecast by reaching index,\n// nutritional status diagnosis and the farm growth-status map.\nimport React, { useEffect, useState } from 'react';\nimport { CartesianGrid, Legend, Line, LineChart, ReferenceLine, ResponsiveContainer, Tooltip, XAxis, YAxis } from 'recharts';\nimport { api, post } from '../api';\nimport FarmMap, { STATUS_COLORS } from '../components/FarmMap';\nimport { DataTable, Loading, PageTitle, Panel, Select, StatusPill, Tabs, color, notify, notifyError } from '../components/ui';\n\nconst CROPS = [{ key: 'rice', label: 'Rice' }, { key: 'wheat', label: 'Wheat' }];\n\nfunction useCultivars() {\n  const [c, setC] = useState([]);\n  useEffect(() => { api('/farm/cultivars').then(setC).catch(notifyError); }, []);\n  return c;\n}\n\nfunction CropCultivar({ crop, setCrop, cultivar, setCultivar, cultivars, allowAll }) {\n  const opts = cultivars.filter((c) => c.crop === crop).map((c) => ({ value: c.id, label: c.name }));\n  return (\n    <div className=\"row\">\n      <Select label=\"Crop\" value={crop} onChange={(v) => { setCrop(v); setCultivar(''); }} options={CROPS.map((c) => ({ value: c.key, label: c.label }))} />\n      <Select label=\"Cultivar\" value={cultivar} onChange={setCultivar} options={(allowAll ? [{ value: '', label: 'All' }] : []).concat(opts)} />\n    </div>\n  );\n}\n\n// ---------------------------------------------------------------- left: growth survey results\nfunction SurveyResults({ cultivars }) {\n  const [crop, setCrop] = useState('rice');\n  const [cultivar, setCultivar] = useState('');\n  const [index, setIndex] = useState('leaf_number');\n  const [d, setD] = useState(null);\n  useEffect(() => {\n    api(`/quality/surveys?crop=${crop}&index=${index}${cultivar ? '&cultivar_id=' + cultivar : ''}`).then(setD).catch(notifyError);\n  }, [crop, cultivar, index]);\n  const opts = cultivars.filter((c) => c.crop === crop).map((c) => ({ value: c.id, label: c.name }));\n  return (\n    <Panel title=\"Growth Survey Results\">\n      <Tabs tabs={CROPS} active={crop} onChange={(k) => { setCrop(k); setCultivar(''); }} small />\n      <div className=\"row\" style={{ marginBottom: 8 }}>\n        <Select label=\"Cultivar\" value={cultivar} onChange={setCultivar} options={[{ value: '', label: 'All' }].concat(opts)} />\n        <Select label=\"Index\" value={index} onChange={setIndex} options={[\n          { value: 'leaf_number', label: 'Leaf number' }, { value: 'tiller_number', label: 'Tiller number' },\n          { value: 'plant_height', label: 'Plant height' }, { value: 'spad', label: 'SPAD' }]} />\n      </div>\n      {d ? <DataTable maxHeight={560} rowKey={(r) => r.soil_no} rows={d.rows} columns={[\n        { key: 'soil_no', label: 'Soil no.' }, { key: 'cultivar_name', label: 'Cultivar' },\n        { key: 'value', label: 'Growth index', align: 'right' }, { key: 'survey_date', label: 'Surveyed' }]} /> : <Loading />}\n    </Panel>\n  );\n}\n\n// ---------------------------------------------------------------- top right: season-specific growth forecast\nfunction SeasonForecast({ cultivars }) {\n  const [period, setPeriod] = useState('30');\n  const [kind, setKind] = useState('leaf');\n  const [crop, setCrop] = useState('rice');\n  const [cultivar, setCultivar] = useState('');\n  const [d, setD] = useState(null);\n  useEffect(() => {\n    if (!cultivar && cultivars.length) { const c = cultivars.find((x) => x.crop === crop); if (c) setCultivar(String(c.id)); }\n  }, [cultivars, crop, cultivar]);\n  useEffect(() => {\n    if (!cultivar) return;\n    setD(null);\n    api(`/quality/forecast?crop=${crop}&cultivar_id=${cultivar}&horizon=${period}`).then(setD).catch(notifyError);\n  }, [crop, cultivar, period]);\n  return (\n    <Panel title=\"Season-specific Growth Forecast\">\n      <Tabs tabs={[{ key: '30', label: 'Monthly' }, { key: '10', label: '10-day' }, { key: '7', label: 'Weekly' }]} active={period} onChange={setPeriod} small />\n      <Tabs tabs={[{ key: 'leaf', label: 'Leaf number prediction' }, { key: 'tiller', label: 'Tiller number prediction' }]} active={kind} onChange={setKind} small />\n      <CropCultivar crop={crop} setCrop={setCrop} cultivar={cultivar} setCultivar={setCultivar} cultivars={cultivars} />\n      {d ? (\n        <ResponsiveContainer width=\"100%\" height={230}>\n          <LineChart data={d.rows} margin={{ top: 8, right: 8, left: -10, bottom: 0 }}>\n            <CartesianGrid stroke=\"#e3e8e4\" />\n            <XAxis dataKey=\"date\" tick={{ fontSize: 11 }} />\n            <YAxis domain={['auto', 'auto']} tick={{ fontSize: 11 }} />\n            <Tooltip />\n            <Legend wrapperStyle={{ fontSize: 11 }} />\n            {d.soil_nos.map((s, i) => <Line key={s} dataKey={`${kind}_${s}`} name={s} stroke={color(i)} dot={false} strokeWidth={2} />)}\n          </LineChart>\n        </ResponsiveContainer>\n      ) : <Loading text=\"Running growth model...\" />}\n    </Panel>\n  );\n}\n\n// ---------------------------------------------------------------- right middle: date forecast by reaching index\nfunction ReachForecast({ cultivars }) {\n  const [kind, setKind] = useState('leaf');\n  const [crop, setCrop] = useState('rice');\n  const [cultivar, setCultivar] = useState('');\n  const [target, setTarget] = useState(14);\n  const [d, setD] = useState(null);\n  const [busy, setBusy] = useState(false);\n  useEffect(() => {\n    if (!cultivar && cultivars.length) { const c = cultivars.find((x) => x.crop === crop); if (c) setCultivar(String(c.id)); }\n  }, [cultivars, crop, cultivar]);\n  async function run() {\n    setBusy(true);\n    try {\n      const r = await post('/quality/reach', { crop, cultivar_id: cultivar, kind, target: Number(target) });\n      setD(r);\n      notify(r.reached_date ? `Target reached on ${r.reached_date} (${r.reached_day} days).` : 'Target is not reached within 150 days.', r.reached_date ? 'success' : 'warning');\n    } catch (e) { notifyError(e); } finally { setBusy(false); }\n  }\n  return (\n    <Panel title=\"Date Forecast by Reaching Index\">\n      <Tabs tabs={[{ key: 'leaf', label: 'Leaf number' }, { key: 'tiller', label: 'Tiller number' }]} active={kind} onChange={(k) => { setKind(k); setD(null); }} small />\n      <div className=\"row\">\n        <CropCultivar crop={crop} setCrop={setCrop} cultivar={cultivar} setCultivar={setCultivar} cultivars={cultivars} />\n        <label className=\"field-inline\">Target <input type=\"number\" step=\"0.5\" className=\"cell\" value={target} onChange={(e) => setTarget(e.target.value)} /></label>\n        <button className=\"btn btn-primary\" disabled={busy || !cultivar} onClick={run}>Prediction</button>\n      </div>\n      {d && (\n        <ResponsiveContainer width=\"100%\" height={190}>\n          <LineChart data={d.series} margin={{ top: 8, right: 8, left: -10, bottom: 0 }}>\n            <CartesianGrid stroke=\"#e3e8e4\" />\n            <XAxis dataKey=\"date\" tick={{ fontSize: 11 }} />\n            <YAxis domain={['auto', 'auto']} tick={{ fontSize: 11 }} />\n            <Tooltip />\n            <ReferenceLine y={Number(target)} stroke=\"#d64545\" strokeDasharray=\"4 4\" label={{ value: 'target', fontSize: 11, fill: '#d64545' }} />\n            <Line dataKey=\"value\" name={kind === 'leaf' ? 'Leaf number' : 'Tiller number'} stroke={color(0)} dot={false} strokeWidth={2} />\n          </LineChart>\n        </ResponsiveContainer>\n      )}\n    </Panel>\n  );\n}\n\n// ---------------------------------------------------------------- lower right: nutritional status diagnosis\nfunction Nutrition() {\n  const [crop, setCrop] = useState('rice');\n  const [field, setField] = useState('');\n  const [d, setD] = useState(null);\n  useEffect(() => {\n    api(`/quality/nutrition?crop=${crop}${field ? '&field_id=' + field : ''}`).then(setD).catch(notifyError);\n  }, [crop, field]);\n  return (\n    <Panel title=\"Nutritional Status Diagnosis\">\n      <Tabs tabs={[{ key: 'rice', label: 'Rice (paddy)' }, { key: 'wheat', label: 'Wheat' }]} active={crop} onChange={(k) => { setCrop(k); setField(''); }} small />\n      {!d ? <Loading /> : (\n        <>\n          <div className=\"row\">\n            <Select label=\"Soil no.\" value={field || d.field_id} onChange={setField} options={d.fields.map((f) => ({ value: f.id, label: f.soil_no }))} />\n            {d.field && <span className=\"small\">{d.field.cultivar_name}</span>}\n          </div>\n          {d.latest && (\n            <DataTable rows={[d.latest]} columns={[\n              { key: 'diag_date', label: 'Last diagnosis' }, { key: 'n_pct', label: 'N %', align: 'right' },\n              { key: 'p_pct', label: 'P %', align: 'right' }, { key: 'k_pct', label: 'K %', align: 'right' },\n              { key: 'spad', label: 'SPAD', align: 'right' }, { key: 'status', label: 'Status', render: (r) => <StatusPill status={r.status} /> }]} />\n          )}\n          <ResponsiveContainer width=\"100%\" height={170}>\n            <LineChart data={d.history} margin={{ top: 8, right: 8, left: -10, bottom: 0 }}>\n              <CartesianGrid stroke=\"#e3e8e4\" />\n              <XAxis dataKey=\"diag_date\" tick={{ fontSize: 10 }} />\n              <YAxis yAxisId=\"a\" tick={{ fontSize: 11 }} />\n              <YAxis yAxisId=\"b\" orientation=\"right\" tick={{ fontSize: 11 }} />\n              <Tooltip />\n              <Legend wrapperStyle={{ fontSize: 11 }} />\n              <Line yAxisId=\"a\" dataKey=\"n_pct\" name=\"N %\" stroke={color(0)} dot={false} />\n              <Line yAxisId=\"a\" dataKey=\"k_pct\" name=\"K %\" stroke={color(1)} dot={false} />\n              <Line yAxisId=\"a\" dataKey=\"p_pct\" name=\"P %\" stroke={color(2)} dot={false} />\n              <Line yAxisId=\"b\" dataKey=\"spad\" name=\"SPAD\" stroke={color(3)} dot={false} />\n            </LineChart>\n          </ResponsiveContainer>\n        </>\n      )}\n    </Panel>\n  );\n}\n\n// ---------------------------------------------------------------- centre: growth map\nfunction GrowthMap() {\n  const [fields, setFields] = useState(null);\n  const [sel, setSel] = useState(null);\n  useEffect(() => { api('/quality/map').then(setFields).catch(notifyError); }, []);\n  if (!fields) return <Panel title=\"Farm growth status\"><Loading /></Panel>;\n  const f = fields.find((x) => x.id === sel);\n  return (\n    <Panel title=\"Farm growth status\" extra={<button className=\"btn\" onClick={async () => {\n      try { const r = await post('/quality/retrain'); notify('Growth model re-trained (self-learning) for ' + r.models.length + ' cultivars.'); } catch (e) { notifyError(e); }\n    }}>Re-train model</button>}>\n      <FarmMap fields={fields} selectedId={sel} onFieldClick={(x) => setSel(x.id)}\n        fillFor={(x) => STATUS_COLORS[x.status || 'normal']}\n        labelFor={(x) => [x.soil_no, x.growth_stage || '']}\n        legend={[{ color: STATUS_COLORS.normal, label: 'Growing normally' }, { color: STATUS_COLORS.abnormal, label: 'Abnormal' },\n          { color: STATUS_COLORS.harvest, label: 'Reaching harvest' }]} />\n      {f ? (\n        <DataTable rows={[f]} columns={[\n          { key: 'soil_no', label: 'Soil no.' }, { key: 'cultivar_name', label: 'Cultivar' }, { key: 'growth_stage', label: 'Stage' },\n          { key: 'status', label: 'Growth', render: (r) => <StatusPill status={r.status || 'normal'} /> },\n          { key: 'leaf_number', label: 'Leaves', align: 'right' }, { key: 'tiller_number', label: 'Tillers', align: 'right' },\n          { key: 'plant_height', label: 'Height cm', align: 'right' }, { key: 'survey_spad', label: 'SPAD', align: 'right' },\n          { key: 'n_pct', label: 'N %', align: 'right' }, { key: 'p_pct', label: 'P %', align: 'right' }, { key: 'k_pct', label: 'K %', align: 'right' },\n          { key: 'nutrient_status', label: 'Nutrition', render: (r) => <StatusPill status={r.nutrient_status || '-'} /> }]} />\n      ) : <div className=\"small muted\">Click a field to see its nutritional status and growth parameters.</div>}\n    </Panel>\n  );\n}\n\nexport default function GrowthForecast() {\n  const cultivars = useCultivars();\n  return (\n    <div>\n      <PageTitle>Vegetation forecast</PageTitle>\n      <div className=\"grid\" style={{ gridTemplateColumns: 'minmax(240px, 290px) minmax(0, 1.5fr) minmax(320px, 420px)' }}>\n        <SurveyResults cultivars={cultivars} />\n        <GrowthMap />\n        <div className=\"grid\" style={{ alignContent: 'start' }}>\n          <SeasonForecast cultivars={cultivars} />\n          <ReachForecast cultivars={cultivars} />\n          <Nutrition />\n        </div>\n      </div>\n    </div>\n  );\n}\n","// Insect (pest) monitoring: editable pest history, cultivation technical measures reported to ERP,\n// damage spread prediction and pest / disease map.\nimport React, { useEffect, useState } from 'react';\nimport { Area, CartesianGrid, Legend, Line, ResponsiveContainer, Tooltip, XAxis, YAxis, ComposedChart } from 'recharts';\nimport { api, del, post, put } from '../api';\nimport FarmMap, { STATUS_COLORS } from '../components/FarmMap';\nimport { DataTable, Loading, Modal, PageTitle, Panel, StatusPill, notify, notifyError, color } from '../components/ui';\n\nfunction today() { const d = new Date(); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }\n\nfunction ResourceTables({ s }) {\n  const cols = [{ key: 'name', label: 'Item' }, { key: 'quantity', label: 'Quantity', align: 'right' }, { key: 'unit', label: 'Unit' }];\n  return (\n    <div className=\"grid g3\">\n      <div><h4>Labour</h4><DataTable rows={s.labor} columns={cols} /></div>\n      <div><h4>Equipment</h4><DataTable rows={s.equipment} columns={cols} /></div>\n      <div><h4>Materials</h4><DataTable rows={s.materials} columns={cols} /></div>\n    </div>\n  );\n}\n\nfunction PestHistory({ rows, catalog, fields, onChanged }) {\n  const [edit, setEdit] = useState({});\n  const [adding, setAdding] = useState(null);\n  const setCell = (id, k, v) => setEdit({ ...edit, [id]: { ...(edit[id] || {}), [k]: v } });\n  const val = (r, k) => (edit[r.id] && edit[r.id][k] !== undefined ? edit[r.id][k] : r[k]);\n  async function save(r) {\n    try {\n      const res = await put('/quality/pests/' + r.id, edit[r.id] || {});\n      notify(res.message, res.applied ? 'success' : 'warning');\n      setEdit({ ...edit, [r.id]: undefined });\n      onChanged();\n    } catch (e) { notifyError(e); }\n  }\n  async function remove(r) {\n    try { await del('/quality/pests/' + r.id); notify('Record deleted'); onChanged(); } catch (e) { notifyError(e); }\n  }\n  async function add() {\n    try {\n      const c = catalog.find((x) => x.name === adding.pest_name);\n      await post('/quality/pests', { ...adding, image_url: adding.image_url || (c ? '/images/pests/' + c.name.toLowerCase().replace(/ /g, '_') + '.svg' : '') });\n      notify('Pest record added');\n      setAdding(null);\n      onChanged();\n    } catch (e) { notifyError(e); }\n  }\n  const pestOpts = (fieldId) => {\n    const f = fields.find((x) => String(x.id) === String(fieldId));\n    return catalog.filter((c) => !f || c.crop === f.crop);\n  };\n  return (\n    <>\n      <DataTable maxHeight={330} rowKey={(r) => r.id} rows={rows} columns={[\n        { key: 'soil_no', label: 'Field no.' },\n        { key: 'pest_name', label: 'Pest name', render: (r) => (\n          <select value={val(r, 'pest_name')} onChange={(e) => setCell(r.id, 'pest_name', e.target.value)}>\n            {pestOpts(r.field_id).map((c) => <option key={c.id} value={c.name}>{c.name}</option>)}\n          </select>) },\n        { key: 'occurred_on', label: 'Date', render: (r) => <input type=\"date\" value={String(val(r, 'occurred_on')).slice(0, 10)} onChange={(e) => setCell(r.id, 'occurred_on', e.target.value)} /> },\n        { key: 'location_desc', label: 'Location', render: (r) => <input type=\"text\" className=\"cell\" value={val(r, 'location_desc') || ''} onChange={(e) => setCell(r.id, 'location_desc', e.target.value)} /> },\n        { key: 'image_url', label: 'Image', render: (r) => (r.image_url ? <img src={r.image_url} alt={r.pest_name} width=\"28\" height=\"28\" /> : '-') },\n        { key: 'individuals', label: 'Individuals', render: (r) => <input type=\"number\" className=\"cell\" value={val(r, 'individuals')} onChange={(e) => setCell(r.id, 'individuals', e.target.value)} /> },\n        { key: 'damaged_area_m2', label: 'Damaged m²', render: (r) => <input type=\"number\" className=\"cell\" value={val(r, 'damaged_area_m2')} onChange={(e) => setCell(r.id, 'damaged_area_m2', e.target.value)} /> },\n        { key: 'a', label: '', render: (r) => (\n          <span className=\"row\" style={{ flexWrap: 'nowrap' }}>\n            <button className=\"btn\" disabled={!edit[r.id]} onClick={() => save(r)} title={Number(r.editable_today) ? 'Save' : 'Earlier date: requires joint ratification'}>\n              {Number(r.editable_today) ? 'Save' : 'Request edit'}</button>\n            {Number(r.editable_today) ? <button className=\"btn btn-danger\" onClick={() => remove(r)}>Delete</button> : null}\n          </span>) }\n      ]} />\n      {adding ? (\n        <div className=\"row\" style={{ marginTop: 8 }}>\n          <select value={adding.field_id} onChange={(e) => setAdding({ ...adding, field_id: e.target.value, pest_name: '' })}>\n            <option value=\"\">Field…</option>{fields.map((f) => <option key={f.id} value={f.id}>{f.soil_no} ({f.crop})</option>)}\n          </select>\n          <select value={adding.pest_name} onChange={(e) => setAdding({ ...adding, pest_name: e.target.value })}>\n            <option value=\"\">Pest…</option>{pestOpts(adding.field_id).map((c) => <option key={c.id} value={c.name}>{c.name}</option>)}\n          </select>\n          <input type=\"date\" value={adding.occurred_on} onChange={(e) => setAdding({ ...adding, occurred_on: e.target.value })} />\n          <input type=\"text\" placeholder=\"Location\" className=\"cell\" value={adding.location_desc} onChange={(e) => setAdding({ ...adding, location_desc: e.target.value })} />\n          <input type=\"number\" placeholder=\"Individuals\" className=\"cell\" value={adding.individuals} onChange={(e) => setAdding({ ...adding, individuals: e.target.value })} />\n          <input type=\"number\" placeholder=\"Damaged m²\" className=\"cell\" value={adding.damaged_area_m2} onChange={(e) => setAdding({ ...adding, damaged_area_m2: e.target.value })} />\n          <button className=\"btn btn-primary\" disabled={!adding.field_id || !adding.pest_name} onClick={add}>Add</button>\n          <button className=\"btn\" onClick={() => setAdding(null)}>Cancel</button>\n        </div>\n      ) : (\n        <button className=\"btn\" style={{ marginTop: 8 }} onClick={() => setAdding({ field_id: '', pest_name: '', occurred_on: today(), location_desc: '', individuals: '', damaged_area_m2: '' })}>\n          + Add record</button>\n      )}\n      <div className=\"small muted\" style={{ marginTop: 4 }}>Only records stored today are edited directly; older records need joint ratification by the person who entered them and a manager.</div>\n    </>\n  );\n}\n\nexport default function PestMonitoring() {\n  const [data, setData] = useState(null);\n  const [map, setMap] = useState(null);\n  const [fields, setFields] = useState([]);\n  const [pred, setPred] = useState(null);\n  const [measures, setMeasures] = useState(null);\n  const [sel, setSel] = useState(null);\n  const [busy, setBusy] = useState(false);\n  const load = () => {\n    api('/quality/pests').then(setData).catch(notifyError);\n    api('/quality/pest-map').then(setMap).catch(notifyError);\n  };\n  useEffect(() => { load(); api('/farm/fields').then(setFields).catch(notifyError); }, []);\n\n  async function prepare() {\n    setBusy(true);\n    try {\n      const existing = await api('/quality/measures');\n      setMeasures(existing.submitted ? existing : await post('/quality/measures/prepare'));\n    } catch (e) { notifyError(e); } finally { setBusy(false); }\n  }\n  async function submit(cancel) {\n    try {\n      const r = await post(cancel ? '/quality/measures/cancel' : '/quality/measures/submit');\n      notify(r.message);\n      setMeasures(await api('/quality/measures'));\n    } catch (e) { notifyError(e); }\n  }\n  async function predict() {\n    setBusy(true);\n    try { setPred(await post('/quality/pests/predict', { days: 21 })); } catch (e) { notifyError(e); } finally { setBusy(false); }\n  }\n\n  if (!data || !map) return <Loading />;\n  const f = map.find((x) => x.id === sel);\n  const chartData = pred ? pred.daily : Array.from({ length: 21 }, (_, i) => ({ day: i + 1 }));\n  return (\n    <div>\n      <PageTitle right={\n        <div className=\"row\">\n          <button className=\"btn btn-primary\" disabled={busy} onClick={prepare}>Establish cultivation technical measures</button>\n          <button className=\"btn\" disabled={busy} onClick={predict}>Damage prediction</button>\n        </div>}>Insect monitoring</PageTitle>\n      <div className=\"grid\" style={{ gridTemplateColumns: 'minmax(0, 1.45fr) minmax(0, 1fr)' }}>\n        <div className=\"grid\" style={{ alignContent: 'start' }}>\n          <Panel title=\"Pest History\">\n            <PestHistory rows={data.rows} catalog={data.catalog} fields={fields} onChanged={load} />\n          </Panel>\n          <Panel title=\"Predicted spread of damage (21 days)\">\n            <ResponsiveContainer width=\"100%\" height={240}>\n              <ComposedChart data={chartData} margin={{ top: 8, right: 8, left: -10, bottom: 0 }}>\n                <CartesianGrid stroke=\"#e3e8e4\" />\n                <XAxis dataKey=\"day\" label={{ value: 'day', position: 'insideBottomRight', offset: -2, fontSize: 11 }} />\n                <YAxis yAxisId=\"a\" />\n                <YAxis yAxisId=\"b\" orientation=\"right\" unit=\" ha\" />\n                <Tooltip />\n                <Legend />\n                <Area yAxisId=\"a\" dataKey=\"disease_fields\" name=\"Fields with disease\" stackId=\"1\" fill=\"#d64545\" stroke=\"#d64545\" fillOpacity={0.35} />\n                <Area yAxisId=\"a\" dataKey=\"pest_fields\" name=\"Fields with pests\" stackId=\"1\" fill=\"#f2c230\" stroke=\"#c9a227\" fillOpacity={0.45} />\n                <Line yAxisId=\"b\" dataKey=\"damaged_area_ha\" name=\"Damaged area\" stroke={color(4)} dot={false} strokeWidth={2} />\n              </ComposedChart>\n            </ResponsiveContainer>\n            {!pred && <div className=\"small muted\">Press “Damage prediction” to simulate the spread.</div>}\n          </Panel>\n        </div>\n        <Panel title=\"Pest and disease map\">\n          <FarmMap fields={map} selectedId={sel} onFieldClick={(x) => setSel(x.id)}\n            fillFor={(x) => STATUS_COLORS[x.state]}\n            labelFor={(x) => [x.soil_no].concat(x.pests.slice(0, 2).map((p) => p.pest_name))}\n            legend={[{ color: STATUS_COLORS.normal, label: 'Normal' }, { color: STATUS_COLORS.disease, label: 'Disease' }, { color: STATUS_COLORS.pest, label: 'Pests' }]} />\n          {f ? (f.pests.length ? (\n            <DataTable rows={f.pests} rowKey={(p) => p.id} columns={[\n              { key: 'pest_name', label: `${f.soil_no} · pest name` },\n              { key: 'category', label: 'Type', render: (p) => <StatusPill status={p.category === 'disease' ? 'fault' : 'idle'} /> },\n              { key: 'image_url', label: 'Damage image', render: (p) => (p.image_url ? <img src={p.image_url} alt={p.pest_name} width=\"56\" height=\"56\" /> : '-') },\n              { key: 'individuals', label: 'Individuals', align: 'right' },\n              { key: 'damaged_area_m2', label: 'Damaged area m²', align: 'right' },\n              { key: 'occurred_on', label: 'Date' }]} />\n          ) : <div className=\"small muted\">{f.soil_no}: no pests or diseases in the last 30 days.</div>)\n            : <div className=\"small muted\">Click a field to see pest name, damage image, individuals and damaged area.</div>}\n        </Panel>\n      </div>\n      {measures && (\n        <Modal wide title=\"Cultivation technical measures\" onClose={() => setMeasures(null)} footer={\n          <>\n            {measures.submitted\n              ? <button className=\"btn btn-danger\" onClick={() => submit(true)}>Cancel submission</button>\n              : <button className=\"btn btn-primary\" onClick={() => submit(false)}>Submit to ERP</button>}\n            <button className=\"btn\" onClick={() => setMeasures(null)}>Close</button>\n          </>}>\n          {measures.submitted && <div className=\"info-box\">Submitted to ERP.</div>}\n          <DataTable maxHeight={260} rowKey={(m) => m.id} rows={measures.measures} columns={[\n            { key: 'measure', label: 'Measure' }, { key: 'labor_md', label: 'Labour md', align: 'right' },\n            { key: 'equipment', label: 'Equipment' }, { key: 'equipment_h', label: 'h', align: 'right' },\n            { key: 'material', label: 'Material' }, { key: 'material_qty', label: 'Qty', align: 'right' }, { key: 'material_unit', label: 'Unit' }]} />\n          <div style={{ height: 12 }} />\n          <ResourceTables s={measures} />\n        </Modal>\n      )}\n    </div>\n  );\n}\n","// Power management: consumption status (monthly / 10-day / weekly tabs) and power system status diagram.\nimport React, { useEffect, useState } from 'react';\nimport { Bar, BarChart, CartesianGrid, Legend, ResponsiveContainer, Tooltip, XAxis, YAxis } from 'recharts';\nimport { api } from '../api';\nimport { DataTable, Loading, PageTitle, Panel, Select, StatusPill, Tabs, color, notifyError } from '../components/ui';\n\nfunction ConsumptionChart({ data }) {\n  if (!data) return <Loading />;\n  return (\n    <ResponsiveContainer width=\"100%\" height={420}>\n      <BarChart data={data.rows} margin={{ top: 10, right: 10, left: 10, bottom: 0 }}>\n        <CartesianGrid stroke=\"#e3e8e4\" vertical={false} />\n        <XAxis dataKey=\"label\" />\n        <YAxis tickFormatter={(v) => (v >= 1000 ? (v / 1000).toFixed(0) + 'k' : v)} unit=\" kWh\" width={80} />\n        <Tooltip formatter={(v) => v.toLocaleString() + ' kWh'} />\n        <Legend />\n        {data.series.map((s, i) => <Bar key={s.key} dataKey={s.key} name={s.name} fill={color(i)} />)}\n      </BarChart>\n    </ResponsiveContainer>\n  );\n}\n\nexport function PowerConsumption() {\n  const [tab, setTab] = useState('monthly');\n  const [opts, setOpts] = useState(null);\n  const [dept, setDept] = useState('all');\n  const [stations, setStations] = useState([]);\n  const [data, setData] = useState(null);\n  useEffect(() => { api('/power/options').then(setOpts).catch(notifyError); }, []);\n  useEffect(() => {\n    setData(null);\n    const q = tab === 'tenday' ? 'stations=' + (stations.length ? stations.join(',') : 'all') : 'department_id=' + dept;\n    api(`/power/consumption?mode=${tab}&${q}`).then(setData).catch(notifyError);\n  }, [tab, dept, stations]);\n  if (!opts) return <Loading />;\n  const deptSel = <Select label=\"Department\" value={dept} onChange={setDept}\n    options={[{ value: 'all', label: 'All' }].concat(opts.departments.map((d) => ({ value: d.id, label: d.name })))} />;\n  return (\n    <div>\n      <PageTitle>Power consumption status</PageTitle>\n      <Panel>\n        <Tabs tabs={[{ key: 'monthly', label: 'Monthly' }, { key: 'tenday', label: '10-day' }, { key: 'weekly', label: 'Weekly' }]} active={tab} onChange={setTab} />\n        <div className=\"row\" style={{ marginBottom: 8 }}>\n          {tab === 'tenday' ? (\n            <div className=\"row\">\n              <span className=\"small muted\">Stations:</span>\n              <label className=\"field-inline\"><input type=\"checkbox\" checked={!stations.length} onChange={() => setStations([])} /> All</label>\n              {opts.stations.map((s) => (\n                <label key={s.id} className=\"field-inline\">\n                  <input type=\"checkbox\" checked={stations.indexOf(s.id) >= 0}\n                    onChange={(e) => setStations(e.target.checked ? stations.concat(s.id) : stations.filter((x) => x !== s.id))} />\n                  {s.name}\n                </label>\n              ))}\n            </div>\n          ) : deptSel}\n        </div>\n        <ConsumptionChart data={data} />\n      </Panel>\n    </div>\n  );\n}\n\nconst TYPE_ICON = { substation: '⚡', transformer: '🔌', pump: '💧', building: '🏢', dryer: '🏭' };\n\nexport function PowerSystem() {\n  const [d, setD] = useState(null);\n  const [sel, setSel] = useState(null);\n  useEffect(() => {\n    const load = () => api('/power/system').then(setD).catch(notifyError);\n    load();\n    const t = setInterval(load, 15000);\n    return () => clearInterval(t);\n  }, []);\n  if (!d) return <Loading />;\n  const byId = {};\n  d.stations.forEach((s) => { byId[s.id] = s; });\n  const s = sel && byId[sel];\n  return (\n    <div>\n      <PageTitle right={<span className=\"small muted\">Load {Math.round(d.totals.load_kw)} / {Math.round(d.totals.capacity_kw)} kW · faults {d.totals.faults}</span>}>\n        Power system status\n      </PageTitle>\n      <div className=\"grid g-side-r\">\n        <Panel title=\"Power system diagram\">\n          <svg viewBox=\"0 0 1100 700\" className=\"farm-map\" role=\"img\" aria-label=\"Power system diagram\">\n            <rect x=\"40\" y=\"40\" width=\"460\" height=\"560\" rx=\"10\" fill=\"#dfeedd\" />\n            <rect x=\"560\" y=\"40\" width=\"440\" height=\"560\" rx=\"10\" fill=\"#f4ecd4\" />\n            <text x=\"60\" y=\"64\" className=\"sub\">Rice block</text>\n            <text x=\"580\" y=\"64\" className=\"sub\">Wheat block</text>\n            {d.lines.map((l) => {\n              const a = byId[l.from_station];\n              const b = byId[l.to_station];\n              const ok = l.status === 'normal';\n              return (\n                <g key={l.id}>\n                  <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} stroke={ok ? '#2f9e44' : '#d64545'} strokeWidth={l.voltage_kv > 1 ? 5 : 3}\n                    className={ok ? 'flow' : 'pulse'} />\n                  <text x={(a.x + b.x) / 2 + 6} y={(a.y + b.y) / 2 - 6} className=\"sub\">{l.voltage_kv} kV</text>\n                </g>\n              );\n            })}\n            {d.stations.map((st) => {\n              const ok = st.status === 'normal';\n              return (\n                <g key={st.id} transform={`translate(${st.x}, ${st.y})`} onClick={() => setSel(st.id)} style={{ cursor: 'pointer' }}>\n                  <rect x=\"-26\" y=\"-20\" width=\"52\" height=\"40\" rx=\"8\" fill={ok ? '#2f9e44' : '#d64545'} stroke={sel === st.id ? '#13311e' : '#fff'} strokeWidth=\"3\"\n                    className={ok ? '' : 'pulse'} />\n                  <text y=\"7\" textAnchor=\"middle\" style={{ fontSize: 18 }}>{TYPE_ICON[st.type] || '•'}</text>\n                  <text y=\"36\" textAnchor=\"middle\" className=\"sub\">{st.name.length > 24 ? st.name.slice(0, 24) + '…' : st.name}</text>\n                </g>\n              );\n            })}\n            <g transform=\"translate(20, 640)\">\n              <rect width=\"280\" height=\"40\" rx=\"6\" fill=\"#fff\" stroke=\"#c9d3cb\" />\n              <rect x=\"12\" y=\"13\" width=\"14\" height=\"14\" rx=\"3\" fill=\"#2f9e44\" /><text x=\"32\" y=\"25\" style={{ fontSize: 12 }}>Normal</text>\n              <rect x=\"110\" y=\"13\" width=\"14\" height=\"14\" rx=\"3\" fill=\"#d64545\" /><text x=\"130\" y=\"25\" style={{ fontSize: 12 }}>Abnormal / fault</text>\n            </g>\n          </svg>\n        </Panel>\n        <div className=\"grid\" style={{ alignContent: 'start' }}>\n          <Panel title=\"Station details\">\n            {s ? (\n              <div className=\"grid\" style={{ gridTemplateColumns: 'auto 1fr', gap: '4px 12px' }}>\n                <span className=\"muted\">Name</span><span>{s.name}</span>\n                <span className=\"muted\">Type</span><span>{s.type}</span>\n                <span className=\"muted\">Department</span><span>{s.department_name}</span>\n                <span className=\"muted\">Status</span><span><StatusPill status={s.status} /></span>\n                <span className=\"muted\">Load / capacity</span><span>{s.load_kw} / {s.capacity_kw} kW ({s.utilisation}%)</span>\n                <span className=\"muted\">Energy today</span><span>{s.kwh_today} kWh</span>\n              </div>\n            ) : <span className=\"small muted\">Click a node in the diagram.</span>}\n          </Panel>\n          <Panel title=\"Distribution analysis (load transfer proposals)\">\n            <DataTable rows={d.proposals} empty=\"No transfers needed\" columns={[\n              { key: 'from', label: 'From' }, { key: 'to', label: 'To' }, { key: 'kw', label: 'kW', align: 'right' }, { key: 'reason', label: 'Reason' }]} />\n          </Panel>\n          <Panel title=\"Utilisation\">\n            <DataTable rows={d.stations} rowKey={(r) => r.id} onRowClick={(r) => setSel(r.id)} selectedKey={sel} columns={[\n              { key: 'name', label: 'Station' }, { key: 'utilisation', label: 'Load %', align: 'right' },\n              { key: 'status', label: 'Status', render: (r) => <StatusPill status={r.status} /> }]} />\n          </Panel>\n        </div>\n      </div>\n    </div>\n  );\n}\n","// Equipment management: non-editable equipment table and equipment positions on the farm map.\nimport React, { useEffect, useState } from 'react';\nimport { api } from '../api';\nimport FarmMap from '../components/FarmMap';\nimport { DataTable, Loading, PageTitle, Panel, StatusPill, notifyError } from '../components/ui';\n\nconst EQ_COLORS = { operating: '#2f9e44', idle: '#e0a100', repair: '#d64545' };\n\nexport default function Equipment() {\n  const [d, setD] = useState(null);\n  const [sel, setSel] = useState(null);\n  useEffect(() => { api('/farm/equipment').then(setD).catch(notifyError); }, []);\n  if (!d) return <Loading />;\n  return (\n    <div>\n      <PageTitle>Equipment management</PageTitle>\n      <div className=\"grid\" style={{ gridTemplateColumns: 'minmax(0, 1fr) minmax(0, 1.25fr)' }}>\n        <Panel title={`Equipment (${d.equipment.length})`}>\n          <DataTable maxHeight={640} rowKey={(r) => r.id} rows={d.equipment} onRowClick={(r) => setSel(r.id)} selectedKey={sel} columns={[\n            { key: 'designation', label: 'Designation' }, { key: 'equipment_no', label: 'No.' },\n            { key: 'status', label: 'Operating status', render: (r) => <StatusPill status={r.status} /> },\n            { key: 'range_desc', label: 'Range' }, { key: 'reason', label: 'Reason for not operating' }]} />\n        </Panel>\n        <Panel title=\"Equipment location\">\n          <FarmMap fields={d.fields} fillFor={() => '#cfe3c6'} labelFor={(f) => [f.soil_no]}\n            legend={[{ color: EQ_COLORS.operating, label: 'Operating', shape: 'circle' }, { color: EQ_COLORS.idle, label: 'Idle', shape: 'circle' },\n              { color: EQ_COLORS.repair, label: 'Under repair', shape: 'circle' }]}>\n            {d.equipment.map((e) => (\n              <g key={e.id} transform={`translate(${e.x}, ${e.y})`} onClick={() => setSel(e.id)} style={{ cursor: 'pointer' }}>\n                <circle r={sel === e.id ? 11 : 7} fill={EQ_COLORS[e.status]} stroke={sel === e.id ? '#13311e' : '#fff'} strokeWidth=\"2\">\n                  <title>{e.designation} ({e.equipment_no}) — {e.status}</title>\n                </circle>\n                {sel === e.id && <text x=\"14\" y=\"4\" className=\"lbl\">{e.designation}</text>}\n              </g>\n            ))}\n          </FarmMap>\n        </Panel>\n      </div>\n    </div>\n  );\n}\n","// Harvest & machinery map (react-leaflet, offline): crop harvest conditions per field, real-time machinery\r\n// operation status, and shortest / fastest machinery routes between two points over the farm road network.\r\nimport React, { useCallback, useEffect, useMemo, useState } from 'react';\r\nimport L from 'leaflet';\r\nimport { LayerGroup, LayersControl, MapContainer, Marker, Pane, Polyline, Rectangle, ScaleControl, Tooltip, useMapEvents } from 'react-leaflet';\r\nimport 'leaflet/dist/leaflet.css';\r\nimport { api, post } from '../api';\r\nimport { DataTable, Loading, PageTitle, Panel, Select, StatusPill, Tabs, fmt, notifyError } from '../components/ui';\r\n\r\nconst MAP_W = 1100;\r\nconst MAP_H = 700;\r\nconst LIVE_MS = 3000;\r\n\r\nconst READINESS = [\r\n  { key: 'growing', label: 'Growing', color: '#9ccc9c' },\r\n  { key: 'approaching', label: 'Approaching maturity', color: '#d4dc6a' },\r\n  { key: 'ready', label: 'Ready to harvest', color: '#f2c230' },\r\n  { key: 'harvesting', label: 'Harvesting', color: '#e07b39' },\r\n  { key: 'harvested', label: 'Harvested', color: '#b9ada0' }\r\n];\r\nconst READY_COLOR = READINESS.reduce((a, r) => ({ ...a, [r.key]: r.color }), {});\r\nconst STATUS_COLOR = { operating: '#2f9e44', idle: '#e0a100', repair: '#d64545' };\r\nconst ROAD_STYLE = {\r\n  main: { weight: 7, color: '#bfb6a3' }, headland: { weight: 5, color: '#cfc6b2' }, service: { weight: 6, color: '#bfb6a3' },\r\n  farm: { weight: 4, color: '#d6cdb9' }, lane: { weight: 2.5, color: '#ddd5c3' }\r\n};\r\nconst STATE_STYLE = { muddy: { color: '#8a6d4f', dashArray: '6 6' }, rutted: { color: '#c9a227' }, closed: { color: '#d64545', dashArray: '4 8' } };\r\n\r\nfunction fmtDist(m) { return m >= 1000 ? (m / 1000).toFixed(2) + ' km' : Math.round(m) + ' m'; }\r\nfunction fmtTime(s) {\r\n  if (s < 60) return Math.round(s) + ' s';\r\n  const min = Math.floor(s / 60);\r\n  return min >= 60 ? Math.floor(min / 60) + ' h ' + (min % 60) + ' min' : min + ' min ' + Math.round(s % 60) + ' s';\r\n}\r\n\r\n// Leaflet CRS.Simple with metres as map units: farm map (x right, y down, 1 unit = mpu metres) -> [lat, lng].\r\nfunction useProjection(mpu) {\r\n  return useMemo(() => {\r\n    const ll = (x, y) => [(MAP_H - y) * mpu, x * mpu];\r\n    return {\r\n      ll,\r\n      pts: (points) => points.map((p) => ll(p[0], p[1])),\r\n      rect: (x, y, w, h) => [ll(x, y + h), ll(x + w, y)],\r\n      toXY: (latlng) => ({ x: Math.round(latlng.lng / mpu * 10) / 10, y: Math.round((MAP_H - latlng.lat / mpu) * 10) / 10 }),\r\n      bounds: [[0, 0], [MAP_H * mpu, MAP_W * mpu]]\r\n    };\r\n  }, [mpu]);\r\n}\r\n\r\nconst iconCache = {};\r\nfunction machineIcon(m, selected) {\r\n  const moving = m.speed_kmh > 0.5;\r\n  const small = m.status !== 'operating';\r\n  const heading = Math.round((m.heading || 0) / 15) * 15;\r\n  const key = [m.status, m.code, selected, moving, heading].join('|');\r\n  if (!iconCache[key]) {\r\n    const size = small && !selected ? 20 : 28;\r\n    iconCache[key] = L.divIcon({\r\n      className: '',\r\n      iconSize: [size, size],\r\n      iconAnchor: [size / 2, size / 2],\r\n      html: '<div class=\"mm-icon mm-' + m.status + (selected ? ' sel' : small ? ' small' : '') + '\">' +\r\n        (moving ? '<i class=\"mm-arrow\" style=\"transform: rotate(' + heading + 'deg)\"></i>' : '') +\r\n        '<b>' + (m.code || '?') + '</b></div>'\r\n    });\r\n  }\r\n  return iconCache[key];\r\n}\r\n\r\nconst FACILITY_ICON = L.divIcon({ className: '', iconSize: [14, 14], iconAnchor: [7, 7], html: '<div class=\"mm-facility\"></div>' });\r\n\r\nconst endIcons = {};\r\nfunction endIcon(letter) {\r\n  if (!endIcons[letter]) endIcons[letter] = L.divIcon({ className: '', iconSize: [24, 24], iconAnchor: [12, 12], html: '<div class=\"mm-pin\">' + letter + '</div>' });\r\n  return endIcons[letter];\r\n}\r\n\r\nfunction MapClicks({ onClick }) {\r\n  useMapEvents({ click: onClick });\r\n  return null;\r\n}\r\n\r\n// ---------------------------------------------------------------- side panel: harvest\r\nfunction HarvestPanel({ map, field, setFieldId, live }) {\r\n  const s = map.summary;\r\n  const count = (k) => (s.by_readiness.find((b) => b.readiness === k) || { fields: 0, area_ha: 0 });\r\n  const crop = field ? map.crop_types.find((c) => c.code === field.crop) : null;\r\n  const hv = field && field.harvest;\r\n  const inField = field ? live.filter((m) => m.field_id === field.id && m.status === 'operating') : [];\r\n  return (\r\n    <div className=\"mm-side\">\r\n      <div className=\"mm-kpis\">\r\n        <div className=\"kpi\"><span className=\"v\">{count('ready').fields}</span><span className=\"l\">fields ready</span></div>\r\n        <div className=\"kpi\"><span className=\"v\">{count('harvesting').fields}</span><span className=\"l\">being harvested</span></div>\r\n        <div className=\"kpi\"><span className=\"v\">{fmt(s.harvested_ha)}</span><span className=\"l\">ha harvested</span></div>\r\n        <div className=\"kpi\"><span className=\"v\">{fmt(s.ready_t, 0)}</span><span className=\"l\">t still to harvest</span></div>\r\n      </div>\r\n      {map.rain_forecast.length > 0 && (\r\n        <div className=\"warning-box\">Rain forecast on {map.rain_forecast.map((r) => r.forecast_date).join(', ')}: harvest ready fields first.</div>\r\n      )}\r\n      <h4 className=\"mm-h\">Harvest priority</h4>\r\n      <DataTable maxHeight={190} rows={map.priority} rowKey={(r) => r.field_id} onRowClick={(r) => setFieldId(r.field_id)}\r\n        selectedKey={field ? field.id : undefined} empty=\"No field is ready yet\" columns={[\r\n          { key: 'soil_no', label: 'Field' },\r\n          { key: 'readiness', label: 'State', render: (r) => <span className=\"mm-dot\" style={{ '--c': READY_COLOR[r.readiness] }}>{r.readiness}</span> },\r\n          { key: 'remaining_t', label: 'Left (t)', align: 'right' },\r\n          { key: 'reasons', label: 'Why', render: (r) => <span className=\"small\">{r.reasons.join('; ')}</span> }]} />\r\n      {field ? (\r\n        <>\r\n          <h4 className=\"mm-h\">Field {field.soil_no} · {field.cultivar_name}</h4>\r\n          {hv ? (\r\n            <dl className=\"mm-dl\">\r\n              <dt>Condition</dt><dd><span className=\"mm-dot\" style={{ '--c': READY_COLOR[hv.readiness] }}>{hv.readiness}</span></dd>\r\n              <dt>Area · grade</dt><dd>{field.area_ha} ha · {field.grade}</dd>\r\n              <dt>Maturity</dt><dd>{hv.maturity_pct}%</dd>\r\n              <dt>Grain moisture</dt><dd>{hv.grain_moisture_pct === null ? 'not measurable yet' : hv.grain_moisture_pct + '%'}\r\n                {crop && <span className=\"muted\"> (harvest at {crop.harvest_moisture_min}–{crop.harvest_moisture_max}%, store at {crop.storage_moisture}%)</span>}</dd>\r\n              <dt>Lodging</dt><dd className={hv.lodging_pct >= 10 ? 'bad' : ''}>{hv.lodging_pct}%</dd>\r\n              <dt>Expected yield</dt><dd>{hv.expected_yield_t_ha} t/ha · {fmt(hv.expected_yield_t_ha * field.area_ha, 1)} t</dd>\r\n              <dt>Harvested</dt><dd>{hv.harvested_pct}%</dd>\r\n              <dt>Harvest date</dt><dd>{hv.est_harvest_date || '-'}</dd>\r\n              {hv.notes && <><dt>Note</dt><dd>{hv.notes}</dd></>}\r\n              <dt>Machines here</dt><dd>{inField.length ? inField.map((m) => m.designation).join(', ') : 'none'}</dd>\r\n            </dl>\r\n          ) : <p className=\"muted\">No harvest assessment for this field.</p>}\r\n          {hv && (\r\n            <DataTable maxHeight={180} rows={field.history.slice().reverse()} rowKey={(r) => r.assessed_on} columns={[\r\n              { key: 'assessed_on', label: 'Date' }, { key: 'maturity_pct', label: 'Maturity %', align: 'right' },\r\n              { key: 'grain_moisture_pct', label: 'Moisture %', align: 'right' }, { key: 'harvested_pct', label: 'Harvested %', align: 'right' },\r\n              { key: 'readiness', label: 'State' }]} />\r\n          )}\r\n        </>\r\n      ) : <p className=\"muted small\">Click a field on the map for its harvest condition.</p>}\r\n      <h4 className=\"mm-h\">Crop types</h4>\r\n      <DataTable maxHeight={180} rows={map.crop_types} rowKey={(r) => r.code} columns={[\r\n        { key: 'name', label: 'Crop', render: (r) => <span className=\"mm-dot\" style={{ '--c': r.color }}>{r.name}</span> },\r\n        { key: 'harvest_moisture_max', label: 'Harvest ≤ %', align: 'right' }, { key: 'storage_moisture', label: 'Store %', align: 'right' },\r\n        { key: 'typical_yield_t_ha', label: 't/ha', align: 'right' }, { key: 'planted', label: 'On farm', render: (r) => (r.planted ? 'yes' : '-') }]} />\r\n    </div>\r\n  );\r\n}\r\n\r\n// ---------------------------------------------------------------- side panel: machinery\r\nfunction MachineryPanel({ live, types, machine, setMachineId, filter, setFilter, onRouteFrom }) {\r\n  const rows = live.machines.filter((m) => (!filter.status || m.status === filter.status) && (!filter.type || m.type === filter.type));\r\n  const type = machine ? types.find((t) => t.type === machine.type) : null;\r\n  const gps = live.machines.filter((m) => m.live === 'gps').length;\r\n  return (\r\n    <div className=\"mm-side\">\r\n      <div className=\"mm-kpis\">\r\n        {['operating', 'idle', 'repair'].map((s) => (\r\n          <button key={s} className={'kpi kpi-btn' + (filter.status === s ? ' on' : '')} onClick={() => setFilter({ ...filter, status: filter.status === s ? '' : s })}>\r\n            <span className=\"v\" style={{ color: STATUS_COLOR[s] }}>{live.status_counts[s] || 0}</span><span className=\"l\">{s}</span>\r\n          </button>\r\n        ))}\r\n        <div className=\"kpi\"><span className=\"v\">{gps}</span><span className=\"l\">on live GPS</span></div>\r\n      </div>\r\n      <div className=\"row\">\r\n        <Select label=\"Type\" value={filter.type} onChange={(v) => setFilter({ ...filter, type: v })}\r\n          options={[{ value: '', label: 'All types' }].concat(types.map((t) => ({ value: t.type, label: t.type })))} />\r\n        <span className=\"muted small\">Updated {new Date(live.time).toLocaleTimeString()}</span>\r\n      </div>\r\n      {live.alerts.filter((a) => a.level === 'warning').map((a) => (\r\n        <div key={a.text} className=\"warning-box mm-alert\" onClick={() => setMachineId(a.equipment_id)}>{a.text}</div>\r\n      ))}\r\n      <DataTable maxHeight={260} rows={rows} rowKey={(r) => r.id} onRowClick={(r) => setMachineId(r.id)} selectedKey={machine ? machine.id : undefined}\r\n        columns={[\r\n          { key: 'designation', label: 'Machine' }, { key: 'status', label: 'Status', render: (r) => <StatusPill status={r.status} /> },\r\n          { key: 'task', label: 'Task', render: (r) => (r.status === 'operating' ? r.task || '-' : r.reason || '-') },\r\n          { key: 'soil_no', label: 'Field' }, { key: 'speed_kmh', label: 'km/h', align: 'right' },\r\n          { key: 'fuel_pct', label: 'Fuel %', align: 'right' }]} />\r\n      {machine ? (\r\n        <>\r\n          <h4 className=\"mm-h\">{machine.designation} · {machine.equipment_no}</h4>\r\n          <dl className=\"mm-dl\">\r\n            <dt>Type</dt><dd>{machine.type} ({machine.category})</dd>\r\n            <dt>Status</dt><dd><StatusPill status={machine.status} /> {machine.status !== 'operating' && machine.reason}</dd>\r\n            <dt>Task</dt><dd>{machine.task || '-'}{machine.soil_no ? ' · ' + machine.soil_no : ''}</dd>\r\n            <dt>Position</dt><dd>{fmt(machine.x, 0)}, {fmt(machine.y, 0)} · heading {machine.heading}°</dd>\r\n            <dt>Speed</dt><dd>{machine.speed_kmh} km/h</dd>\r\n            <dt>Fuel</dt><dd className={machine.fuel_pct !== null && machine.fuel_pct < 20 ? 'bad' : ''}>{fmt(machine.fuel_pct)}%</dd>\r\n            <dt>Engine hours</dt><dd>{fmt(machine.engine_hours, 1)}</dd>\r\n            <dt>Signal</dt><dd>{{ gps: 'live GPS', sim: 'simulated from last report', parked: 'parked', stationary: 'stationary plant',\r\n              'gps-stale': 'GPS lost ' + Math.round((machine.last_seen_s || 0) / 60) + ' min ago' }[machine.live]}</dd>\r\n            {type && <><dt>Size</dt><dd>{type.width_m} m wide · {type.weight_t} t · {type.tracked ? 'tracked' : 'wheeled'}</dd>\r\n              <dt>Speeds</dt><dd>road {type.road_speed_kmh} km/h · field {type.field_speed_kmh} km/h</dd></>}\r\n          </dl>\r\n          {machine.mobile ? <button className=\"btn btn-primary\" onClick={() => onRouteFrom(machine)}>Route from this machine</button> : null}\r\n        </>\r\n      ) : <p className=\"muted small\">Click a machine on the map or in the table for its live status.</p>}\r\n    </div>\r\n  );\r\n}\r\n\r\n// ---------------------------------------------------------------- side panel: route\r\nconst KINDS = [{ value: 'point', label: 'Map point' }, { value: 'machine', label: 'Machine' }, { value: 'field', label: 'Field' }, { value: 'facility', label: 'Facility' }];\r\n\r\nfunction Endpoint({ label, value, onChange, picking, onPick, machines, fields, facilities }) {\r\n  const lists = {\r\n    machine: machines.filter((m) => m.mobile).map((m) => ({ value: m.id, label: m.designation + ' (' + m.status + ')' })),\r\n    field: fields.map((f) => ({ value: f.id, label: f.soil_no + ' · ' + f.crop + (f.harvest ? ' · ' + f.harvest.readiness : '') })),\r\n    facility: facilities.map((f) => ({ value: f.id, label: f.name }))\r\n  };\r\n  return (\r\n    <div className=\"mm-end\">\r\n      <strong>{label}</strong>\r\n      <Select value={value.kind} onChange={(k) => onChange(k === 'point' ? { kind: k } : { kind: k, id: lists[k][0] && lists[k][0].value })} options={KINDS} />\r\n      {value.kind === 'point' ? (\r\n        <button className={'btn' + (picking ? ' btn-primary' : '')} onClick={onPick}>\r\n          {picking ? 'Click the map…' : value.x !== undefined ? fmt(value.x, 0) + ', ' + fmt(value.y, 0) + ' · re-pick' : 'Pick on map'}\r\n        </button>\r\n      ) : (\r\n        <Select value={value.id} onChange={(id) => onChange({ kind: value.kind, id: Number(id) })} options={lists[value.kind]} />\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n\r\n// Consecutive segments on the same road become one step; the surface states along it are listed.\r\nfunction routeSteps(segments) {\r\n  const steps = [];\r\n  segments.forEach((s) => {\r\n    const last = steps[steps.length - 1];\r\n    const state = s.restricted || s.road_state;\r\n    if (last && last.name === s.name) {\r\n      last.length_m += s.length_m;\r\n      last.time_s += s.time_s;\r\n      if (last.states.indexOf(state) < 0) last.states.push(state);\r\n      last.restricted = last.restricted || !!s.restricted;\r\n    } else {\r\n      steps.push({ name: s.name, length_m: s.length_m, time_s: s.time_s, states: [state], restricted: !!s.restricted });\r\n    }\r\n  });\r\n  return steps;\r\n}\r\n\r\nfunction endpointBody(v) {\r\n  if (v.kind === 'machine') return { equipment_id: v.id };\r\n  if (v.kind === 'field') return { field_id: v.id };\r\n  if (v.kind === 'facility') return { node_id: v.id };\r\n  return v.x === undefined ? null : { x: v.x, y: v.y };\r\n}\r\n\r\nfunction RoutePanel({ map, live, form, setForm, picking, setPicking, route, setRoute }) {\r\n  const [busy, setBusy] = useState(false);\r\n  const mobileTypes = map.machine_types.filter((t) => t.mobile);\r\n  const run = async () => {\r\n    const from = endpointBody(form.from);\r\n    const to = endpointBody(form.to);\r\n    if (!from || !to) { notifyError(new Error('Choose both a start and an end point')); return; }\r\n    const body = { from, to, optimize: form.optimize };\r\n    if (form.vehicle === 'auto' && form.from.kind === 'machine') body.equipment_id = form.from.id;\r\n    else if (form.vehicle !== 'auto') body.machine_type = form.vehicle;\r\n    setBusy(true);\r\n    try { setRoute(await post('/machinery/route', body)); } catch (e) { setRoute(null); notifyError(e); } finally { setBusy(false); }\r\n  };\r\n  const common = { machines: live.machines, fields: map.fields, facilities: map.facilities };\r\n  return (\r\n    <div className=\"mm-side\">\r\n      <Endpoint label=\"A · From\" value={form.from} onChange={(v) => setForm({ ...form, from: v })} picking={picking === 'from'}\r\n        onPick={() => setPicking(picking === 'from' ? null : 'from')} {...common} />\r\n      <Endpoint label=\"B · To\" value={form.to} onChange={(v) => setForm({ ...form, to: v })} picking={picking === 'to'}\r\n        onPick={() => setPicking(picking === 'to' ? null : 'to')} {...common} />\r\n      <div className=\"mm-end\">\r\n        <strong>Vehicle</strong>\r\n        <Select value={form.vehicle} onChange={(v) => setForm({ ...form, vehicle: v })}\r\n          options={[{ value: 'auto', label: form.from.kind === 'machine' ? 'The start machine' : 'Generic tractor' }]\r\n            .concat(mobileTypes.map((t) => ({ value: t.type, label: t.type + ' (' + t.width_m + ' m, ' + t.weight_t + ' t)' })))} />\r\n      </div>\r\n      <div className=\"mm-end\">\r\n        <strong>Optimise</strong>\r\n        <Tabs small active={form.optimize} onChange={(k) => setForm({ ...form, optimize: k })}\r\n          tabs={[{ key: 'distance', label: 'Shortest distance' }, { key: 'time', label: 'Fastest time' }]} />\r\n      </div>\r\n      <div className=\"row\">\r\n        <button className=\"btn btn-primary\" onClick={run} disabled={busy}>{busy ? 'Calculating…' : 'Find route'}</button>\r\n        {route && <button className=\"btn\" onClick={() => setRoute(null)}>Clear</button>}\r\n      </div>\r\n      {route && (\r\n        <>\r\n          <div className=\"mm-kpis\">\r\n            <div className=\"kpi\"><span className=\"v\">{fmtDist(route.distance_m)}</span><span className=\"l\">route length</span></div>\r\n            <div className=\"kpi\"><span className=\"v\">{fmtTime(route.time_s)}</span><span className=\"l\">travel time</span></div>\r\n            <div className=\"kpi\"><span className=\"v\">{fmtDist(route.straight_m)}</span><span className=\"l\">straight line</span></div>\r\n          </div>\r\n          <p className=\"small\">\r\n            {route.from.label} → {route.to.label} for a <strong>{route.machine ? route.machine.designation : route.profile.type}</strong>\r\n            {' '}({route.profile.width_m} m, {route.profile.weight_t} t).\r\n          </p>\r\n          {route.detour_m > 0 && (\r\n            <div className=\"info-box\">{fmtDist(route.detour_m)} longer than the unrestricted route: {route.blocked_edges.length} road\r\n              {' '}sections are closed or too narrow/weak for this vehicle (dotted red on the map).</div>\r\n          )}\r\n          {route.muddy_m > 0 && <div className=\"warning-box\">{fmtDist(route.muddy_m)} of the route is muddy.</div>}\r\n          {route.restricted_m > 0 && <div className=\"warning-box\">The first or last {fmtDist(route.restricted_m)} uses a lane that is\r\n            {' '}too narrow or weak for this vehicle. Drive it only to reach the nearest junction.</div>}\r\n          <DataTable maxHeight={260} rows={routeSteps(route.segments)} columns={[\r\n            { key: 'name', label: 'Road' },\r\n            { key: 'states', label: 'State', render: (r) => (r.restricted ? <span className=\"pill pill-repair\">{r.states.join(', ')}</span> : r.states.join(', ')) },\r\n            { key: 'length_m', label: 'Length', align: 'right', render: (r) => fmtDist(r.length_m) },\r\n            { key: 'time_s', label: 'Time', align: 'right', render: (r) => fmtTime(r.time_s) }]} />\r\n        </>\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n\r\n// ---------------------------------------------------------------- page\r\nexport default function MachineryMap() {\r\n  const [map, setMap] = useState(null);\r\n  const [live, setLive] = useState(null);\r\n  const [tab, setTab] = useState('harvest');\r\n  const [fieldId, setFieldId] = useState(null);\r\n  const [machineId, setMachineId] = useState(null);\r\n  const [filter, setFilter] = useState({ status: '', type: '' });\r\n  const [form, setForm] = useState({ from: { kind: 'point' }, to: { kind: 'facility', id: null }, vehicle: 'auto', optimize: 'distance' });\r\n  const [picking, setPicking] = useState(null);\r\n  const [route, setRoute] = useState(null);\r\n  const proj = useProjection(map ? map.meters_per_unit : 2);\r\n\r\n  useEffect(() => {\r\n    api('/machinery/map').then((m) => {\r\n      setMap(m);\r\n      const plant = m.facilities.find((f) => f.name === 'Seed processing plant') || m.facilities[0];\r\n      setForm((f) => ({ ...f, to: { kind: 'facility', id: plant ? plant.id : null } }));\r\n    }).catch(notifyError);\r\n  }, []);\r\n  useEffect(() => {\r\n    let alive = true;\r\n    const load = () => api('/machinery/live').then((r) => alive && setLive(r)).catch((e) => alive && notifyError(e));\r\n    load();\r\n    const t = setInterval(load, LIVE_MS);\r\n    return () => { alive = false; clearInterval(t); };\r\n  }, []);\r\n\r\n  const onMapClick = useCallback((e) => {\r\n    if (!picking) return;\r\n    const p = proj.toXY(e.latlng);\r\n    setForm((f) => ({ ...f, [picking]: { kind: 'point', x: p.x, y: p.y } }));\r\n    setPicking(null);\r\n  }, [picking, proj]);\r\n\r\n  const nodeById = useMemo(() => {\r\n    const o = {};\r\n    if (map) map.roads.nodes.forEach((n) => { o[n.id] = n; });\r\n    return o;\r\n  }, [map]);\r\n  const blocked = useMemo(() => new Set(route ? route.blocked_edges.map((b) => b.id) : []), [route]);\r\n\r\n  if (!map || !live) return <Loading />;\r\n  const field = map.fields.find((f) => f.id === fieldId) || null;\r\n  const machine = live.machines.find((m) => m.id === machineId) || null;\r\n  const shown = live.machines.filter((m) => (!filter.status || m.status === filter.status) && (!filter.type || m.type === filter.type));\r\n  const onMachineClick = (m) => {\r\n    if (picking && m.mobile) {\r\n      setForm({ ...form, [picking]: { kind: 'machine', id: m.id } });\r\n      setPicking(null);\r\n      return;\r\n    }\r\n    setMachineId(m.id);\r\n    setTab('machinery');\r\n  };\r\n  const routeFrom = (m) => {\r\n    setForm({ ...form, from: { kind: 'machine', id: m.id }, vehicle: 'auto' });\r\n    setRoute(null);\r\n    setTab('route');\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      <PageTitle right={<span className=\"mm-live\"><i className=\"pulse\" /> Live · every {LIVE_MS / 1000} s</span>}>Harvest & machinery map</PageTitle>\r\n      <div className=\"grid g-side-r\">\r\n        <Panel title=\"Farm map\" extra={(\r\n          <div className=\"legend-row\">\r\n            {READINESS.map((r) => <span key={r.key} style={{ '--c': r.color }}>{r.label}</span>)}\r\n          </div>\r\n        )}>\r\n          <div className={'mm-map' + (picking ? ' picking' : '')}>\r\n            <MapContainer crs={L.CRS.Simple} bounds={proj.bounds} minZoom={-2} maxZoom={2} zoomSnap={0.25}\r\n              maxBounds={[[-200, -200], [MAP_H * map.meters_per_unit + 200, MAP_W * map.meters_per_unit + 200]]}\r\n              attributionControl={false} style={{ height: '100%', width: '100%' }}>\r\n              <MapClicks onClick={onMapClick} />\r\n              <ScaleControl position=\"bottomleft\" imperial={false} />\r\n              {/* backdrop: river, service area */}\r\n              <Rectangle bounds={proj.rect(0, 0, 14, MAP_H)} pathOptions={{ stroke: false, fillColor: '#9cc7e6', fillOpacity: 1 }} interactive={false} />\r\n              <Rectangle bounds={proj.rect(1005, 20, 90, 660)} pathOptions={{ stroke: false, fillColor: '#dfe5dc', fillOpacity: 1 }} interactive={false} />\r\n              <LayersControl position=\"topright\">\r\n                <LayersControl.Overlay checked name=\"Harvest conditions\">\r\n                  <LayerGroup>\r\n                    {map.fields.map((f) => {\r\n                      const hv = f.harvest;\r\n                      const c = hv ? READY_COLOR[hv.readiness] : '#cfe3c6';\r\n                      return (\r\n                        <React.Fragment key={f.id}>\r\n                          <Rectangle bounds={proj.rect(f.x, f.y, f.w, f.h)}\r\n                            pathOptions={{ color: f.id === fieldId ? '#13311e' : '#ffffff', weight: f.id === fieldId ? 3 : 1.5, fillColor: c, fillOpacity: 0.9 }}\r\n                            eventHandlers={{ click: () => { if (!picking) { setFieldId(f.id); setTab('harvest'); } } }}>\r\n                            <Tooltip direction=\"center\" permanent className=\"mm-field-label\">{f.soil_no}</Tooltip>\r\n                          </Rectangle>\r\n                          {hv && hv.readiness === 'harvesting' && (\r\n                            <Rectangle bounds={proj.rect(f.x, f.y, f.w * hv.harvested_pct / 100, f.h)} interactive={false}\r\n                              pathOptions={{ stroke: false, fillColor: READY_COLOR.harvested, fillOpacity: 0.95 }} />\r\n                          )}\r\n                        </React.Fragment>\r\n                      );\r\n                    })}\r\n                  </LayerGroup>\r\n                </LayersControl.Overlay>\r\n                <LayersControl.Overlay checked name=\"Road network\">\r\n                  <LayerGroup>\r\n                    {map.roads.edges.map((e) => {\r\n                      const a = nodeById[e.from_node];\r\n                      const b = nodeById[e.to_node];\r\n                      const st = { ...(ROAD_STYLE[e.road_class] || ROAD_STYLE.lane), ...(STATE_STYLE[e.road_state] || {}) };\r\n                      if (blocked.has(e.id)) Object.assign(st, { color: '#d64545', dashArray: '2 6', weight: 2 });\r\n                      return (\r\n                        <Polyline key={e.id} positions={[proj.ll(a.x, a.y), proj.ll(b.x, b.y)]} pathOptions={{ ...st, opacity: 0.95, lineCap: 'round' }}>\r\n                          <Tooltip sticky>{e.name} · {e.surface}, {e.width_m} m, ≤ {e.max_weight_t} t, {e.speed_limit_kmh} km/h · {e.road_state}\r\n                            {e.note ? ' · ' + e.note : ''}</Tooltip>\r\n                        </Polyline>\r\n                      );\r\n                    })}\r\n                    {map.facilities.map((n) => (\r\n                      <Marker key={n.id} position={proj.ll(n.x, n.y)} icon={FACILITY_ICON}>\r\n                        <Tooltip direction=\"left\" permanent className=\"mm-facility-label\">{n.name}</Tooltip>\r\n                      </Marker>\r\n                    ))}\r\n                  </LayerGroup>\r\n                </LayersControl.Overlay>\r\n                <LayersControl.Overlay checked name=\"Machinery (live)\">\r\n                  <LayerGroup>\r\n                    {shown.filter((m) => m.trail.length > 1).map((m) => (\r\n                      <Polyline key={'t' + m.id} positions={proj.pts(m.trail.concat([[m.x, m.y]]))} interactive={false}\r\n                        pathOptions={{ color: m.color || '#2a78d6', weight: 2, opacity: 0.7, dashArray: '3 4' }} />\r\n                    ))}\r\n                    {shown.map((m) => (\r\n                      <Marker key={m.id} position={proj.ll(m.x, m.y)} icon={machineIcon(m, m.id === machineId)} zIndexOffset={m.id === machineId ? 1000 : 0}\r\n                        eventHandlers={{ click: () => onMachineClick(m) }}>\r\n                        <Tooltip direction=\"top\" offset={[0, -12]}>{m.designation} · {m.status}{m.status === 'operating' && m.task ? ' · ' + m.task : ''}\r\n                          {m.speed_kmh > 0 ? ' · ' + m.speed_kmh + ' km/h' : ''}</Tooltip>\r\n                      </Marker>\r\n                    ))}\r\n                  </LayerGroup>\r\n                </LayersControl.Overlay>\r\n              </LayersControl>\r\n              {route && (\r\n                <>\r\n                  <Polyline positions={proj.pts(route.points)} pathOptions={{ color: '#ffffff', weight: 9, opacity: 0.9 }} interactive={false} />\r\n                  {route.segments.map((s, i) => (\r\n                    <Polyline key={i} positions={proj.pts(s.points)} interactive={false}\r\n                      pathOptions={{ color: s.restricted ? '#d64545' : '#2a78d6', weight: 5, dashArray: s.road_class === 'off-road' ? '6 6' : null }} />\r\n                  ))}\r\n                </>\r\n              )}\r\n              {/* route pins sit above the permanent facility labels (tooltip pane, z-index 650) */}\r\n              <Pane name=\"route-pins\" style={{ zIndex: 660 }}>\r\n                {route ? (\r\n                  <>\r\n                    <Marker position={proj.ll(route.from.x, route.from.y)} icon={endIcon('A')} />\r\n                    <Marker position={proj.ll(route.to.x, route.to.y)} icon={endIcon('B')} />\r\n                  </>\r\n                ) : (\r\n                  <>\r\n                    {form.from.kind === 'point' && form.from.x !== undefined && <Marker position={proj.ll(form.from.x, form.from.y)} icon={endIcon('A')} />}\r\n                    {form.to.kind === 'point' && form.to.x !== undefined && <Marker position={proj.ll(form.to.x, form.to.y)} icon={endIcon('B')} />}\r\n                  </>\r\n                )}\r\n              </Pane>\r\n            </MapContainer>\r\n          </div>\r\n          <div className=\"legend-row mm-legend2\">\r\n            {Object.keys(STATUS_COLOR).map((s) => <span key={s} style={{ '--c': STATUS_COLOR[s] }}>Machine {s}</span>)}\r\n            <span style={{ '--c': STATE_STYLE.muddy.color }}>Muddy road</span>\r\n            <span style={{ '--c': STATE_STYLE.rutted.color }}>Rutted road</span>\r\n            <span style={{ '--c': STATE_STYLE.closed.color }}>Closed / not passable</span>\r\n            <span style={{ '--c': '#2a78d6' }}>Route</span>\r\n          </div>\r\n        </Panel>\r\n        <Panel title={<Tabs small active={tab} onChange={setTab} tabs={[\r\n          { key: 'harvest', label: 'Harvest' }, { key: 'machinery', label: 'Machinery', badge: live.status_counts.operating || null },\r\n          { key: 'route', label: 'Shortest path' }]} />}>\r\n          {tab === 'harvest' && <HarvestPanel map={map} field={field} setFieldId={setFieldId} live={live.machines} />}\r\n          {tab === 'machinery' && <MachineryPanel live={live} types={map.machine_types} machine={machine} setMachineId={setMachineId}\r\n            filter={filter} setFilter={setFilter} onRouteFrom={routeFrom} />}\r\n          {tab === 'route' && <RoutePanel map={map} live={live} form={form} setForm={setForm} picking={picking} setPicking={setPicking}\r\n            route={route} setRoute={setRoute} />}\r\n        </Panel>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","// Irrigation system: canals and pumps on the farm map with live pump operation.\nimport React, { useEffect, useState } from 'react';\nimport { api, post } from '../api';\nimport FarmMap from '../components/FarmMap';\nimport { DataTable, Loading, PageTitle, Panel, StatusPill, notify, notifyError } from '../components/ui';\n\nconst PUMP_COLORS = { running: '#2f9e44', stopped: '#8a9a8f', fault: '#d64545' };\n\nfunction moistureColor(f) {\n  if (f.crop === 'rice') {\n    const wl = f.water_level_cm || 0;\n    return wl < 3 ? '#b9dcf2' : wl < 6 ? '#7fbde6' : '#4a9bd6';\n  }\n  const m = f.moisture_pct || 0;\n  return m < 28 ? '#e8d9a8' : m < 35 ? '#cfe3a6' : '#9fcf8a';\n}\n\nexport default function Irrigation() {\n  const [d, setD] = useState(null);\n  const load = () => api('/farm/irrigation').then(setD).catch(notifyError);\n  useEffect(() => { load(); const t = setInterval(load, 10000); return () => clearInterval(t); }, []);\n  if (!d) return <Loading />;\n  const running = {};\n  d.pumps.forEach((p) => { running[p.id] = p.status === 'running'; });\n  async function toggle(p) {\n    try { await post('/farm/irrigation/pumps/' + p.id + '/toggle'); notify(p.name + (p.status === 'running' ? ' stopped' : ' started')); load(); } catch (e) { notifyError(e); }\n  }\n  return (\n    <div>\n      <PageTitle right={<span className=\"small muted\">{d.summary.running} pumps running · {d.summary.total_flow_m3h} m³/h · {d.summary.power_kw} kW</span>}>\n        Irrigation system\n      </PageTitle>\n      <div className=\"grid g-side-r\">\n        <Panel title=\"Irrigation network\">\n          <FarmMap fields={d.fields} fillFor={moistureColor}\n            labelFor={(f) => [f.soil_no, f.crop === 'rice' ? `water ${f.water_level_cm ?? '-'} cm` : `moisture ${f.moisture_pct ?? '-'} %`]}\n            legend={[{ color: '#4a9bd6', label: 'Canal (flowing)' }, { color: '#9fb3c1', label: 'Canal (no flow)' }, { color: '#8a6d4f', label: 'Drain' },\n              { color: PUMP_COLORS.running, label: 'Pump running', shape: 'circle' }, { color: PUMP_COLORS.stopped, label: 'Pump stopped', shape: 'circle' },\n              { color: PUMP_COLORS.fault, label: 'Pump fault', shape: 'circle' }]}>\n            {d.canals.map((c) => {\n              const pts = c.points.split(';').map((p) => p.split(',').join(' ')).join(' L ');\n              const flowing = c.pump_id ? running[c.pump_id] : false;\n              const stroke = c.canal_type === 'drain' ? '#8a6d4f' : flowing ? '#4a9bd6' : '#9fb3c1';\n              return (\n                <path key={c.id} d={'M ' + pts} fill=\"none\" stroke={stroke} strokeWidth={c.canal_type === 'main' ? 8 : c.canal_type === 'drain' ? 5 : 3}\n                  className={flowing ? 'flow' : ''} opacity={c.canal_type === 'branch' ? 0.8 : 1}>\n                  <title>{c.name} ({c.capacity_m3h} m³/h)</title>\n                </path>\n              );\n            })}\n            {d.pumps.map((p) => (\n              <g key={p.id} transform={`translate(${p.x}, ${p.y})`} onClick={() => toggle(p)} style={{ cursor: 'pointer' }}>\n                <circle r=\"13\" fill={PUMP_COLORS[p.status]} stroke=\"#fff\" strokeWidth=\"3\" className={p.status === 'fault' ? 'pulse' : ''} />\n                {p.status === 'running' && (\n                  <g>\n                    <path d=\"M0 -8 L3 0 L0 8 L-3 0 Z\" fill=\"#fff\">\n                      <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0\" to=\"360\" dur=\"1.2s\" repeatCount=\"indefinite\" />\n                    </path>\n                  </g>\n                )}\n                <title>{p.name} — {p.status} (click to start / stop)</title>\n                <text x=\"18\" y=\"4\" className=\"lbl\">{p.name.split(' (')[0]}</text>\n              </g>\n            ))}\n          </FarmMap>\n        </Panel>\n        <Panel title=\"Pumps\">\n          <DataTable rowKey={(r) => r.id} rows={d.pumps} columns={[\n            { key: 'name', label: 'Pump' }, { key: 'status', label: 'Status', render: (r) => <StatusPill status={r.status} /> },\n            { key: 'flow_m3h', label: 'Flow m³/h', align: 'right' }, { key: 'power_kw', label: 'kW', align: 'right' },\n            { key: 'a', label: '', render: (r) => (\n              <button className=\"btn\" disabled={r.status === 'fault'} onClick={() => toggle(r)}>{r.status === 'running' ? 'Stop' : 'Start'}</button>) }]} />\n        </Panel>\n      </div>\n    </div>\n  );\n}\n","// Production diary: daily plan and performance per farmer for third-level departments.\nimport React, { useEffect, useState } from 'react';\nimport { Bar, BarChart, CartesianGrid, Legend, ResponsiveContainer, Tooltip, XAxis, YAxis } from 'recharts';\nimport { api, post } from '../api';\nimport { DataTable, Loading, PageTitle, Panel, Warning, notify, notifyError, SERIES } from '../components/ui';\n\nexport default function Diary() {\n  const [d, setD] = useState(null);\n  const [rows, setRows] = useState([]);\n  const [busy, setBusy] = useState(false);\n  const load = () => api('/diary').then((r) => { setD(r); setRows(r.rows || []); }).catch(notifyError);\n  useEffect(() => { load(); }, []);\n  if (!d) return <Loading />;\n  if (!d.approved) {\n    return (<div><PageTitle>Production diary</PageTitle><Warning>{d.message}</Warning></div>);\n  }\n  const set = (i, k, v) => setRows(rows.map((r, j) => (j === i ? { ...r, [k]: v } : r)));\n  async function save() {\n    setBusy(true);\n    try { const r = await post('/diary', { rows }); notify(r.message); load(); } catch (e) { notifyError(e); } finally { setBusy(false); }\n  }\n  const totalPlan = rows.reduce((a, r) => a + (Number(r.plan_qty) || 0), 0);\n  const totalExec = rows.reduce((a, r) => a + (Number(r.exec_qty) || 0), 0);\n  return (\n    <div>\n      <PageTitle right={<button className=\"btn btn-primary\" disabled={busy} onClick={save}>Save daily report</button>}>Production diary</PageTitle>\n      <div className=\"info-box\">\n        {d.department} · {d.date} · approved 5-day plan “{d.plan.variant_name}” ({d.plan.period_start} .. {d.plan.period_end}),\n        total {d.plan.total_planned.toFixed(2)} ha. The date is taken from the server automatically.\n      </div>\n      <div className=\"grid g2\">\n        <Panel title={`Daily plan and performance — ${d.date}`}>\n          <DataTable rowKey={(r) => r.farmer_id} rows={rows} columns={[\n            { key: 'full_name', label: 'Farmer' },\n            { key: 'plan_qty', label: 'Plan (ha)', render: (r) => <input type=\"number\" step=\"0.01\" min=\"0\" className=\"cell\" value={r.plan_qty}\n              onChange={(e) => set(rows.indexOf(r), 'plan_qty', e.target.value)} aria-label={'Plan of ' + r.full_name} /> },\n            { key: 'exec_qty', label: 'Performance (ha)', render: (r) => <input type=\"number\" step=\"0.01\" min=\"0\" className=\"cell\" value={r.exec_qty}\n              onChange={(e) => set(rows.indexOf(r), 'exec_qty', e.target.value)} aria-label={'Performance of ' + r.full_name} /> },\n            { key: 'saved', label: '', render: (r) => (r.saved ? <span className=\"small muted\">saved</span> : '') }]} />\n          <div className=\"row small\" style={{ marginTop: 8 }}>\n            <b>Total</b> plan {totalPlan.toFixed(2)} ha · performance {totalExec.toFixed(2)} ha\n            ({totalPlan ? Math.round(100 * totalExec / totalPlan) : 0}%)\n          </div>\n        </Panel>\n        <Panel title=\"5-day plan execution\">\n          <DataTable rowKey={(t) => t.process} rows={d.plan.tasks} columns={[\n            { key: 'process', label: 'Process' }, { key: 'planned_qty', label: 'Planned ha', align: 'right' },\n            { key: 'executed_qty', label: 'Executed ha', align: 'right' }]} />\n          <ResponsiveContainer width=\"100%\" height={200}>\n            <BarChart data={d.history} margin={{ top: 12, right: 8, left: -10, bottom: 0 }}>\n              <CartesianGrid stroke=\"#e3e8e4\" vertical={false} />\n              <XAxis dataKey=\"report_date\" tick={{ fontSize: 11 }} />\n              <YAxis />\n              <Tooltip />\n              <Legend />\n              <Bar dataKey=\"plan_qty\" name=\"Plan\" fill={SERIES[0]} />\n              <Bar dataKey=\"exec_qty\" name=\"Performance\" fill={SERIES[2]} />\n            </BarChart>\n          </ResponsiveContainer>\n        </Panel>\n      </div>\n    </div>\n  );\n}\n","// Authorization management (administrator only): users, login approval, menu permissions, organisation hierarchy.\nimport React, { useEffect, useState } from 'react';\nimport { api, del, post, put } from '../api';\nimport { DataTable, Loading, Modal, PageTitle, Panel, Select, StatusPill, Tabs, notify, notifyError } from '../components/ui';\n\nconst ROLES = ['admin', 'manager', 'operator', 'farmer'].map((r) => ({ value: r, label: r }));\n\nfunction UserEditor({ user, menus, deps, onClose, onSaved }) {\n  const isNew = !user.id;\n  const [f, setF] = useState({ ...user, password: '' });\n  const set = (k, v) => setF({ ...f, [k]: v });\n  const toggle = (k) => set('permissions', f.permissions.indexOf(k) >= 0 ? f.permissions.filter((x) => x !== k) : f.permissions.concat(k));\n  async function save() {\n    try {\n      if (isNew) await post('/admin/users', f); else await put('/admin/users/' + f.id, f);\n      notify('User saved');\n      onSaved();\n    } catch (e) { notifyError(e); }\n  }\n  return (\n    <Modal title={isNew ? 'Add user' : 'Edit user ' + user.username} onClose={onClose}\n      footer={<><button className=\"btn\" onClick={onClose}>Cancel</button><button className=\"btn btn-primary\" onClick={save}>Save</button></>}>\n      <div className=\"grid g2\">\n        <label className=\"field-inline\">Username <input type=\"text\" value={f.username} disabled={!isNew} onChange={(e) => set('username', e.target.value)} /></label>\n        <label className=\"field-inline\">Full name <input type=\"text\" value={f.full_name} onChange={(e) => set('full_name', e.target.value)} /></label>\n        <label className=\"field-inline\">Password <input type=\"password\" placeholder={isNew ? '' : '(unchanged)'} value={f.password} onChange={(e) => set('password', e.target.value)} /></label>\n        <Select label=\"Role\" value={f.role} onChange={(v) => set('role', v)} options={ROLES} />\n        <Select label=\"Department\" value={f.department_id} onChange={(v) => set('department_id', Number(v))}\n          options={deps.map((d) => ({ value: d.id, label: '— '.repeat(d.level - 1) + d.name + ' (L' + d.level + ')' }))} />\n        <label className=\"field-inline\"><input type=\"checkbox\" checked={!!f.approved} onChange={(e) => set('approved', e.target.checked)} /> Login approved</label>\n      </div>\n      <h4>Navigation permissions</h4>\n      <div className=\"grid g3\">\n        {menus.map((m) => (\n          <label key={m.key} className=\"field-inline\"><input type=\"checkbox\" checked={f.permissions.indexOf(m.key) >= 0} onChange={() => toggle(m.key)} /> {m.label}</label>\n        ))}\n      </div>\n    </Modal>\n  );\n}\n\nfunction Users({ menus, deps }) {\n  const [users, setUsers] = useState(null);\n  const [edit, setEdit] = useState(null);\n  const load = () => api('/admin/users').then(setUsers).catch(notifyError);\n  useEffect(() => { load(); }, []);\n  if (!users) return <Loading />;\n  async function approve(u, ok) {\n    try { await post('/admin/users/' + u.id + '/approve', { approved: ok }); notify(ok ? 'Login approved' : 'Login blocked'); load(); } catch (e) { notifyError(e); }\n  }\n  return (\n    <Panel title={`Users (${users.length})`} extra={<button className=\"btn btn-primary\"\n      onClick={() => setEdit({ username: '', full_name: '', role: 'farmer', department_id: deps[0] && deps[0].id, approved: true, permissions: ['home'] })}>Add user</button>}>\n      <DataTable maxHeight={600} rowKey={(u) => u.id} rows={users} columns={[\n        { key: 'username', label: 'Username' }, { key: 'full_name', label: 'Name' }, { key: 'role', label: 'Role' },\n        { key: 'department_name', label: 'Department', render: (u) => `${u.department_name} (L${u.department_level})` },\n        { key: 'approved', label: 'Login', render: (u) => <StatusPill status={u.approved ? 'approved' : 'pending'} /> },\n        { key: 'permissions', label: 'Menus', render: (u) => u.permissions.length },\n        { key: 'a', label: '', render: (u) => (\n          <span className=\"row\" style={{ flexWrap: 'nowrap' }}>\n            <button className=\"btn\" onClick={() => setEdit(u)}>Edit</button>\n            {u.approved ? <button className=\"btn btn-danger\" onClick={() => approve(u, false)}>Block</button>\n              : <button className=\"btn btn-primary\" onClick={() => approve(u, true)}>Approve login</button>}\n          </span>) }]} />\n      {edit && <UserEditor user={edit} menus={menus} deps={deps} onClose={() => setEdit(null)} onSaved={() => { setEdit(null); load(); }} />}\n    </Panel>\n  );\n}\n\nfunction Organisation({ deps, reload }) {\n  const [name, setName] = useState('');\n  const [parent, setParent] = useState('');\n  async function add() {\n    try { await post('/admin/departments', { name, parent_id: parent || null }); notify('Department added'); setName(''); reload(); } catch (e) { notifyError(e); }\n  }\n  async function rename(d) {\n    const n = window.prompt('New name for ' + d.name, d.name);\n    if (!n) return;\n    try { await put('/admin/departments/' + d.id, { name: n, crop: d.crop }); reload(); } catch (e) { notifyError(e); }\n  }\n  async function remove(d) {\n    try { await del('/admin/departments/' + d.id); notify('Department removed'); reload(); } catch (e) { notifyError(e); }\n  }\n  const ordered = [];\n  const walk = (pid) => deps.filter((d) => (d.parent_id || null) === pid).forEach((d) => { ordered.push(d); walk(d.id); });\n  walk(null);\n  return (\n    <Panel title=\"Organisation system (hierarchical structure)\" extra={\n      <div className=\"row\">\n        <input type=\"text\" placeholder=\"New department\" value={name} onChange={(e) => setName(e.target.value)} />\n        <Select value={parent} onChange={setParent} options={[{ value: '', label: '(top level)' }].concat(deps.filter((d) => d.level < 3).map((d) => ({ value: d.id, label: d.name })))} />\n        <button className=\"btn btn-primary\" disabled={!name} onClick={add}>Add</button>\n      </div>}>\n      <DataTable rowKey={(d) => d.id} rows={ordered} columns={[\n        { key: 'name', label: 'Department', render: (d) => <span style={{ paddingLeft: (d.level - 1) * 22 }}>{d.level > 1 ? '└ ' : ''}{d.name}</span> },\n        { key: 'level', label: 'Level', align: 'right' }, { key: 'crop', label: 'Crop' }, { key: 'members', label: 'Members', align: 'right' },\n        { key: 'a', label: '', render: (d) => (\n          <span className=\"row\" style={{ flexWrap: 'nowrap' }}>\n            <button className=\"btn\" onClick={() => rename(d)}>Rename</button>\n            <button className=\"btn btn-danger\" onClick={() => remove(d)}>Delete</button>\n          </span>) }]} />\n    </Panel>\n  );\n}\n\nfunction ErpLog() {\n  const [rows, setRows] = useState(null);\n  useEffect(() => { api('/erp/submissions').then(setRows).catch(notifyError); }, []);\n  if (!rows) return <Loading />;\n  return (\n    <Panel title=\"ERP interface log\">\n      <DataTable rowKey={(r) => r.id} rows={rows} columns={[\n        { key: 'submitted_at', label: 'Submitted' }, { key: 'ref_type', label: 'Type' }, { key: 'ref_id', label: 'Ref' },\n        { key: 'status', label: 'Status', render: (r) => <StatusPill status={r.status === 'submitted' ? 'submitted' : 'draft'} /> },\n        { key: 'submitted_by_name', label: 'By' }, { key: 'cancelled_at', label: 'Cancelled' },\n        { key: 'preview', label: 'Payload', render: (r) => <span className=\"small muted\">{String(r.preview).slice(0, 80)}…</span> }]} />\n    </Panel>\n  );\n}\n\nexport default function Admin() {\n  const [tab, setTab] = useState('users');\n  const [menus, setMenus] = useState([]);\n  const [deps, setDeps] = useState(null);\n  const loadDeps = () => api('/admin/departments').then(setDeps).catch(notifyError);\n  useEffect(() => { api('/admin/menus').then(setMenus).catch(notifyError); loadDeps(); }, []);\n  if (!deps) return <Loading />;\n  return (\n    <div>\n      <PageTitle>Authorization management</PageTitle>\n      <Tabs tabs={[{ key: 'users', label: 'Users & permissions' }, { key: 'org', label: 'Organisation' }, { key: 'erp', label: 'ERP log' }]} active={tab} onChange={setTab} />\n      {tab === 'users' && <Users menus={menus} deps={deps} />}\n      {tab === 'org' && <Organisation deps={deps} reload={loadDeps} />}\n      {tab === 'erp' && <ErpLog />}\n    </div>\n  );\n}\n","// Decision support: BP neural network yield prediction, PLS soil fertility & water holding analysis,\n// LP resource redistribution, and providing the optimised solutions to ERP.\nimport React, { useEffect, useState } from 'react';\nimport { Bar, BarChart, CartesianGrid, Legend, Line, LineChart, ResponsiveContainer, Tooltip, XAxis, YAxis } from 'recharts';\nimport { api, post } from '../api';\nimport FarmMap from '../components/FarmMap';\nimport { DataTable, Loading, PageTitle, Panel, Select, Tabs, notify, notifyError, SERIES } from '../components/ui';\n\nasync function toErp(kind, data) {\n  try { const r = await post('/decision/submit', { kind, data }); notify(r.message); } catch (e) { notifyError(e); }\n}\n\nfunction yieldColor(v) {\n  const t = Math.max(0, Math.min(1, (v - 3.5) / 5));\n  const r = Math.round(230 - t * 180);\n  const g = Math.round(200 - t * 40);\n  const b = Math.round(120 - t * 60);\n  return `rgb(${r},${g},${b})`;\n}\n\nfunction YieldTab({ fields }) {\n  const [d, setD] = useState(null);\n  const [busy, setBusy] = useState(false);\n  const load = (retrain) => { setBusy(true); api('/decision/yield' + (retrain ? '?retrain=1' : '')).then(setD).catch(notifyError).finally(() => setBusy(false)); };\n  useEffect(() => { load(false); }, []);\n  if (!d) return <Loading text=\"Training BP neural network...\" />;\n  const pred = {};\n  d.predictions.forEach((p) => { pred[p.field_id] = p.yield_t_ha; });\n  return (\n    <div className=\"grid g2\">\n      <Panel title=\"Predicted seed yield by field (t/ha)\" extra={\n        <div className=\"row\">\n          <button className=\"btn\" disabled={busy} onClick={() => load(true)}>Re-train (self-learning)</button>\n          <button className=\"btn btn-primary\" onClick={() => toErp('yield_prediction', { totals: d.totals, fields: d.predictions })}>Provide to ERP</button>\n        </div>}>\n        <FarmMap fields={fields} fillFor={(f) => yieldColor(pred[f.id] || 0)} labelFor={(f) => [f.soil_no, (pred[f.id] || 0).toFixed(2) + ' t/ha']}\n          legend={[{ color: yieldColor(4), label: '≈ 4 t/ha' }, { color: yieldColor(6), label: '≈ 6 t/ha' }, { color: yieldColor(8), label: '≈ 8 t/ha' }]} />\n      </Panel>\n      <div className=\"grid\" style={{ alignContent: 'start' }}>\n        <Panel title=\"Model\">\n          <div className=\"grid g3\">\n            <div className=\"kpi\"><span className=\"v\">{d.rmse}</span><span className=\"l\">RMSE t/ha (training)</span></div>\n            <div className=\"kpi\"><span className=\"v\">{d.samples}</span><span className=\"l\">Training samples</span></div>\n            {d.totals.map((t) => <div key={t.crop} className=\"kpi\"><span className=\"v\">{t.tonnes} t</span><span className=\"l\">Expected {t.crop} seed</span></div>)}\n          </div>\n          <div className=\"small muted\">BP neural network (7-8-1) · trained {String(d.trained_at).slice(0, 19)} {d.retrained ? '(just now)' : '(stored model)'}</div>\n          {d.loss && d.loss.length > 0 && (\n            <ResponsiveContainer width=\"100%\" height={160}>\n              <LineChart data={d.loss}><CartesianGrid stroke=\"#e3e8e4\" /><XAxis dataKey=\"epoch\" /><YAxis /><Tooltip />\n                <Line dataKey=\"mse\" name=\"Training MSE\" stroke={SERIES[0]} dot={false} /></LineChart>\n            </ResponsiveContainer>\n          )}\n        </Panel>\n        <Panel title=\"Predictions\">\n          <DataTable maxHeight={300} rowKey={(r) => r.field_id} rows={d.predictions} columns={[\n            { key: 'soil_no', label: 'Soil no.' }, { key: 'crop', label: 'Crop' }, { key: 'area_ha', label: 'ha', align: 'right' },\n            { key: 'yield_t_ha', label: 't/ha', align: 'right' }]} />\n        </Panel>\n      </div>\n    </div>\n  );\n}\n\nfunction FertilityTab() {\n  const [d, setD] = useState(null);\n  useEffect(() => { api('/decision/fertility').then(setD).catch(notifyError); }, []);\n  if (!d) return <Loading text=\"Running PLS regression...\" />;\n  const vip = d.variables.map((v, i) => ({ name: v.replace(/_/g, ' '), VIP: d.vip[i], coef: d.coefficients[i] }));\n  return (\n    <div className=\"grid g2\">\n      <div className=\"grid\" style={{ alignContent: 'start' }}>\n        <Panel title=\"Partial least squares: what drives yield (VIP)\" extra={\n          <button className=\"btn btn-primary\" onClick={() => toErp('soil_fertility', { grades: d.grades, fields: d.fields })}>Provide to ERP</button>}>\n          <ResponsiveContainer width=\"100%\" height={200}>\n            <BarChart data={vip} layout=\"vertical\" margin={{ left: 60 }}>\n              <CartesianGrid stroke=\"#e3e8e4\" horizontal={false} /><XAxis type=\"number\" /><YAxis type=\"category\" dataKey=\"name\" width={150} />\n              <Tooltip /><Bar dataKey=\"VIP\" fill={SERIES[0]} />\n            </BarChart>\n          </ResponsiveContainer>\n          <div className=\"small muted\">PLS RMSE {d.rmse} · reference evapotranspiration {d.et0} mm/day</div>\n        </Panel>\n        <Panel title=\"Land grades\">\n          <DataTable rowKey={(g) => g.grade} rows={d.grades} columns={[\n            { key: 'grade', label: 'Grade' }, { key: 'fields', label: 'Fields', align: 'right' },\n            { key: 'whc', label: 'Water holding mm/m', align: 'right' }, { key: 'organic_matter', label: 'Organic matter %', align: 'right' },\n            { key: 'yield_index', label: 'Yield index', align: 'right' }]} />\n        </Panel>\n      </div>\n      <Panel title=\"Water holding capacity and soil fertility measures (lowest fertility first)\">\n        <DataTable maxHeight={620} rowKey={(r) => r.field_id} rows={d.fields} columns={[\n          { key: 'soil_no', label: 'Soil no.' }, { key: 'grade', label: 'Grade', align: 'right' },\n          { key: 'fertility_index', label: 'Fertility idx', align: 'right' }, { key: 'taw_mm', label: 'Avail. water mm', align: 'right' },\n          { key: 'irrigation_interval_days', label: 'Irrig. interval d', align: 'right' },\n          { key: 'recommendations', label: 'Measures', render: (r) => <span style={{ whiteSpace: 'normal' }}>{r.recommendations.join('; ')}</span> }]} />\n      </Panel>\n    </div>\n  );\n}\n\nfunction AllocationTab() {\n  const [res, setRes] = useState('labor');\n  const [d, setD] = useState(null);\n  useEffect(() => { setD(null); api('/decision/allocation?resource=' + res).then(setD).catch(notifyError); }, [res]);\n  return (\n    <Panel title=\"Resource redistribution (linear programming)\" extra={\n      <div className=\"row\">\n        <Select label=\"Resource\" value={res} onChange={setRes} options={[{ value: 'labor', label: 'Manpower' }, { value: 'equipment', label: 'Equipment' }, { value: 'water', label: 'Water' }]} />\n        {d && <button className=\"btn btn-primary\" onClick={() => toErp('allocation_' + res, d)}>Provide to ERP</button>}\n      </div>}>\n      {!d ? <Loading /> : (\n        <div className=\"grid g2\">\n          <ResponsiveContainer width=\"100%\" height={300}>\n            <BarChart data={d.balance} margin={{ top: 10 }}>\n              <CartesianGrid stroke=\"#e3e8e4\" vertical={false} /><XAxis dataKey=\"name\" tick={{ fontSize: 11 }} /><YAxis unit={' ' + d.unit} width={90} />\n              <Tooltip /><Legend />\n              <Bar dataKey=\"available\" name=\"Available\" fill={SERIES[0]} />\n              <Bar dataKey=\"required\" name=\"Required (current 5-day plan)\" fill={SERIES[1]} />\n              <Bar dataKey=\"after\" name=\"After redistribution\" fill={SERIES[2]} />\n            </BarChart>\n          </ResponsiveContainer>\n          <div>\n            <h4>Optimal transfers</h4>\n            <DataTable rows={d.transfers} empty=\"No surplus can cover a deficit — balance is already optimal or resources are short overall.\" columns={[\n              { key: 'from', label: 'From' }, { key: 'to', label: 'To' }, { key: 'quantity', label: 'Quantity (' + d.unit + ')', align: 'right' }]} />\n            {d.balance.some((b) => b.after < b.required) && (\n              <div className=\"warning-box\" style={{ marginTop: 10 }}>\n                Remaining shortage: {d.balance.filter((b) => b.after < b.required).map((b) => `${b.name} ${Math.round(b.required - b.after)} ${d.unit}`).join(', ')}.\n                Request additional resources from ERP.\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n    </Panel>\n  );\n}\n\nexport default function Decision() {\n  const [tab, setTab] = useState('yield');\n  const [fields, setFields] = useState([]);\n  useEffect(() => { api('/farm/fields').then(setFields).catch(notifyError); }, []);\n  return (\n    <div>\n      <PageTitle>Decision support and ERP optimisation</PageTitle>\n      <Tabs tabs={[{ key: 'yield', label: 'Yield prediction (BPNN)' }, { key: 'soil', label: 'Soil fertility & water (PLS)' },\n        { key: 'alloc', label: 'Resource redistribution (LP)' }]} active={tab} onChange={setTab} />\n      {tab === 'yield' && <YieldTab fields={fields} />}\n      {tab === 'soil' && <FertilityTab />}\n      {tab === 'alloc' && <AllocationTab />}\n    </div>\n  );\n}\n","// Joint ratification of edits to data stored on earlier dates (entering person + manager).\nimport React, { useEffect, useState } from 'react';\nimport { api, post } from '../api';\nimport { DataTable, Loading, PageTitle, Panel, notify, notifyError } from '../components/ui';\n\nexport default function EditRequests({ user }) {\n  const [rows, setRows] = useState(null);\n  const load = () => api('/edit-requests').then(setRows).catch(notifyError);\n  useEffect(() => { load(); }, []);\n  async function act(r, what) {\n    try {\n      const res = await post('/edit-requests/' + r.id + '/' + what);\n      notify(what === 'reject' ? 'Request rejected' : res.status === 'applied' ? 'Both parties ratified: change applied.' : 'Ratified. Waiting for the other party.');\n      load();\n    } catch (e) { notifyError(e); }\n  }\n  if (!rows) return <Loading />;\n  return (\n    <div>\n      <PageTitle>Ratification of data edits</PageTitle>\n      <div className=\"info-box\">Only data stored today can be edited directly. Changes to earlier data need joint ratification by the person who entered it and a manager.</div>\n      <Panel>\n        <DataTable rowKey={(r) => r.id} rows={rows} empty=\"No pending requests\" columns={[\n          { key: 'created_at', label: 'Requested' }, { key: 'table_name', label: 'Data' }, { key: 'record_id', label: 'Record' },\n          { key: 'payload', label: 'Change', render: (r) => <code>{r.payload}</code> },\n          { key: 'requested_by_name', label: 'Requested by' }, { key: 'owner_name', label: 'Entered by' },\n          { key: 'owner_approved', label: 'Owner', render: (r) => (r.owner_approved ? '✔' : '…') },\n          { key: 'manager_approved', label: 'Manager', render: (r) => (r.manager_approved ? '✔' : '…') },\n          { key: 'a', label: '', render: (r) => {\n            const canOwner = r.owner_id === user.id && !r.owner_approved;\n            const canMgr = (user.role === 'manager' || user.role === 'admin') && r.owner_id !== user.id && !r.manager_approved;\n            return (\n              <span className=\"row\" style={{ flexWrap: 'nowrap' }}>\n                <button className=\"btn btn-primary\" disabled={!canOwner && !canMgr} onClick={() => act(r, 'approve')}>Ratify</button>\n                <button className=\"btn btn-danger\" onClick={() => act(r, 'reject')}>Reject</button>\n              </span>\n            );\n          } }]} />\n      </Panel>\n    </div>\n  );\n}\n","import React, { useCallback, useEffect, useState } from 'react';\r\nimport { BrowserRouter, Redirect, Route, Switch } from 'react-router-dom';\r\nimport { api, setToken, getToken } from './api';\r\nimport { Header, Nav, allowed } from './components/Shell';\r\nimport { Notifier, Loading } from './components/ui';\r\nimport Login from './pages/Login';\r\nimport Home from './pages/Home';\r\nimport VarietyLayout from './pages/VarietyLayout';\r\nimport { AnnualPlan, MonthlyPlan, FifteenPlan, FivePlan } from './pages/PlanPages';\r\nimport Weather from './pages/Weather';\r\nimport Fulfilment from './pages/Fulfilment';\r\nimport GrowthForecast from './pages/GrowthForecast';\r\nimport PestMonitoring from './pages/PestMonitoring';\r\nimport { PowerConsumption, PowerSystem } from './pages/Power';\r\nimport Equipment from './pages/Equipment';\r\nimport MachineryMap from './pages/MachineryMap';\r\nimport Irrigation from './pages/Irrigation';\r\nimport Diary from './pages/Diary';\r\nimport Admin from './pages/Admin';\r\nimport Decision from './pages/Decision';\r\nimport EditRequests from './pages/EditRequests';\r\n\r\nconst ROUTES = [\r\n  { path: '/', key: 'home', component: Home, exact: true },\r\n  { path: '/layout', key: 'layout', component: VarietyLayout },\r\n  { path: '/plans/annual', key: 'annual', component: AnnualPlan },\r\n  { path: '/plans/monthly', key: 'monthly', component: MonthlyPlan },\r\n  { path: '/plans/fifteen', key: 'fifteen', component: FifteenPlan },\r\n  { path: '/plans/five', key: 'five', component: FivePlan },\r\n  { path: '/weather', key: 'weather', component: Weather },\r\n  { path: '/fulfilment', key: 'fulfilment', component: Fulfilment },\r\n  { path: '/quality/growth', key: 'growth', component: GrowthForecast },\r\n  { path: '/quality/pests', key: 'pest', component: PestMonitoring },\r\n  { path: '/power/consumption', key: 'power_consumption', component: PowerConsumption },\r\n  { path: '/power/system', key: 'power_system', component: PowerSystem },\r\n  { path: '/equipment', key: 'equipment', component: Equipment },\r\n  { path: '/machinery-map', key: 'machinery_map', component: MachineryMap },\r\n  { path: '/irrigation', key: 'irrigation', component: Irrigation },\r\n  { path: '/diary', key: 'diary', component: Diary },\r\n  { path: '/decision', key: 'decision', component: Decision },\r\n  { path: '/admin', key: 'admin', component: Admin }\r\n];\r\n\r\nfunction NoAccess() {\r\n  return <div className=\"warning-box\">Your identifier does not have permission for this page.</div>;\r\n}\r\n\r\nexport default function App() {\r\n  const [user, setUser] = useState(null);\r\n  const [checking, setChecking] = useState(!!getToken());\r\n\r\n  const logout = useCallback(() => { setToken(''); setUser(null); }, []);\r\n\r\n  useEffect(() => {\r\n    window.addEventListener('mes-logout', logout);\r\n    if (getToken()) {\r\n      api('/auth/me').then((r) => setUser(r.user)).catch(() => setToken('')).finally(() => setChecking(false));\r\n    }\r\n    return () => window.removeEventListener('mes-logout', logout);\r\n  }, [logout]);\r\n\r\n  if (checking) return <Loading text=\"Connecting to MES server...\" />;\r\n  if (!user) return (<><Login onLogin={(u) => setUser(u)} /><Notifier /></>);\r\n\r\n  const firstAllowed = ROUTES.find((r) => allowed(user, r.key));\r\n  return (\r\n    <BrowserRouter>\r\n      <div className=\"app\">\r\n        <Header user={user} onLogout={logout} />\r\n        <Nav user={user} />\r\n        <main className=\"main\">\r\n          <Switch>\r\n            {ROUTES.map((r) => (\r\n              <Route key={r.path} path={r.path} exact={r.exact}\r\n                render={() => (allowed(user, r.key) ? <r.component user={user} />\r\n                  : (r.path === '/' && firstAllowed ? <Redirect to={firstAllowed.path} /> : <NoAccess />))} />\r\n            ))}\r\n            <Route path=\"/edit-requests\" render={() => <EditRequests user={user} />} />\r\n            <Route render={() => <Redirect to=\"/\" />} />\r\n          </Switch>\r\n        </main>\r\n      </div>\r\n      <Notifier />\r\n    </BrowserRouter>\r\n  );\r\n}\r\n","import React from 'react';\nimport ReactDOM from 'react-dom';\nimport './index.css';\nimport App from './App';\n\nReactDOM.render(<App />, document.getElementById('root'));\n"]}}