AI,CAAE,CAAC,CAAEI,GAAG,CAAE,MAAM,CAAEjC,KAAK,CAAE,4BAA6B,CAAC,CAAE,CAAEiC,GAAG,CAAE,QAAQ,CAAEjC,KAAK,CAAE,mCAAoC,CAAC,CAC9H,CAAEiC,GAAG,CAAE,UAAU,CAAEjC,KAAK,CAAE,8BAA+B,CAAC,CAAE,CAAEiC,GAAG,CAAE,MAAM,CAAEjC,KAAK,CAAE,yCAA0C,CAAC,CAAE,CACjI8B,MAAM,CAAE0L,GAAI,CAACzL,QAAQ,CAAE0L,MAAO,CAAE,CAAC,CAChCD,GAAG,GAAK,MAAM,eAAI9Q,0BAAA,CAACyJ,cAAc,GAAE,CAAC,CACpCqH,GAAG,GAAK,QAAQ,eAAI9Q,0BAAA,CAAC+M,gBAAgB,GAAE,CAAC,CACxC+D,GAAG,GAAK,UAAU,eAAI9Q,0BAAA,CAAC8N,kBAAkB,GAAE,CAAC,CAC5CgD,GAAG,GAAK,MAAM,eAAI9Q,0BAAA,CAACkQ,cAAc,GAAE,CAAC,EACjC,CAAC,cACPlQ,0BAAA,CAACyE,QAAQ,GAAE,CAAC,EACT,CAAC,CAEV,C;;AClTAyM,mBAAQ,CAACrS,MAAM,cAACmB,0BAAA,CAAC0Q,GAAG,GAAE,CAAC,CAAES,QAAQ,CAACC,cAAc,CAAC,MAAM,CAAC,CAAC,C","file":"x","sourcesContent":["// extracted by mini-css-extract-plugin","// REST client for the CPS backend (same origin in production, CRA proxy in development).\nconst BASE = process.env.REACT_APP_API || '';\n\nexport function getToken() {\n  try { return localStorage.getItem('cps_token') || ''; } catch (e) { return ''; }\n}\n\nexport function setToken(t) {\n  try { if (t) localStorage.setItem('cps_token', t); else localStorage.removeItem('cps_token'); } catch (e) { /* ignore */ }\n}\n\nexport async function api(path, options = {}) {\n  const headers = { 'Content-Type': 'application/json' };\n  const token = getToken();\n  if (token) headers.Authorization = 'Bearer ' + token;\n  const res = await fetch(BASE + '/api' + path, {\n    method: options.method || (options.body ? 'POST' : 'GET'),\n    headers,\n    body: options.body ? JSON.stringify(options.body) : undefined\n  });\n  let data = null;\n  try { data = await res.json(); } catch (e) { data = null; }\n  if (res.status === 401 && path.indexOf('/auth/login') < 0) {\n    setToken('');\n    window.dispatchEvent(new Event('cps-logout'));\n  }\n  if (!res.ok) {\n    const err = new Error((data && data.error) || 'Request failed (' + res.status + ')');\n    err.status = res.status;\n    err.warning = !!(data && data.warning);\n    throw err;\n  }\n  return data;\n}\n\nexport const post = (path, body) => api(path, { method: 'POST', body: body || {} });\nexport const put = (path, body) => api(path, { method: 'PUT', body: body || {} });\nexport const del = (path) => api(path, { method: 'DELETE' });\n","// Three.js 3D growth simulation of a rice or wheat plot. Plants are generated procedurally from the growth state\n// predicted by MES: leaf number, tiller number, plant height, ripeness and growth stage.\nimport React, { useEffect, useRef } from 'react';\nimport * as THREE from 'three';\n\nconst GREEN = new THREE.Color('#3f8f2f');\nconst GOLD = new THREE.Color('#d9b23a');\n\nfunction leafGeometry(length, width) {\n  // a curved strap-shaped leaf as a thin bent plane\n  const g = new THREE.PlaneGeometry(width, length, 1, 8);\n  const pos = g.attributes.position;\n  for (let i = 0; i < pos.count; i++) {\n    const y = pos.getY(i) + length / 2;\n    const t = y / length;\n    pos.setY(i, y);\n    pos.setZ(i, t * t * length * 0.45); // bend outward\n    pos.setX(i, pos.getX(i) * (1 - t * 0.85)); // taper\n  }\n  g.computeVertexNormals();\n  return g;\n}\n\nfunction buildPlant(state, crop, rnd) {\n  const group = new THREE.Group();\n  const height = Math.max(0.05, state.height_cm / 100);\n  const tillers = Math.max(1, Math.round(crop === 'rice' ? state.tiller : state.tiller * 1.2));\n  const leaves = Math.max(1, Math.round(state.leaf));\n  const color = GREEN.clone().lerp(GOLD, state.ripeness);\n  const stemMat = new THREE.MeshLambertMaterial({ color: color.clone().multiplyScalar(0.9) });\n  const leafMat = new THREE.MeshLambertMaterial({ color, side: THREE.DoubleSide });\n  const headMat = new THREE.MeshLambertMaterial({ color: GOLD.clone().lerp(new THREE.Color('#8fae4c'), 1 - state.ripeness) });\n  const heading = ['Heading', 'Grain filling', 'Maturity'].indexOf(state.stage) >= 0;\n  const visibleLeaves = Math.min(5, leaves);\n  for (let t = 0; t < Math.min(tillers, 24); t++) {\n    const tiller = new THREE.Group();\n    const lean = (t === 0 ? 0 : 0.12 + rnd() * 0.22);\n    tiller.rotation.z = lean;\n    tiller.rotation.y = (t / Math.min(tillers, 24)) * Math.PI * 2 + rnd();\n    const h = height * (0.85 + rnd() * 0.2);\n    const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.004, 0.007, h, 5), stemMat);\n    stem.position.y = h / 2;\n    tiller.add(stem);\n    for (let l = 0; l < visibleLeaves; l++) {\n      const len = h * (0.45 + 0.35 * (l / visibleLeaves));\n      const leaf = new THREE.Mesh(leafGeometry(len, 0.018), leafMat);\n      leaf.position.y = h * (0.15 + 0.7 * (l / visibleLeaves));\n      leaf.rotation.y = l * 2.4 + rnd();\n      leaf.rotation.x = -0.25;\n      tiller.add(leaf);\n    }\n    if (heading) {\n      if (crop === 'rice') {\n        // drooping panicle: chain of small grains along a bent curve\n        const n = 10;\n        for (let k = 0; k < n; k++) {\n          const s = k / n;\n          const grain = new THREE.Mesh(new THREE.SphereGeometry(0.009, 5, 4), headMat);\n          grain.position.set(Math.sin(s * 1.6) * 0.08, h + Math.cos(s * 1.6) * 0.06 - 0.02 - s * 0.05 * state.ripeness * 2, 0);\n          tiller.add(grain);\n        }\n      } else {\n        const spike = new THREE.Mesh(new THREE.CylinderGeometry(0.014, 0.01, 0.09, 6), headMat);\n        spike.position.y = h + 0.045;\n        tiller.add(spike);\n      }\n    }\n    group.add(tiller);\n  }\n  return group;\n}\n\nexport default function CropScene({ state, crop, height = 360 }) {\n  const mount = useRef(null);\n  const ctx = useRef(null);\n\n  // one-time scene setup\n  useEffect(() => {\n    const el = mount.current;\n    const scene = new THREE.Scene();\n    scene.background = new THREE.Color(crop === 'rice' ? '#dceefa' : '#eef1fa');\n    const camera = new THREE.PerspectiveCamera(40, el.clientWidth / height, 0.01, 50);\n    const renderer = new THREE.WebGLRenderer({ antialias: true });\n    renderer.setPixelRatio(Math.min(2, window.devicePixelRatio || 1));\n    renderer.setSize(el.clientWidth, height);\n    el.appendChild(renderer.domElement);\n    scene.add(new THREE.HemisphereLight(0xffffff, 0x556644, 0.9));\n    const sun = new THREE.DirectionalLight(0xffffff, 0.7);\n    sun.position.set(2, 4, 3);\n    scene.add(sun);\n    const ground = new THREE.Mesh(new THREE.PlaneGeometry(3, 3),\n      new THREE.MeshLambertMaterial({ color: crop === 'rice' ? '#6b8fa8' : '#8a6d4f' }));\n    ground.rotation.x = -Math.PI / 2;\n    scene.add(ground);\n    const plot = new THREE.Group();\n    scene.add(plot);\n    let yaw = 0.6;\n    let pitch = 0.45;\n    let dist = 2.2;\n    const place = () => {\n      camera.position.set(Math.sin(yaw) * Math.cos(pitch) * dist, Math.sin(pitch) * dist + 0.2, Math.cos(yaw) * Math.cos(pitch) * dist);\n      camera.lookAt(0, 0.35, 0);\n    };\n    place();\n    let drag = null;\n    const down = (e) => { drag = { x: e.clientX, y: e.clientY }; };\n    const move = (e) => {\n      if (!drag) return;\n      yaw -= (e.clientX - drag.x) * 0.01;\n      pitch = Math.max(0.05, Math.min(1.3, pitch + (e.clientY - drag.y) * 0.01));\n      drag = { x: e.clientX, y: e.clientY };\n      place();\n    };\n    const up = () => { drag = null; };\n    const wheel = (e) => { e.preventDefault(); dist = Math.max(0.8, Math.min(5, dist * (e.deltaY > 0 ? 1.1 : 0.9))); place(); };\n    renderer.domElement.addEventListener('pointerdown', down);\n    window.addEventListener('pointermove', move);\n    window.addEventListener('pointerup', up);\n    renderer.domElement.addEventListener('wheel', wheel, { passive: false });\n    let raf;\n    let auto = true;\n    renderer.domElement.addEventListener('pointerdown', () => { auto = false; });\n    const loop = () => {\n      if (auto) { yaw += 0.002; place(); }\n      renderer.render(scene, camera);\n      raf = requestAnimationFrame(loop);\n    };\n    loop();\n    const resize = () => {\n      camera.aspect = el.clientWidth / height;\n      camera.updateProjectionMatrix();\n      renderer.setSize(el.clientWidth, height);\n    };\n    window.addEventListener('resize', resize);\n    ctx.current = { scene, plot };\n    return () => {\n      cancelAnimationFrame(raf);\n      window.removeEventListener('resize', resize);\n      window.removeEventListener('pointermove', move);\n      window.removeEventListener('pointerup', up);\n      renderer.dispose();\n      el.removeChild(renderer.domElement);\n    };\n  }, [crop, height]);\n\n  // rebuild plants whenever the simulated growth state changes\n  useEffect(() => {\n    if (!ctx.current || !state) return;\n    const { plot } = ctx.current;\n    while (plot.children.length) {\n      const c = plot.children.pop();\n      c.traverse((o) => { if (o.geometry) o.geometry.dispose(); });\n    }\n    let seed = 7;\n    const rnd = () => { seed = (seed * 16807) % 2147483647; return seed / 2147483647; };\n    const n = crop === 'rice' ? 4 : 6; // hills per side (rice transplanted in hills, wheat drilled densely)\n    const spacing = crop === 'rice' ? 0.3 : 0.2;\n    for (let i = 0; i < n; i++) {\n      for (let j = 0; j < n; j++) {\n        const p = buildPlant(crop === 'wheat' ? { ...state, tiller: Math.max(1, state.tiller / 2) } : state, crop, rnd);\n        p.position.set((i - (n - 1) / 2) * spacing + (rnd() - 0.5) * 0.03, 0, (j - (n - 1) / 2) * spacing + (rnd() - 0.5) * 0.03);\n        plot.add(p);\n      }\n    }\n  }, [state, crop]);\n\n  return <div ref={mount} style={{ width: '100%', height, borderRadius: 6, overflow: 'hidden', cursor: 'grab' }} aria-label={`3D ${crop} growth simulation`} />;\n}\n","// SVG farm map: fields with soil numbers, roads/canals backdrop, overlays and a legend in the lower-left corner.\nimport React from 'react';\n\nexport const VIEW_W = 1100;\nexport const VIEW_H = 700;\n\nexport default function FarmMap({ fields, fillFor, labelFor, subFor, onFieldClick, selectedId, legend, children,\n  onFieldDragOver, onFieldDrop, renderFieldExtra, height }) {\n  return (\n    <svg className=\"farm-map\" viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} role=\"img\" aria-label=\"Farm map\" style={height ? { maxHeight: height } : undefined}>\n      {/* backdrop: river, road and service area */}\n      <rect x=\"0\" y=\"0\" width=\"14\" height={VIEW_H} fill=\"#9cc7e6\" />\n      <rect x=\"512\" y=\"40\" width=\"36\" height=\"560\" fill=\"#d8d2c4\" />\n      <rect x=\"1005\" y=\"20\" width=\"90\" height=\"660\" rx=\"8\" fill=\"#dfe5dc\" />\n      <text x=\"1050\" y=\"16\" textAnchor=\"middle\" className=\"sub\">Service area</text>\n      {fields.map((f) => {\n        const lines = labelFor ? [].concat(labelFor(f)) : [f.soil_no];\n        return (\n          <g key={f.id}\n            onClick={onFieldClick ? () => onFieldClick(f) : undefined}\n            onDragOver={onFieldDragOver ? (e) => { e.preventDefault(); onFieldDragOver(f, e); } : undefined}\n            onDrop={onFieldDrop ? (e) => { e.preventDefault(); onFieldDrop(f, e); } : undefined}>\n            <rect className={'field' + (selectedId === f.id ? ' selected' : '')} x={f.x} y={f.y} width={f.w} height={f.h} rx=\"4\"\n              fill={fillFor ? fillFor(f) : '#9ccc9c'}>\n              <title>{f.soil_no}</title>\n            </rect>\n            <text x={f.x + 6} y={f.y + 15} className=\"lbl\">{lines[0]}</text>\n            {lines.slice(1).map((l, i) => <text key={i} x={f.x + 6} y={f.y + 30 + i * 13} className=\"sub\">{l}</text>)}\n            {subFor && <text x={f.x + f.w - 6} y={f.y + f.h - 6} textAnchor=\"end\" className=\"sub\">{subFor(f)}</text>}\n            {renderFieldExtra && renderFieldExtra(f)}\n          </g>\n        );\n      })}\n      {children}\n      {legend && legend.length > 0 && <Legend items={legend} />}\n    </svg>\n  );\n}\n\n// Legend drawn at the bottom-left of the map.\nexport function Legend({ items }) {\n  const perRow = 4;\n  const rows = Math.ceil(items.length / perRow);\n  const h = rows * 20 + 12;\n  return (\n    <g transform={`translate(20, ${VIEW_H - h - 8})`}>\n      <rect width={perRow * 118 + 12} height={h} rx=\"6\" fill=\"#ffffff\" opacity=\"0.93\" stroke=\"#c9d3cb\" />\n      {items.map((it, i) => (\n        <g key={i} transform={`translate(${10 + (i % perRow) * 118}, ${10 + Math.floor(i / perRow) * 20})`}>\n          {it.shape === 'circle' ? <circle cx=\"7\" cy=\"7\" r=\"6\" fill={it.color} /> : <rect width=\"14\" height=\"14\" rx=\"3\" fill={it.color} />}\n          <text x=\"20\" y=\"11\" style={{ fontSize: 11 }} fill=\"#1d2a22\">{it.label}</text>\n        </g>\n      ))}\n    </g>\n  );\n}\n\nexport const STATUS_COLORS = { normal: '#5cb85c', abnormal: '#d64545', harvest: '#f2c230', disease: '#d64545', pest: '#f2c230' };\n","// Small shared UI building blocks: notifications, tabs, panels, tables, modal, select helpers.\nimport React, { useEffect, useState } from 'react';\n\n// ---------------------------------------------------------------- notifications\nconst listeners = new Set();\nexport function notify(text, kind = 'success') {\n  const n = { id: Date.now() + Math.random(), text, kind };\n  listeners.forEach((l) => l(n));\n}\nexport function notifyError(e) { notify(e.message || String(e), e.warning ? 'warning' : 'error'); }\n\nexport function Notifier() {\n  const [items, setItems] = useState([]);\n  useEffect(() => {\n    const l = (n) => {\n      setItems((s) => [...s, n]);\n      setTimeout(() => setItems((s) => s.filter((x) => x.id !== n.id)), n.kind === 'success' ? 4000 : 7000);\n    };\n    listeners.add(l);\n    return () => listeners.delete(l);\n  }, []);\n  return (\n    <div className=\"notifier\">\n      {items.map((n) => (\n        <div key={n.id} className={'toast toast-' + n.kind} onClick={() => setItems((s) => s.filter((x) => x.id !== n.id))}>\n          <strong>{n.kind === 'warning' ? 'Warning' : n.kind === 'error' ? 'Error' : 'Notice'}</strong>\n          <span>{n.text}</span>\n        </div>\n      ))}\n    </div>\n  );\n}\n\n// ---------------------------------------------------------------- layout primitives\nexport function Panel({ title, extra, children, className = '', style }) {\n  return (\n    <section className={'panel ' + className} style={style}>\n      {(title || extra) && (\n        <header className=\"panel-head\">\n          <h3>{title}</h3>\n          <div className=\"panel-extra\">{extra}</div>\n        </header>\n      )}\n      <div className=\"panel-body\">{children}</div>\n    </section>\n  );\n}\n\nexport function Tabs({ tabs, active, onChange, small }) {\n  return (\n    <div className={'tabs' + (small ? ' tabs-small' : '')} role=\"tablist\">\n      {tabs.map((t) => (\n        <button key={t.key} role=\"tab\" aria-selected={active === t.key}\n          className={'tab' + (active === t.key ? ' active' : '')} onClick={() => onChange(t.key)}>\n          {t.label}{t.badge ? <span className=\"badge\">{t.badge}</span> : null}\n        </button>\n      ))}\n    </div>\n  );\n}\n\nexport function PageTitle({ children, right }) {\n  return (\n    <div className=\"page-title\">\n      <h2>{children}</h2>\n      <div>{right}</div>\n    </div>\n  );\n}\n\nexport function Warning({ children }) {\n  return <div className=\"warning-box\" role=\"alert\">{children}</div>;\n}\n\nexport function Loading({ text = 'Loading...' }) {\n  return <div className=\"loading\">{text}</div>;\n}\n\nexport function DataTable({ columns, rows, empty = 'No data', rowKey, onRowClick, selectedKey, maxHeight }) {\n  return (\n    <div className=\"table-wrap\" style={maxHeight ? { maxHeight } : undefined}>\n      <table className=\"table\">\n        <thead>\n          <tr>{columns.map((c) => <th key={c.key} style={{ textAlign: c.align || 'left' }}>{c.label}</th>)}</tr>\n        </thead>\n        <tbody>\n          {rows.length === 0 && <tr><td colSpan={columns.length} className=\"empty\">{empty}</td></tr>}\n          {rows.map((r, i) => {\n            const k = rowKey ? rowKey(r) : i;\n            return (\n              <tr key={k} onClick={onRowClick ? () => onRowClick(r) : undefined}\n                className={(onRowClick ? 'clickable ' : '') + (selectedKey !== undefined && selectedKey === k ? 'selected' : '')}>\n                {columns.map((c) => (\n                  <td key={c.key} style={{ textAlign: c.align || 'left' }}>{c.render ? c.render(r) : fmt(r[c.key])}</td>\n                ))}\n              </tr>\n            );\n          })}\n        </tbody>\n      </table>\n    </div>\n  );\n}\n\nexport function fmt(v, digits = 2) {\n  if (v === null || v === undefined || v === '') return '-';\n  if (typeof v === 'number') return Number.isInteger(v) ? v.toLocaleString() : v.toLocaleString(undefined, { maximumFractionDigits: digits });\n  return String(v);\n}\n\nexport function Modal({ title, onClose, children, footer, wide }) {\n  useEffect(() => {\n    const k = (e) => { if (e.key === 'Escape') onClose(); };\n    window.addEventListener('keydown', k);\n    return () => window.removeEventListener('keydown', k);\n  }, [onClose]);\n  return (\n    <div className=\"modal-backdrop\" onClick={onClose}>\n      <div className={'modal' + (wide ? ' modal-wide' : '')} onClick={(e) => e.stopPropagation()} role=\"dialog\" aria-modal=\"true\">\n        <header className=\"modal-head\"><h3>{title}</h3><button className=\"btn-icon\" onClick={onClose} aria-label=\"Close\">×</button></header>\n        <div className=\"modal-body\">{children}</div>\n        {footer && <footer className=\"modal-foot\">{footer}</footer>}\n      </div>\n    </div>\n  );\n}\n\nexport function Select({ label, value, onChange, options, style }) {\n  return (\n    <label className=\"field-inline\" style={style}>\n      {label && <span>{label}</span>}\n      <select value={value === null || value === undefined ? '' : value} onChange={(e) => onChange(e.target.value)}>\n        {options.map((o) => <option key={o.value} value={o.value}>{o.label}</option>)}\n      </select>\n    </label>\n  );\n}\n\nexport function StatusPill({ status }) {\n  return <span className={'pill pill-' + status}>{status}</span>;\n}\n\n// Series palette (validated categorical order) shared by all charts.\nexport const SERIES = ['#2a78d6', '#e07b39', '#2f9e6f', '#c94f7c', '#7b61c9', '#c9a227', '#3fa7b5', '#8a6d4f',\n  '#d1495b', '#5c8a2e', '#4d6fa8', '#b8735a'];\nexport const color = (i) => SERIES[i % SERIES.length];\n","// CPS: simulation of production plan performance, growth by growth stage (3D), response measures and\n// disease & pest infestation, all driven by MES data in the shared database.\nimport React, { useCallback, useEffect, useState } from 'react';\nimport { Bar, BarChart, CartesianGrid, ComposedChart, ErrorBar, Legend, Line, LineChart, ResponsiveContainer, Tooltip, XAxis, YAxis } from 'recharts';\nimport { api, getToken, post, setToken } from './api';\nimport CropScene from './components/CropScene';\nimport FarmMap, { STATUS_COLORS } from './components/FarmMap';\nimport { DataTable, Loading, Notifier, Panel, Select, Tabs, color, notifyError, SERIES } from './components/ui';\n\nfunction pad(n) { return (n < 10 ? '0' : '') + n; }\n\nfunction Header({ user, onLogout }) {\n  const [now, setNow] = useState(new Date());\n  useEffect(() => { const t = setInterval(() => setNow(new Date()), 1000); return () => clearInterval(t); }, []);\n  return (\n    <header className=\"header\">\n      <div className=\"brand\">Seed Farm CPS · Cyber-Physical Simulation</div>\n      <div className=\"clock\">\n        <div className=\"date\">{now.getFullYear()}-{pad(now.getMonth() + 1)}-{pad(now.getDate())}</div>\n        <div className=\"time\">{pad(now.getHours())}:{pad(now.getMinutes())}:{pad(now.getSeconds())}</div>\n      </div>\n      <div className=\"user\"><span>{user.full_name}</span><button onClick={onLogout}>Log out</button></div>\n    </header>\n  );\n}\n\nfunction Login({ onLogin }) {\n  const [u, setU] = useState('');\n  const [p, setP] = useState('');\n  const [err, setErr] = useState('');\n  async function submit(e) {\n    e.preventDefault();\n    try { const r = await post('/auth/login', { username: u, password: p }); setToken(r.token); onLogin(r.user); } catch (x) { setErr(x.message); }\n  }\n  return (\n    <div className=\"login\">\n      <form onSubmit={submit}>\n        <h1>Seed Farm CPS</h1>\n        <div className=\"small muted\">Uses the same accounts as MES</div>\n        <label>Username<input type=\"text\" value={u} onChange={(e) => setU(e.target.value)} autoFocus required /></label>\n        <label>Password<input type=\"password\" value={p} onChange={(e) => setP(e.target.value)} required /></label>\n        {err && <div className=\"error-text\">{err}</div>}\n        <button className=\"btn btn-primary\" type=\"submit\">Log in</button>\n      </form>\n    </div>\n  );\n}\n\n// ---------------------------------------------------------------- production plan simulation\nfunction PlanSimulation() {\n  const [plans, setPlans] = useState(null);\n  const [id, setId] = useState('');\n  const [sim, setSim] = useState(null);\n  useEffect(() => {\n    api('/plans').then((p) => { setPlans(p); const a = p.find((x) => x.status !== 'draft') || p[0]; if (a) setId(String(a.id)); }).catch(notifyError);\n  }, []);\n  useEffect(() => { if (!id) return; setSim(null); api('/plan-sim/' + id).then(setSim).catch(notifyError); }, [id]);\n  if (!plans) return <Loading />;\n  const yields = sim ? sim.yields.map((y) => ({ crop: y.crop, mean: y.mean, p50: y.p50, err: [y.p50 - y.p10, y.p90 - y.p50], p10: y.p10, p90: y.p90 })) : [];\n  return (\n    <div>\n      <div className=\"row\" style={{ marginBottom: 10 }}>\n        <Select label=\"Production plan (MES scenario)\" value={id} onChange={setId} style={{ maxWidth: '100%' }}\n          options={plans.map((p) => ({ value: p.id, label: p.label }))} />\n      </div>\n      {!sim ? <Loading text=\"Running Monte-Carlo simulation...\" /> : (\n        <div className=\"grid g2\">\n          <Panel title=\"Expected yield of the selected plan\" extra={<span className=\"small muted\">{sim.runs} weather / pest scenarios</span>}>\n            <ResponsiveContainer width=\"100%\" height={280}>\n              <ComposedChart data={yields} margin={{ top: 10, right: 10, left: 0, bottom: 0 }}>\n                <CartesianGrid stroke=\"#e3e8e4\" vertical={false} />\n                <XAxis dataKey=\"crop\" />\n                <YAxis unit=\" t\" />\n                <Tooltip formatter={(v, n) => (Array.isArray(v) ? v.join(' / ') : v + ' t')} />\n                <Legend />\n                <Bar dataKey=\"p50\" name=\"Median seed yield (P10–P90)\" fill={SERIES[2]}>\n                  <ErrorBar dataKey=\"err\" width={10} strokeWidth={2} stroke=\"#1d2a22\" />\n                </Bar>\n              </ComposedChart>\n            </ResponsiveContainer>\n            <DataTable rows={sim.yields} rowKey={(r) => r.crop} columns={[\n              { key: 'crop', label: 'Crop' }, { key: 'p10', label: 'P10 t', align: 'right' }, { key: 'p50', label: 'P50 t', align: 'right' },\n              { key: 'p90', label: 'P90 t', align: 'right' }, { key: 'mean', label: 'Mean t', align: 'right' }]} />\n            <h4>Yield of all variants of this plan period</h4>\n            <ResponsiveContainer width=\"100%\" height={180}>\n              <BarChart data={sim.compare}><CartesianGrid stroke=\"#e3e8e4\" vertical={false} /><XAxis dataKey=\"name\" tick={{ fontSize: 11 }} /><YAxis unit=\" t\" />\n                <Tooltip /><Bar dataKey=\"yield_t\" name=\"Expected yield\" fill={SERIES[0]} /></BarChart>\n            </ResponsiveContainer>\n          </Panel>\n          <Panel title=\"Economic profit\" extra={<span className=\"small muted\">cost {sim.plan.expected_cost.toLocaleString()} · revenue share {sim.plan.revenue_share}</span>}>\n            <div className=\"grid g3\" style={{ marginBottom: 8 }}>\n              <div className=\"kpi\"><span className=\"v\">{sim.profit.mean.toLocaleString()}</span><span className=\"l\">Mean profit</span></div>\n              <div className=\"kpi\"><span className=\"v\">{sim.profit.p10.toLocaleString()}</span><span className=\"l\">P10 (bad year)</span></div>\n              <div className=\"kpi\"><span className=\"v\">{sim.profit.p90.toLocaleString()}</span><span className=\"l\">P90 (good year)</span></div>\n            </div>\n            <ResponsiveContainer width=\"100%\" height={230}>\n              <BarChart data={sim.profit.histogram.map((h) => ({ ...h, label: Math.round((h.from + h.to) / 2000) + 'k' }))}>\n                <CartesianGrid stroke=\"#e3e8e4\" vertical={false} /><XAxis dataKey=\"label\" /><YAxis />\n                <Tooltip formatter={(v) => v + ' scenarios'} labelFormatter={(l) => 'Profit ≈ ' + l} />\n                <Bar dataKey=\"count\" name=\"Scenarios\" fill={SERIES[4]} />\n              </BarChart>\n            </ResponsiveContainer>\n            <h4>Profit of all variants (mean with P10–P90)</h4>\n            <ResponsiveContainer width=\"100%\" height={180}>\n              <BarChart data={sim.compare.map((c) => ({ ...c, err: [c.profit_mean - c.profit_p10, c.profit_p90 - c.profit_mean] }))}>\n                <CartesianGrid stroke=\"#e3e8e4\" vertical={false} /><XAxis dataKey=\"name\" tick={{ fontSize: 11 }} />\n                <YAxis tickFormatter={(v) => Math.round(v / 1000) + 'k'} /><Tooltip formatter={(v) => (Array.isArray(v) ? '' : v.toLocaleString())} />\n                <Bar dataKey=\"profit_mean\" name=\"Mean profit\" fill={SERIES[1]}><ErrorBar dataKey=\"err\" width={8} stroke=\"#1d2a22\" /></Bar>\n              </BarChart>\n            </ResponsiveContainer>\n          </Panel>\n        </div>\n      )}\n    </div>\n  );\n}\n\n// ---------------------------------------------------------------- growth simulation by growth stage (3D)\nfunction GrowthSimulation() {\n  const [d, setD] = useState(null);\n  const [week, setWeek] = useState(0);\n  useEffect(() => { api('/growth-sim?weeks=8').then(setD).catch(notifyError); }, []);\n  if (!d) return <Loading text=\"Loading MES growth predictions...\" />;\n  const info = (crop) => {\n    const s = d.crops[crop] && d.crops[crop][week];\n    if (!s) return null;\n    return (\n      <div className=\"row small\" style={{ marginTop: 6 }}>\n        <b>{s.stage}</b><span>DAS {s.das}</span><span>leaves {s.leaf}</span><span>tillers {s.tiller}</span><span>height {s.height_cm} cm</span>\n        <span>ripeness {Math.round(s.ripeness * 100)}%</span>\n      </div>\n    );\n  };\n  return (\n    <div>\n      <div className=\"row\" style={{ marginBottom: 10 }}>\n        <label className=\"field-inline\">Week\n          <input type=\"range\" min=\"0\" max={d.weeks} value={week} onChange={(e) => setWeek(Number(e.target.value))} style={{ width: 280 }} />\n        </label>\n        <b>{week === 0 ? 'Current (last survey)' : `+${week} week${week > 1 ? 's' : ''}`}</b>\n        <div className=\"row\">{Array.from({ length: d.weeks + 1 }, (_, i) => (\n          <button key={i} className={'btn' + (i === week ? ' btn-primary' : '')} onClick={() => setWeek(i)}>{i === 0 ? 'Now' : 'W' + i}</button>))}</div>\n      </div>\n      <div className=\"grid g2\">\n        {['rice', 'wheat'].map((crop) => (\n          <Panel key={crop} title={`${crop === 'rice' ? 'Rice' : 'Wheat'} — 3D growth simulation (MES prediction)`} extra={<span className=\"small muted\">drag to rotate · wheel to zoom</span>}>\n            {d.crops[crop] ? <CropScene crop={crop} state={d.crops[crop][week]} /> : <div className=\"muted\">No {crop} fields</div>}\n            {info(crop)}\n            {d.crops[crop] && (\n              <ResponsiveContainer width=\"100%\" height={150}>\n                <LineChart data={d.crops[crop]} margin={{ top: 8, right: 8, left: -10, bottom: 0 }}>\n                  <CartesianGrid stroke=\"#e3e8e4\" /><XAxis dataKey=\"week\" tickFormatter={(w) => 'W' + w} /><YAxis />\n                  <Tooltip /><Legend wrapperStyle={{ fontSize: 11 }} />\n                  <Line dataKey=\"leaf\" name=\"Leaves\" stroke={color(0)} dot={false} />\n                  <Line dataKey=\"tiller\" name=\"Tillers\" stroke={color(1)} dot={false} />\n                </LineChart>\n              </ResponsiveContainer>\n            )}\n          </Panel>\n        ))}\n      </div>\n    </div>\n  );\n}\n\n// ---------------------------------------------------------------- response measures for the crop growth period\nfunction ResponseSimulation() {\n  const [cultivars, setCultivars] = useState([]);\n  const [crop, setCrop] = useState('rice');\n  const [cultivar, setCultivar] = useState('');\n  const [measures, setMeasures] = useState(['n_topdress']);\n  const [d, setD] = useState(null);\n  const [busy, setBusy] = useState(false);\n  useEffect(() => { api('/cultivars').then(setCultivars).catch(notifyError); }, []);\n  const run = useCallback(() => {\n    setBusy(true);\n    post('/response', { crop, cultivar_id: cultivar || null, measures, horizon: 45 }).then(setD).catch(notifyError).finally(() => setBusy(false));\n  }, [crop, cultivar, measures]);\n  useEffect(() => { run(); }, [run]);\n  const all = d ? d.measures : [{ key: 'n_topdress', label: 'N top-dressing' }, { key: 'irrigation', label: 'Irrigation' },\n    { key: 'pest_control', label: 'Pest control' }, { key: 'cold_protection', label: 'Cold protection' }];\n  return (\n    <div className=\"grid g-side\">\n      <Panel title=\"Scenario\">\n        <div className=\"grid\">\n          <Select label=\"Crop\" value={crop} onChange={(v) => { setCrop(v); setCultivar(''); }} options={[{ value: 'rice', label: 'Rice' }, { value: 'wheat', label: 'Wheat' }]} />\n          <Select label=\"Cultivar\" value={cultivar} onChange={setCultivar}\n            options={[{ value: '', label: 'All' }].concat(cultivars.filter((c) => c.crop === crop).map((c) => ({ value: c.id, label: c.name })))} />\n          <div><b className=\"small\">Response measures</b>\n            {all.map((m) => (\n              <label key={m.key} className=\"field-inline\" style={{ display: 'flex' }}>\n                <input type=\"checkbox\" checked={measures.indexOf(m.key) >= 0}\n                  onChange={(e) => setMeasures(e.target.checked ? measures.concat(m.key) : measures.filter((x) => x !== m.key))} /> {m.label}\n              </label>\n            ))}\n          </div>\n          {busy && <span className=\"small muted\">Simulating…</span>}\n          {d && (\n            <div className=\"grid\" style={{ gridTemplateColumns: 'auto 1fr', gap: '4px 10px' }}>\n              <span className=\"muted small\">Soil moisture</span><span className=\"small\">{d.inputs.soil_moisture.toFixed(1)} %</span>\n              <span className=\"muted small\">Paddy water</span><span className=\"small\">{d.inputs.water_level_cm.toFixed(1)} cm</span>\n              <span className=\"muted small\">Pest damage (30 d)</span><span className=\"small\">{Math.round(d.inputs.damaged_m2)} m²</span>\n              <span className=\"muted small\">Min forecast temp</span><span className=\"small\">{d.inputs.min_forecast_temp} °C</span>\n              <span className=\"muted small\">Water stress</span><span className=\"small\">{(d.stress.water_stress * 100).toFixed(1)} %</span>\n              <span className=\"muted small\">Pest loss</span><span className=\"small\">{(d.stress.pest_loss * 100).toFixed(1)} %</span>\n            </div>\n          )}\n        </div>\n      </Panel>\n      {d ? (\n        <div className=\"grid\" style={{ alignContent: 'start' }}>\n          <div className=\"grid g3\">\n            <Panel><div className=\"kpi\"><span className=\"v\">{d.yield_base} t/ha</span><span className=\"l\">Expected yield without measures</span></div></Panel>\n            <Panel><div className=\"kpi\"><span className=\"v\">{d.yield_measure} t/ha</span><span className=\"l\">Expected yield with measures</span></div></Panel>\n            <Panel><div className=\"kpi\"><span className=\"v\">{(((d.yield_measure - d.yield_base) / d.yield_base) * 100).toFixed(1)} %</span><span className=\"l\">Effect of measures</span></div></Panel>\n          </div>\n          <Panel title=\"Predicted tiller number for the next 45 days\">\n            <ResponsiveContainer width=\"100%\" height={240}>\n              <LineChart data={d.series}><CartesianGrid stroke=\"#e3e8e4\" /><XAxis dataKey=\"day\" /><YAxis domain={['auto', 'auto']} /><Tooltip /><Legend />\n                <Line dataKey=\"tiller_base\" name=\"Without measures\" stroke={color(1)} dot={false} strokeDasharray=\"5 4\" />\n                <Line dataKey=\"tiller_measure\" name=\"With measures\" stroke={color(2)} dot={false} strokeWidth={2} />\n              </LineChart>\n            </ResponsiveContainer>\n          </Panel>\n          <Panel title=\"Predicted leaf number for the next 45 days\">\n            <ResponsiveContainer width=\"100%\" height={220}>\n              <LineChart data={d.series}><CartesianGrid stroke=\"#e3e8e4\" /><XAxis dataKey=\"day\" /><YAxis domain={['auto', 'auto']} /><Tooltip /><Legend />\n                <Line dataKey=\"leaf_base\" name=\"Without measures\" stroke={color(1)} dot={false} strokeDasharray=\"5 4\" />\n                <Line dataKey=\"leaf_measure\" name=\"With measures\" stroke={color(0)} dot={false} strokeWidth={2} />\n              </LineChart>\n            </ResponsiveContainer>\n          </Panel>\n        </div>\n      ) : <Loading />}\n    </div>\n  );\n}\n\n// ---------------------------------------------------------------- disease & pest infestation simulation\nfunction PestSimulation() {\n  const [days, setDays] = useState(21);\n  const [d, setD] = useState(null);\n  const [sel, setSel] = useState(null);\n  useEffect(() => { setD(null); api('/pest-sim?days=' + days).then(setD).catch(notifyError); }, [days]);\n  const f = d && d.fields.find((x) => x.id === sel);\n  return (\n    <div>\n      <div className=\"row\" style={{ marginBottom: 10 }}>\n        <Select label=\"Simulation horizon\" value={days} onChange={(v) => setDays(Number(v))}\n          options={[7, 14, 21, 30, 45].map((n) => ({ value: n, label: n + ' days' }))} />\n      </div>\n      {!d ? <Loading text=\"Simulating infestation spread...\" /> : (\n        <div className=\"grid g-side-r\">\n          <Panel title={`Expected infestation after ${d.days} days`}>\n            <FarmMap fields={d.fields} selectedId={sel} onFieldClick={(x) => setSel(x.id)}\n              fillFor={(x) => STATUS_COLORS[x.state]}\n              labelFor={(x) => [x.soil_no].concat(x.expected.slice(0, 2).map((e) => e.pest_name))}\n              legend={[{ color: STATUS_COLORS.normal, label: 'Normal' }, { color: STATUS_COLORS.disease, label: 'Disease expected' },\n                { color: STATUS_COLORS.pest, label: 'Pests expected' }]} />\n          </Panel>\n          <div className=\"grid\" style={{ alignContent: 'start' }}>\n            <Panel title=\"Field details\">\n              {f ? (f.expected.length ? (\n                <DataTable rows={f.expected} rowKey={(e) => e.pest_name} columns={[\n                  { key: 'pest_name', label: f.soil_no + ' · expected pest' }, { key: 'individuals', label: 'Individuals', align: 'right' },\n                  { key: 'damaged_area_m2', label: 'Damaged m²', align: 'right' }, { key: 'probability', label: 'Prob.', align: 'right' }]} />\n              ) : <span className=\"small muted\">{f.soil_no}: no infestation expected.</span>) : <span className=\"small muted\">Click a field.</span>}\n            </Panel>\n            <Panel title=\"Spread over time\">\n              <ResponsiveContainer width=\"100%\" height={240}>\n                <LineChart data={d.daily}><CartesianGrid stroke=\"#e3e8e4\" /><XAxis dataKey=\"day\" /><YAxis /><Tooltip /><Legend />\n                  <Line dataKey=\"disease_fields\" name=\"Disease fields\" stroke=\"#d64545\" dot={false} />\n                  <Line dataKey=\"pest_fields\" name=\"Pest fields\" stroke=\"#c9a227\" dot={false} />\n                  <Line dataKey=\"damaged_area_ha\" name=\"Damaged ha\" stroke={color(4)} dot={false} />\n                </LineChart>\n              </ResponsiveContainer>\n            </Panel>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n\nexport default function App() {\n  const [user, setUser] = useState(null);\n  const [checking, setChecking] = useState(!!getToken());\n  const [tab, setTab] = useState('plan');\n  const logout = useCallback(() => { setToken(''); setUser(null); }, []);\n  useEffect(() => {\n    window.addEventListener('cps-logout', logout);\n    if (getToken()) api('/auth/me').then((r) => setUser(r.user)).catch(() => setToken('')).finally(() => setChecking(false));\n    return () => window.removeEventListener('cps-logout', logout);\n  }, [logout]);\n  if (checking) return <Loading text=\"Connecting to CPS server...\" />;\n  if (!user) return (<><Login onLogin={setUser} /><Notifier /></>);\n  return (\n    <div className=\"app\" style={{ gridTemplateColumns: '1fr' }}>\n      <Header user={user} onLogout={logout} />\n      <main className=\"main\">\n        <Tabs tabs={[{ key: 'plan', label: 'Production plan simulation' }, { key: 'growth', label: 'Growth simulation by growth stage' },\n          { key: 'response', label: 'Response measures simulation' }, { key: 'pest', label: 'Disease and pest infestation simulation' }]}\n        active={tab} onChange={setTab} />\n        {tab === 'plan' && <PlanSimulation />}\n        {tab === 'growth' && <GrowthSimulation />}\n        {tab === 'response' && <ResponseSimulation />}\n        {tab === 'pest' && <PestSimulation />}\n      </main>\n      <Notifier />\n    </div>\n  );\n}\n","import React from 'react';\nimport ReactDOM from 'react-dom';\nimport './index.css';\nimport App from './App';\n\nReactDOM.render(<App />, document.getElementById('root'));\n"]}}